			formatString: #,0.0
			displayFolder: Entrega e Qualidade

		measure 'Cor Condutividade Água Industrial' =
				VAR _v = [Condutividade Água Industrial]
				VAR _min = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), dim_indicadores[ID_Indicador] = "Água Industrial | Condutividade online" )
				VAR _max = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), dim_indicadores[ID_Indicador] = "Água Industrial | Condutividade online" )
				RETURN
				    IF (
				        NOT ISBLANK ( _v ),
				        IF (
				            ( ISBLANK ( _min ) || _v >= _min ) && ( ISBLANK ( _max ) || _v <= _max ),
				            "#2E7D32",
				            "#C62828"
				        )
				    )
			displayFolder: Entrega e Qualidade\Cores

		measure 'Dióxido de Cloro Água Industrial' =
				CALCULATE (
				    AVERAGE ( fato_indicadores[Valor] ),
				    REMOVEFILTERS ( dim_indicadores ),
				    fato_indicadores[ID_Indicador] = "Água Industrial | Dióxido de cloro online"
				)
			formatString: 0.000
			displayFolder: Entrega e Qualidade

		measure 'Cor Dióxido de Cloro Água Industrial' =
				VAR _v = [Dióxido de Cloro Água Industrial]
				VAR _min = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), dim_indicadores[ID_Indicador] = "Água Industrial | Dióxido de cloro online" )
				VAR _max = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), dim_indicadores[ID_Indicador] = "Água Industrial | Dióxido de cloro online" )
				RETURN
				    IF (
				        NOT ISBLANK ( _v ),
				        IF (
				            ( ISBLANK ( _min ) || _v >= _min ) && ( ISBLANK ( _max ) || _v <= _max ),
				            "#2E7D32",
				            "#C62828"
				        )
				    )
			displayFolder: Entrega e Qualidade\Cores
