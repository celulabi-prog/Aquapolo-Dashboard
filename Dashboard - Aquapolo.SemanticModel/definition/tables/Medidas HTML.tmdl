			        & "<span style='width:56px;font-size:11px;color:#4a5b70;white-space:nowrap'>Ref. " & FORMAT ( Ref, FmtValor ) & "</span>"
			        & "</div>"
			```
		lineageTag: 4f42fc6d-830c-4336-ba02-462705186a4b

	measure 'HTML SDI' = ```
			    -- ===== EDITAR AQUI (SDI) =====
			    VAR Valor = 2.1            -- trocar pela medida real, ex.: [SDI]
			    VAR Ref = 3.0
			    VAR MenorMelhor = TRUE ()
			    VAR FmtValor = "0.0"
			    -- ===== daqui pra baixo não precisa mexer =====
			    VAR Tolerancia = 0.10      -- faixa de "Atenção" (10% além da referência)
			    VAR Atingimento = DIVIDE ( Valor, Ref )
			    VAR Cor =
			        IF (
			            MenorMelhor,
			            SWITCH ( TRUE (), Valor <= Ref, "#43a047", Valor <= Ref * ( 1 + Tolerancia ), "#f9a825", "#e53935" ),
			            SWITCH ( TRUE (), Valor >= Ref, "#43a047", Valor >= Ref * ( 1 - Tolerancia ), "#f9a825", "#e53935" )
			        )
			    VAR Escala = 1.3           -- barra cheia = 130% da referência
			    VAR Largura = MIN ( Atingimento, Escala ) / Escala * 100
			    VAR Marcador = 100 / Escala
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#0b2a5b;display:flex;align-items:center;gap:10px;height:100%'>"
			        & "<b style='width:38px;text-align:right;font-size:14px'>" & FORMAT ( Valor, FmtValor ) & "</b>"
			        & "<div style='flex:1'>"
			        & "<div style='position:relative;height:9px;background:#e6edf5;border-radius:4px'>"
			        & "<div style='width:" & FORMAT ( Largura, "0" ) & "%;height:100%;background:" & Cor & ";border-radius:4px'>"
			        & "</div>"
			        & "<div style='position:absolute;left:" & FORMAT ( Marcador, "0" ) & "%;top:-4px;height:17px;border-left:2px dashed #0b2a5b'>"
			        & "</div>"
			        & "</div>"
			        & "</div>"
			        & "<span style='width:56px;font-size:11px;color:#4a5b70;white-space:nowrap'>Ref. " & FORMAT ( Ref, FmtValor ) & "</span>"
			        & "</div>"
			```
		lineageTag: e7e33d40-f9d4-4bdc-984a-3c5071c25235

