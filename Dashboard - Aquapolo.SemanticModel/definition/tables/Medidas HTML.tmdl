	/// Painel PERFORMANCE TMBR da Visão Geral: Idade do Lodo, Alimento/Microorg., TMP, Permeabilidade, Turbidez, Fluxo. Valor = média dos últimos 30 dias com dado ([Valor 30d]); referência = Target_Min/Target_Max da dim_indicadores. Verde dentro da meta, amarelo até 10% fora, vermelho além disso. A barra enche até 160% da referência e o tracejado marca os 100%.
	measure 'HTML Painel TMBR' = ```
			VAR _ids1 = { "Reator Biológico | Idade do lodo (IL)" }
			VAR _v1 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, fato_indicadores[ID_Indicador] ) )
			VAR _mi1 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _ma1 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _rf1 = _ma1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _mi1 ) || ISBLANK ( _ma1 ), "#5c7791", _v1 >= _mi1 && _v1 <= _ma1, "#4ed15d", _v1 >= _mi1 * 0.9 && _v1 <= _ma1 * 1.1, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids2 = { "Reator Biológico | Alimento/ Microoganismo (F/M)" }
			VAR _v2 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, fato_indicadores[ID_Indicador] ) )
			VAR _mi2 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, dim_indicadores[ID_Indicador] ) )
			VAR _ma2 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, dim_indicadores[ID_Indicador] ) )
			VAR _rf2 = _ma2
			VAR _co2 = SWITCH ( TRUE (), ISBLANK ( _v2 ) || ISBLANK ( _mi2 ) || ISBLANK ( _ma2 ), "#5c7791", _v2 >= _mi2 && _v2 <= _ma2, "#4ed15d", _v2 >= _mi2 * 0.9 && _v2 <= _ma2 * 1.1, "#feb825", "#f4353f" )
			VAR _lg2 = MIN ( MAX ( DIVIDE ( _v2, _rf2 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids3 = { "Membranas de Ultrafiltração | Pressão Transmembrana (TMP) - TM1", "Membranas de Ultrafiltração | Pressão Transmembrana (TMP) - TM2", "Membranas de Ultrafiltração | Pressão Transmembrana (TMP) - TM3", "Membranas de Ultrafiltração | Pressão Transmembrana (TMP) - TM4", "Membranas de Ultrafiltração | Pressão Transmembrana (TMP) - TM5", "Membranas de Ultrafiltração | Pressão Transmembrana (TMP) - TM6", "Membranas de Ultrafiltração | Pressão Transmembrana (TMP) - TM7", "Membranas de Ultrafiltração | Pressão Transmembrana (TMP) - TM8" }
			VAR _v3 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, fato_indicadores[ID_Indicador] ) )
			VAR _mi3 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _ma3 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids4 = { "Membranas de Ultrafiltração | Permeablidade - TM 1", "Membranas de Ultrafiltração | Permeablidade - TM 2", "Membranas de Ultrafiltração | Permeablidade - TM 3", "Membranas de Ultrafiltração | Permeablidade - TM 4", "Membranas de Ultrafiltração | Permeablidade - TM 5", "Membranas de Ultrafiltração | Permeablidade - TM 6", "Membranas de Ultrafiltração | Permeablidade - TM 7", "Membranas de Ultrafiltração | Permeablidade - TM 8" }
			VAR _v4 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, fato_indicadores[ID_Indicador] ) )
			VAR _mi4 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, dim_indicadores[ID_Indicador] ) )
			VAR _ma4 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, dim_indicadores[ID_Indicador] ) )
			VAR _rf4 = _mi4
			VAR _co4 = SWITCH ( TRUE (), ISBLANK ( _v4 ) || ISBLANK ( _rf4 ), "#5c7791", _v4 >= _rf4, "#4ed15d", _v4 >= _rf4 * 0.9, "#feb825", "#f4353f" )
			VAR _lg4 = MIN ( MAX ( DIVIDE ( _v4, _rf4 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids5 = { "Membranas de Ultrafiltração | Turbidez online - TM1", "Membranas de Ultrafiltração | Turbidez online - TM2", "Membranas de Ultrafiltração | Turbidez online - TM3", "Membranas de Ultrafiltração | Turbidez online - TM4", "Membranas de Ultrafiltração | Turbidez online - TM5", "Membranas de Ultrafiltração | Turbidez online - TM6", "Membranas de Ultrafiltração | Turbidez online - TM7", "Membranas de Ultrafiltração | Turbidez online - TM8" }
			VAR _v5 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, fato_indicadores[ID_Indicador] ) )
			VAR _mi5 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, dim_indicadores[ID_Indicador] ) )
			VAR _ma5 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, dim_indicadores[ID_Indicador] ) )
			VAR _rf5 = _ma5
			VAR _co5 = SWITCH ( TRUE (), ISBLANK ( _v5 ) || ISBLANK ( _rf5 ), "#5c7791", _v5 <= _rf5, "#4ed15d", _v5 <= _rf5 * 1.1, "#feb825", "#f4353f" )
			VAR _lg5 = MIN ( MAX ( DIVIDE ( _v5, _rf5 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids6 = { "Membranas de Ultrafiltração | Fluxo TM's" }
			VAR _v6 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids6, fato_indicadores[ID_Indicador] ) )
			VAR _mi6 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids6, dim_indicadores[ID_Indicador] ) )
			VAR _ma6 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids6, dim_indicadores[ID_Indicador] ) )
			VAR _rf6 = _ma6
			VAR _co6 = SWITCH ( TRUE (), ISBLANK ( _v6 ) || ISBLANK ( _mi6 ) || ISBLANK ( _ma6 ), "#5c7791", _v6 >= _mi6 && _v6 <= _ma6, "#4ed15d", _v6 >= _mi6 * 0.9 && _v6 <= _ma6 * 1.1, "#feb825", "#f4353f" )
			VAR _lg6 = MIN ( MAX ( DIVIDE ( _v6, _rf6 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _itens =
			    "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='8.4' cy='8.6' r='3.5'/><circle cx='15.8' cy='8.6' r='3'/><circle cx='12' cy='16.2' r='3.8'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Idade do Lodo</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>dias</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg1, "0" ) & "%;height:100%;background:" & _co1 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Faixa" & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _mi1 ) || ISBLANK ( _ma1 ), "&#8212;", FORMAT ( _mi1, "#,##0" ) & " &#8211; " & FORMAT ( _ma1, "#,##0" ) ) & "</div></div></div>"
			        & "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='3'/><path d='M12 2.8v2.6M12 18.6v2.6M21.2 12h-2.6M5.4 12H2.8M18.5 5.5l-1.8 1.8M7.3 16.7l-1.8 1.8M18.5 18.5l-1.8-1.8M7.3 7.3L5.5 5.5'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Alimento/Microorg.</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>g/g.d<sup>-1</sup></div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v2 ), "&#8212;", FORMAT ( _v2, "#,##0.00" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg2, "0" ) & "%;height:100%;background:" & _co2 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Faixa" & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _mi2 ) || ISBLANK ( _ma2 ), "&#8212;", FORMAT ( _mi2, "#,##0.00" ) & " &#8211; " & FORMAT ( _ma2, "#,##0.00" ) ) & "</div></div></div>"
			        & "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M3.6 17.4a9 9 0 1 1 16.8 0'/><path d='M12 17.4L16.6 9.6'/><circle cx='12' cy='17.4' r='1.6' fill='currentColor' stroke='none'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>TMP</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>bar</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v3 ), "&#8212;", FORMAT ( _v3, "#,##0.00" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg3, "0" ) & "%;height:100%;background:" & _co3 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Ref." & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _rf3 ), "&#8212;", FORMAT ( _rf3, "#,##0.00" ) ) & "</div></div></div>"
			        & "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M4 4.6v14.8M8.7 4.6v14.8M12 4.6v14.8M15.3 4.6v14.8M20 4.6v14.8'/><path d='M2.6 4.6h18.8M2.6 19.4h18.8'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Permeabilidade</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>LMH/bar</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v4 ), "&#8212;", FORMAT ( _v4, "#,##0" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg4, "0" ) & "%;height:100%;background:" & _co4 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Ref." & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _rf4 ), "&#8212;", FORMAT ( _rf4, "#,##0" ) ) & "</div></div></div>"
			        & "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='6' cy='6' r='1.25' fill='currentColor' stroke='none'/><circle cx='12' cy='4.6' r='1.25' fill='currentColor' stroke='none'/><circle cx='18' cy='6' r='1.25' fill='currentColor' stroke='none'/><circle cx='4.6' cy='12' r='1.25' fill='currentColor' stroke='none'/><circle cx='12' cy='9.8' r='1.25' fill='currentColor' stroke='none'/><circle cx='19.4' cy='12' r='1.25' fill='currentColor' stroke='none'/><circle cx='6' cy='18' r='1.25' fill='currentColor' stroke='none'/><circle cx='12' cy='15.2' r='1.25' fill='currentColor' stroke='none'/><circle cx='18' cy='18' r='1.25' fill='currentColor' stroke='none'/><circle cx='9' cy='12.4' r='1.25' fill='currentColor' stroke='none'/><circle cx='15' cy='12.4' r='1.25' fill='currentColor' stroke='none'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Turbidez</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>NTU</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v5 ), "&#8212;", FORMAT ( _v5, "#,##0.00" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg5, "0" ) & "%;height:100%;background:" & _co5 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px