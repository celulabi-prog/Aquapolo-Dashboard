	/// Painel VOLUMES da Visão Geral: Clientes, Blend, Perdas. Valor = as medidas '... Período' de cada indicador (planilha Dados BI); referência = a meta de ferramentas/preview/indicadores_op.py. Verde dentro da meta, amarelo até 10% fora, vermelho além disso. A barra enche até 160% da referência e o tracejado marca os 100%.
	measure 'HTML Painel Volumes' = ```
			VAR _v1 = [Clientes Período]
			VAR _mi1 = 311.9212962963
			VAR _ma1 = BLANK ()
			VAR _rf1 = _mi1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 >= _rf1, "#4ed15d", _v1 >= _rf1 * 0.9, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an1 = [Clientes Período Anterior]
			VAR _te1 = NOT ISBLANK ( _v1 ) && NOT ISBLANK ( _an1 ) && _an1 <> 0
			VAR _dl1 = DIVIDE ( _v1 - _an1, _an1 )
			VAR _v2 = [Blend Período]
			VAR _mi2 = BLANK ()
			VAR _ma2 = BLANK ()
			VAR _rf2 = _ma2
			VAR _co2 = SWITCH ( TRUE (), ISBLANK ( _v2 ) || ISBLANK ( _rf2 ), "#5c7791", _v2 <= _rf2, "#4ed15d", _v2 <= _rf2 * 1.1, "#feb825", "#f4353f" )
			VAR _lg2 = MIN ( MAX ( DIVIDE ( _v2, _rf2 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an2 = [Blend Período Anterior]
			VAR _te2 = NOT ISBLANK ( _v2 ) && NOT ISBLANK ( _an2 ) && _an2 <> 0
			VAR _dl2 = _v2 - _an2
			VAR _v3 = [Perdas Período]
			VAR _mi3 = BLANK ()
			VAR _ma3 = 18.0
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an3 = [Perdas Período Anterior]
			VAR _te3 = NOT ISBLANK ( _v3 ) && NOT ISBLANK ( _an3 ) && _an3 <> 0
			VAR _dl3 = _v3 - _an3
			VAR _itens =
			    "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M2.6 8.4h7.2a2.6 2.6 0 0 1 2.6 2.6v2a2.6 2.6 0 0 0 2.6 2.6h6.4'/><path d='M18.6 12.8l2.8 2.8-2.8 2.8M2.6 5.6v5.6'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Clientes</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>L/s</div></div></div><div style='flex:1'></div><div style='display:flex;align-items:flex-end;gap:6px'><div style='font-size:38px;font-weight:700;color:#ffffff;line-height:1;white-space:nowrap'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0.0" ) ) & "</div><div style='margin-left:auto;text-align:right'><div style='font-size:18px;font-weight:700;color:" & IF ( NOT _te1, "#5c7791", IF ( _dl1 > 0, "#4ed15d", "#f4353f" ) ) & ";white-space:nowrap'>" & IF ( _te1, IF ( _dl1 >= 0, "&#9650;", "&#9660;" ), "" ) & " " & IF ( _te1, FORMAT ( _dl1, "+0.0%;-0.0%" ), "&#8212;" ) & "</div><div style='font-size:15px;color:#93afc9;margin-top:2px'>&#916; Per.</div></div></div><div style='margin-top:12px'><div style='position:relative;height:20px;background:#123855;border-radius:10px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg1, "0" ) & "%;height:100%;background:" & _co1 & ";border-radius:10px'></div><div style='position:absolute;left:62.5%;top:-4px;height:28px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='margin-top: