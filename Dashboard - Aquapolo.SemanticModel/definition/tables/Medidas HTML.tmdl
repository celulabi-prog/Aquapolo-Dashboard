	/// Energia: média ponderada pelo volume de clientes do dia (soma do consumo dividida pelo volume somado) dos 30 dias anteriores aos de [Energia 30d], coluna 'Energia (KWh/m³)' da planilha Dados BI. Zero e datas futuras ficam de fora: na planilha, zero é célula vazia na origem.
	measure 'Energia 30d Anterior' =
			VAR _fim =
			    CALCULATE (
			        MAX ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Energia (KWh/m³)",
			        'Dados BI'[Valor] <> 0,
			        KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () )
			    )
			VAR _dias =
			    CALCULATETABLE (
			        VALUES ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Energia (KWh/m³)",
			        'Dados BI'[Valor] <> 0,
			        'Dados BI'[Data] > _fim - 60,
			        'Dados BI'[Data] <= _fim - 30
			    )
			VAR _t =
			    ADDCOLUMNS (
			        _dias,
			        "@v", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Energia (KWh/m³)" ),
			        "@p", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Clientes (L/s)" )
			    )
			RETURN
			    DIVIDE ( SUMX ( _t, [@v] * [@p] ), SUMX ( _t, [@p] ) )
		formatString: #,0.00
		displayFolder: Painel Operacional\Indicadores
		lineageTag: eebf6ce3-1399-5850-a54b-cfcff26b7c41

