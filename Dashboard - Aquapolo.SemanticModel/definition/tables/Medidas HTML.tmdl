	/// Faixa do rodapé: data da última medição da planilha e a legenda das cores e dos termos.
	measure 'HTML Rodapé' = ```
			VAR _ult = CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Valor] <> 0, 'Dados BI'[Data] <= TODAY () )
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><div style='font-family:Segoe UI,sans-serif;height:100vh;width:100%;display:flex;align-items:center;gap:24px;padding:0 26px;background:#04182a;border:1px solid #1f5a66;border-radius:10px'><span style='color:#93afc9;display:flex;flex:none'><svg viewBox='0 0 24 24' width='25' height='25' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 6.6V12l3.6 2.2'/></svg></span><span style='font-size:17px;color:#dce9f7;white-space:nowrap'>Última atualização: " & IF ( ISBLANK ( _ult ), "&#8212;", FORMAT ( _ult, "dd/mm/yyyy" ) ) & "</span><div style='width:1px;height:42px;background:#2a5f78;flex:none'></div><div><div style='font-size:17px;color:#dce9f7;white-space:nowrap'><b>Legenda do status</b> <span style='font-size:15px;color:#93afc9'>(em relação à referência)</span></div><div style='margin-top:7px;font-size:16px;color:#dce9f7;white-space:nowrap'><span style='display:inline-block;width:14px;height:14px;border-radius:50%;vertical-align:-2px;margin-right:8px;background:#4ed15d'></span>Dentro da meta &nbsp;&nbsp;&nbsp;<span style='display:inline-block;width:14px;height:14px;border-radius:50%;vertical-align:-2px;margin-right:8px;background:#feb825'></span>Atenção &nbsp;&nbsp;&nbsp;<span style='display:inline-block;width:14px;height:14px;border-radius:50%;vertical-align:-2px;margin-right:8px;background:#f4353f'></span>Fora da meta</div></div><div style='width:1px;height:42px;background:#2a5f78;flex:none'></div><div style='display:flex;align-items:center;gap:11px'><b style='font-size:17px;color:#dce9f7;white-space:nowrap'>&#916; Per.</b><span style='font-size:15px;color:#93afc9;line-height:1.3'>Variação em relação ao<br>período anterior</span></div><div style='width:1px;height:42px;background:#2a5f78;flex:none'></div><div style='display:flex;align-items:center;gap:11px'><b style='font-size:17px;color:#dce9f7;white-space:nowrap'>Ref.</b><span style='font-size:15px;color:#93afc9;line-height:1.3'>Valor de referência<br>(meta)</span></div><div style='width:1px;height:42px;background:#2a5f78;flex:none'></div><div style='display:flex;align-items:center;gap:11px'><b style='font-size:17px;color:#dce9f7;white-space:nowrap'>Faixa</b><span style='font-size:15px;color:#93afc9;line-height:1.3'>Faixa operacional</span></div><div style='margin-left:auto;padding-left:24px;font-size:16px;color:#93afc9;white-space:nowrap'>Aquapolo &nbsp;&#124;&nbsp; GS Inima &nbsp;&#124;&nbsp; Sabesp</div></div>"
			```
		displayFolder: Painel Operacional
		lineageTag: 3ef746ee-f6d1-5e1f-bbfe-c1cbaf7c89ca

	/// Caixa do cabeçalho com o status da atualização dos dados. Em dia = última leitura há até 1 dia; Pendente = até 3 dias; Atrasado = mais que isso. Ao passar o mouse, mostra a data dos dados, quando a planilha foi salva, quando o Power BI foi atualizado e o que falta fazer.
	measure 'HTML Status' = ```
			-- Agora no horário de Brasília (UTC-3), para valer igual no Desktop e no serviço.
			VAR _agora = UTCNOW () - 3 / 24
			VAR _hoje = INT ( _agora )
			VAR _dados = CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Valor] <> 0, 'Dados BI'[Data] <= TODAY () )
			VAR _plan = CALCULATE ( MAX ( 'Dados BI'[Planilha salva em] ), REMOVEFILTERS ( 'Dados BI' ) )
			VAR _bi = CALCULATE ( MAX ( 'Dados BI'[Carregado em] ), REMOVEFILTERS ( 'Dados BI' ) )
			-- Atraso = dias entre a última leitura e hoje. É ele que decide o status.
			VAR _atraso = _hoje - INT ( _dados )
			VAR _nivel = SWITCH ( TRUE (), ISBLANK ( _dados ), 0, _atraso <= 1, 1, _atraso <= 3, 2, 3 )
			VAR _cor = SWITCH ( _nivel, 1, "#4ed15d", 2, "#feb825", 3, "#f4353f", "#5c7791" )
			VAR _palavra = SWITCH ( _nivel, 1, "Em dia", 2, "Pendente", 3, "Atrasado", "Sem dados" )
			VAR _ha = SWITCH ( TRUE (), _atraso <= 0, "hoje", _atraso = 1, "ontem", "há " & _atraso & " dias" )
			VAR _rotulo = IF ( ISBLANK ( _dados ), "Sem leitura na planilha", "Dados até " & FORMAT ( _dados, "dd/mm" ) & " &#183; " & _ha )
			-- O que falta, na ordem em que dá para saber: o Power BI só enxerga a planilha quando é atualizado.
			VAR _falta = SWITCH ( TRUE (), _nivel = 1, "Nada pendente.", ISBLANK ( _bi ) || INT ( _bi ) < _hoje, "Falta atualizar o Power BI.", ISBLANK ( _plan ) || INT ( _plan ) < _hoje, "Falta abrir e salvar a planilha no Excel e depois atualizar o Power BI.", "Falta lançar os dados nas planilhas de origem." )
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><style>.cx:hover+.dt,.dt:hover{display:block!important}</style><div style='font-family:Segoe UI,sans-serif;height:100vh;width:100%'><div class='cx' style='height:79px;display:flex;align-items:center;gap:12px;padding:0 12px 0 16px;background:#001429;border:1px solid #245b7c;border-radius:10px;cursor:default'><span style='color:" & _cor & ";display:flex;flex:none'><svg viewBox='0 0 24 24' width='34' height='34' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4.2 10.2a8 8 0 0 1 13.4-3.3l2.2 2.1'/><path d='M19.8 13.8a8 8 0 0 1-13.4 3.3l-2.2-2.1'/><path d='M20.3 4.4v4.6h-4.6M3.7 19.6V15h4.6'/></svg></span><div style='min-width:0'><div style='font-size:15px;color:#dce9f7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & _rotulo & "</div><div style='font-size:23px;font-weight:700;color:" & _cor & ";line-height:1.25;white-space:nowrap'>" & _palavra & "</div></div></div><div class='dt' style='display:none;margin-top:6px;padding:12px 14px 13px 14px;background:#04182a;border:1px solid #245b7c;border-radius:10px;font-size:15px'><div style='display:flex;justify-content:space-between;gap:10px;line-height:1.6'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Dados até</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _dados ), "&#8212;", FORMAT ( _dados, "dd/mm/yyyy" ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:1.6'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Planilha salva</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _plan ), "&#8212;", FORMAT ( _plan, "dd/mm hh:nn" ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:1.6'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Power BI atualizado</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _bi ), "&#8212;", FORMAT ( _bi, "dd/mm hh:nn" ) ) & "</b></div><div style='margin-top:8px;padding-top:9px;border-top:1px solid #102e4b;color:#dce9f7;line-height:1.35'>" & _falta & "</div></div></div>"
			```
		displayFolder: Painel Operacional
		lineageTag: aa71737a-8e5c-5297-80fe-fb5312da2c07

	/// Caixa do cabeçalho com as datas do período exibido: o tamanho marcado no seletor Período, contado até a última leitura da planilha, ou o intervalo do controle de datas quando o seletor está em Datas exatas. Ao passar o mouse, mostra o período de cada indicador.
	measure 'HTML Período' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			-- Com um tamanho fixo, o período geral termina na última leitura da planilha (a data do rodapé).
			VAR _fim = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Valor] <> 0, 'Dados BI'[Data] <= TODAY () ) )
			VAR _rotulo = IF ( _exatas, "Datas escolhidas", "Período exibido" ) & " &#183; " & _tamanho & IF ( _tamanho = 1, " dia", " dias" )
			VAR _nota = IF ( _exatas, "Com datas exatas, todos os indicadores usam o mesmo período:", "Cada indicador conta o período até a sua última leitura:" )
			-- Onde termina o período de cada indicador: na última leitura dele ou, com datas exatas, no mesmo dia.
			VAR _f1 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Nº retrolayagens disco ( ciclos/d)", KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f2 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "DQO (mg/L)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f3 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "NH3 (mg/L)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f4 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Condutividade", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f5 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Dureza (mg/L)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f6 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Idade do lodo (dias)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f7 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Alimento/ Microorg (g/g.d-¹)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f8 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Pressão transmembrana (Bar)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f9 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Permeabilidade (LMH/bar)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f10 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Turbidez (NTU)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f11 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Fluxo (LMH)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f12 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "SDI", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f13 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "dP Skid 1 (bar)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f14 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "dP Skid-02 (bar)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f15 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "dP Skid-03 (bar)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f16 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Químicos (Kg/m³)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f17 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Energia (KWh/m³)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f18 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Energia OR KW/m³", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f19 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Energia - Biológico (KWh/kg NH3 rem)", 'Dados BI'[Valor] > 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f20 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Coagulante (gPAC/gP rem)", 'Dados BI'[Valor] > 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f21 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Clientes (L/s)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f22 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Blend %", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _f23 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Perdas %", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><style>.cx:hover+.dt,.dt:hover{display:block!important}</style><div style='font-family:Segoe UI,sans-serif;height:100vh;width:100%'><div class='cx' style='height:79px;display:flex;align-items:center;gap:12px;padding:0 12px 0 16px;background:#001429;border:1px solid #245b7c;border-radius:10px;cursor:default'><span style='color:#dce9f7;display:flex;flex:none'><svg viewBox='0 0 24 24' width='34' height='34' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3.5' y='5' width='17' height='15.5' rx='2.2'/><path d='M3.5 10h17M8 3v4M16 3v4'/></svg></span><div style='min-width:0'><div style='font-size:15px;color:#dce9f7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & _rotulo & "</div><div style='font-size:23px;font-weight:700;color:#ffffff;line-height:1.25;white-space:nowrap'>" & IF ( ISBLANK ( _fim ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _fim, "dd/mm" ), FORMAT ( _fim - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _fim, "dd/mm" ) ) ) & "</div></div></div><div class='dt' style='display:none;margin-top:6px;padding:12px 14px 13px 14px;background:#04182a;border:1px solid #245b7c;border-radius:10px;font-size:13px'><div style='font-size:15px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _fim ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _fim, "dd/mm/yyyy" ), FORMAT ( _fim - _tamanho + 1, "dd/mm/yyyy" ) & " a " & FORMAT ( _fim, "dd/mm/yyyy" ) ) ) & "</div><div style='margin-top:4px;color:#93afc9;line-height:1.3'>" & _nota & "</div><div style='margin-top:8px;font-size:11px;letter-spacing:0.6px;color:#6b89a6;white-space:nowrap'>QUALIDADE EEBC</div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Retrolavagens</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f1 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f1, "dd/mm" ), FORMAT ( _f1 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f1, "dd/mm" ) ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>DQO</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f2 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f2, "dd/mm" ), FORMAT ( _f2 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f2, "dd/mm" ) ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>NH3</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f3 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f3, "dd/mm" ), FORMAT ( _f3 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f3, "dd/mm" ) ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Condutividade</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f4 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f4, "dd/mm" ), FORMAT ( _f4 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f4, "dd/mm" ) ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Dureza</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f5 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f5, "dd/mm" ), FORMAT ( _f5 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f5, "dd/mm" ) ) ) & "</b></div><div style='margin-top:8px;font-size:11px;letter-spacing:0.6px;color:#6b89a6;white-space:nowrap'>PERFORMANCE TMBR</div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Idade do Lodo</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f6 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f6, "dd/mm" ), FORMAT ( _f6 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f6, "dd/mm" ) ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Alimento/Microorg.</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f7 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f7, "dd/mm" ), FORMAT ( _f7 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f7, "dd/mm" ) ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>TMP</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f8 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f8, "dd/mm" ), FORMAT ( _f8 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f8, "dd/mm" ) ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Permeabilidade</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f9 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f9, "dd/mm" ), FORMAT ( _f9 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f9, "dd/mm" ) ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:19px'><span style='color:#93afc9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Turbidez</span><b style='color:#dce9f7;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _f10 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f10, "dd/mm" ), FORMAT ( _f10 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f1