			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><div style='font-family:Segoe UI,sans-serif;height:100vh;width:100%;display:flex;flex-direction:column;gap:5px'><div style='height:62px;flex:none;border-radius:10px;background:linear-gradient(90deg,#0a6a62 0%,#064b47 48%,#05282f 100%);border:1px solid #2a6ca8;display:flex;align-items:center;gap:14px;padding:0 18px'><span style='color:#3ddc84;display:flex'><svg viewBox='0 0 24 24' width='34' height='34' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><path d='M20 4c0 8.3-4.2 12.4-10.4 12.4A5.6 5.6 0 0 1 4 10.8C4 5.6 9.6 4 20 4z'/><path d='M4.6 19.4C7 15 11 11.6 16.2 9.6'/></svg></span><span style='color:#4fe3dd;display:flex'><svg viewBox='0 0 24 24' width='34' height='34' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><path d='M13.4 2.5L4.8 13.4h5.6l-.8 8.1 8.6-10.9h-5.6z' fill='currentColor' stroke='none'/></svg></span><span style='font-size:27px;font-weight:700;color:#ffffff;letter-spacing:0.8px;white-space:nowrap'>CONSUMO DE QUÍMICOS E ENERGIA</span><span style='margin-left:34px;font-size:16px;color:#9dbbd8;font-weight:400;white-space:nowrap'>Consumos específicos</span></div><div style='flex:1;min-height:0;display:flex;gap:9px;padding:11px;background:#001f3a;border:1px solid #143d5c;border-radius:10px'>" & _itens & "</div></div>"
			```
		displayFolder: Painel Operacional
		lineageTag: 40e31478-e022-5268-8ccd-9417526a0b12

	/// Painel VOLUMES da Visão Geral: Clientes, Blend, Perdas. Valor = média dos últimos 30 dias com dado ([Valor 30d]); referência = Target_Min/Target_Max da dim_indicadores. Verde dentro da meta, amarelo até 10% fora, vermelho além disso. A barra enche até 160% da referência e o tracejado marca os 100%.
	measure 'HTML Painel Volumes' = ```
			VAR _ids1 = { "Volumes | Todos Clientes" }
			VAR _v1 = 0.0115740741 * CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, fato_indicadores[ID_Indicador] ) )
			VAR _mi1 = 0.0115740741 * CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _ma1 = 0.0115740741 * CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _rf1 = _mi1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 >= _rf1, "#4ed15d", _v1 >= _rf1 * 0.9, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an1 = 0.0115740741 * CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, fato_indicadores[ID_Indicador] ) )
			VAR _te1 = NOT ISBLANK ( _v1 ) && NOT ISBLANK ( _an1 ) && _an1 <> 0
			VAR _dl1 = DIVIDE ( _v1 - _an1, _an1 )
			VAR _ids3 = { "Perdas | Perda Total" }
			VAR _v3 = 100.0 * CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, fato_indicadores[ID_Indicador] ) )
			VAR _mi3 = 100.0 * CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _ma3 = 100.0 * CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an3 = 100.0 * CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, fato_indicadores[ID_Indicador] ) )
			VAR _te3 = NOT ISBLANK ( _v3 ) && NOT ISBLANK ( _an3 ) && _an3 <> 0
			VAR _dl3 = _v3 - _an3
			VAR _itens =
			    "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M2.6 8.4h7.2a2.6 2.6 0 0 1 2.6 2.6v2a2.6 2.6 0 0 0 2.6 2.6h6.4'/><path d='M18.6 12.8l2.8 2.8-2.8 2.8M2.6 5.6v5.6'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Clientes</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>L/s</div></div></div><div style='flex:1'></div><div style='display:flex;align-items:flex-end;gap:6px'><div style='font-size:38px;font-weight:700;color:#ffffff;line-height:1;white-space:nowrap'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0.0" ) ) & "</div><div style='margin-left:auto;text-align:right'><div style='font-size:18px;font-weight:700;color:" & IF ( NOT _te1, "#5c7791", IF ( _dl1 > 0, "#4ed15d", "#f4353f" ) ) & ";white-space:nowrap'>" & IF ( _te1, IF ( _dl1 >= 0, "&#9650;", "&#9660;" ), "" ) & " " & IF ( _te1, FORMAT ( _dl1, "+0.0%;-0.0%" ), "&#8212;" ) & "</div><div style='font-size:15px;color:#93afc9;margin-top:2px'>&#916; Per.</div></div></div><div style='margin-top:12px'><div style='position:relative;height:20px;background:#123855;border-radius:10px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg1, "0" ) & "%;height:100%;background:" & _co1 & ";border-radius:10px'></div><div style='position:absolute;left:62.5%;top:-4px;height:28px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='margin-top:9px;display:flex;align-items:baseline;font-size:16px;color:#93afc9'><span style='white-space:nowrap'>" & IF ( ISBLANK ( _rf1 ), "Ref. &#8212;", "Ref. " & FORMAT ( _rf1, "#,##0.0" ) & " L/s" ) & "</span><b style='margin-left:auto;padding-left:8px;font-size:19px;color:#ffffff'>" & IF ( ISBLANK ( _rf1 ) || ISBLANK ( _v1 ), "&#8212;", FORMAT ( DIVIDE ( _v1, _rf1 ), "0%" ) ) & "</b></div></div>"
			        & "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M9.4 2.8h5.2M10.3 2.8v6.1L5 18.6a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5.3-9.7V2.8'/><path d='M7.2 15.4h9.6'/><circle cx='10' cy='18' r='0.9' fill='currentColor' stroke='none'/><circle cx='13.4' cy='18.6' r='0.9' fill='currentColor' stroke='none'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Blend</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>%</div></div></div><div style='flex:1'></div><div style='font-size:38px;font-weight:700;color:#5c7791;line-height:1'>&#8212;</div><div style='margin-top:12px;font-size:15px;color:#6b89a6;line-height:1.35'>A base ainda não traz o indicador de Blend.</div></div>"
			        & "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3c3.4 4 5.5 6.6 5.5 9.3A5.5 5.5 0 0 1 6.5 12.3C6.5 9.6 8.6 7 12 3z'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Perdas</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>%</div></div></div><div style='flex:1'></div><div style='display:flex;align-items:flex-end;gap:6px'><div style='font-size:38px;font-weight:700;color:#ffffff;line-height:1;white-space:nowrap'>" & IF ( ISBLANK ( _v3 ), "&#8212;", FORMAT ( _v3, "#,##0.0" ) ) & "</div><div style='margin-left:auto;text-align:right'><div style='font-size:18px;font-weight:700;color:" & IF ( NOT _te3, "#5c7791", IF ( _dl3 < 0, "#4ed15d", "#f4353f" ) ) & ";white-space:nowrap'>" & IF ( _te3, IF ( _dl3 >= 0, "&#9650;", "&#9660;" ), "" ) & " " & IF ( _te3, FORMAT ( _dl3, "+0.0;-0.0" ) & " p.p.", "&#8212;" ) & "</div><div style='font-size:15px;color:#93afc9;margin-top:2px'>&#916; Per.</div></div></div><div style='margin-top:12px'><div style='position:relative;height:20px;background:#123855;border-radius:10px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg3, "0" ) & "%;height:100%;background:" & _co3 & ";border-radius:10px'></div><div style='position:absolute;left:62.5%;top:-4px;height:28px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='margin-top:9px;display:flex;align-items:baseline;font-size:16px;color:#93afc9'><span style='white-space:nowrap'>" & IF ( ISBLANK ( _rf3 ), "Ref. &#8212;", "Ref. " & FORMAT ( _rf3, "#,##0.0" ) & " %" ) & "</span><b style='margin-left:auto;padding-left:8px;font-size:19px;color:#ffffff'>" & IF ( ISBLANK ( _rf3 ) || ISBLANK ( _v3 ), "&#8212;", FORMAT ( DIVIDE ( _v3, _rf3 ), "0%" ) ) & "</b></div></div>"
			RETURN
