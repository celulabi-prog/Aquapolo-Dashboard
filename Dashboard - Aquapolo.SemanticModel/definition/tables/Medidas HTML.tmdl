			VAR _t =
			    ADDCOLUMNS (
			        _dias,
			        "@v", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Energia OR KW/m³" ),
			        "@p", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Clientes (L/s)" )
			    )
			RETURN
			    DIVIDE ( SUMX ( _t, [@v] * [@p] ), SUMX ( _t, [@p] ) )
			```
		formatString: #,0.00
		displayFolder: Painel Operacional\Indicadores
		lineageTag: 470aca11-c887-552d-8e82-c31665063c5f

	/// Energia - Biológico: mediana dos valores positivos (a planilha não traz o divisor, e um dia com divisor perto de zero estouraria a média) do período marcado no seletor Período (30 dias se nada estiver marcado), contado até a última leitura do indicador; com Datas exatas, do intervalo do controle de datas, coluna 'Energia - Biológico (KWh/kg NH3 rem)' da planilha Dados BI. Zero e datas futuras ficam de fora: na planilha, zero é célula vazia na origem.
	measure 'Energia - Biológico Período' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _ultima =
			    CALCULATE (
			        MAX ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Energia - Biológico (KWh/kg NH3 rem)",
			        'Dados BI'[Valor] > 0,
			        KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () )
			    )
			VAR _fim = IF ( _exatas, _ate, _ultima )
			RETURN
			    CALCULATE (
			        MEDIAN ( 'Dados BI'[Valor] ),
			        'Dados BI'[Indicador] = "Energia - Biológico (KWh/kg NH3 rem)",
			        'Dados BI'[Valor] > 0,
			        'Dados BI'[Data] > _fim - _tamanho,
			        'Dados BI'[Data] <= _fim
			    )
			```
		formatString: #,0.0
		displayFolder: Painel Operacional\Indicadores
		lineageTag: ac353ef4-1b8a-52b9-9bcd-c20e88f5c469

	/// Energia - Biológico: mediana dos valores positivos (a planilha não traz o divisor, e um dia com divisor perto de zero estouraria a média) do período anterior ao de [Energia - Biológico Período], com o mesmo tamanho, coluna 'Energia - Biológico (KWh/kg NH3 rem)' da planilha Dados BI. Zero e datas futuras ficam de fora: na planilha, zero é célula vazia na origem.
	measure 'Energia - Biológico Período Anterior' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _ultima =
			    CALCULATE (
			        MAX ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Energia - Biológico (KWh/kg NH3 rem)",
			        'Dados BI'[Valor] > 0,
