			        & "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='2.2'/><path d='M12 9.8c0-3.6.9-6.4 3.4-6.4 2 0 2.8 2.4 1.2 4.3-1.2 1.4-2.9 2.1-4.6 2.1z'/><path d='M14.2 12c3.6 0 6.4.9 6.4 3.4 0 2-2.4 2.8-4.3 1.2-1.4-1.2-2.1-2.9-2.1-4.6z'/><path d='M9.8 12c-3.6 0-6.4-.9-6.4-3.4 0-2 2.4-2.8 4.3-1.2 1.4 1.2 2.1 2.9 2.1 4.6z'/><path d='M12 14.2c0 3.6-.9 6.4-3.4 6.4-2 0-2.8-2.4-1.2-4.3 1.2-1.4 2.9-2.1 4.6-2.1z'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Energia - Biológico</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>kWh/kg NH3 rem</div></div></div><div style='flex:1'></div><div style='display:flex;align-items:flex-end;gap:6px'><div style='font-size:38px;font-weight:700;color:#ffffff;line-height:1;white-space:nowrap'>" & IF ( ISBLANK ( _v4 ), "&#8212;", FORMAT ( _v4, "#,##0.0" ) ) & "</div><div style='margin-left:auto;text-align:right'><div style='font-size:18px;font-weight:700;color:" & IF ( NOT _te4, "#5c7791", IF ( _dl4 < 0, "#4ed15d", "#f4353f" ) ) & ";white-space:nowrap'>" & IF ( _te4, IF ( _dl4 >= 0, "&#9650;", "&#9660;" ), "" ) & " " & IF ( _te4, FORMAT ( _dl4, "+0.0%;-0.0%" ), "&#8212;" ) & "</div><div style='font-size:15px;color:#93afc9;margin-top:2px'>&#916; Per.</div></div></div><div style='margin-top:12px'><div style='position:relative;height:20px;background:#123855;border-radius:10px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg4, "0" ) & "%;height:100%;background:" & _co4 & ";border-radius:10px'></div><div style='position:absolute;left:62.5%;top:-4px;height:28px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='margin-top:9px;display:flex;align-items:baseline;font-size:16px;color:#93afc9'><span style='white-space:nowrap'>" & IF ( ISBLANK ( _rf4 ), "Ref. &#8212;", "Ref. " & FORMAT ( _rf4, "#,##0.0" ) & " kWh/kg" ) & "</span><b style='margin-left:auto;padding-left:8px;font-size:19px;color:#ffffff'>" & IF ( ISBLANK ( _rf4 ) || ISBLANK ( _v4 ), "&#8212;", FORMAT ( DIVIDE ( _v4, _rf4 ), "0%" ) ) & "</b></div></div>"
			        & "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='5.2' r='2.3'/><circle cx='5.2' cy='17' r='2.3'/><circle cx='18.8' cy='17' r='2.3'/><path d='M10.8 7.2L6.4 14.9M13.2 7.2l4.4 7.7M7.5 17h9'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Coagulante</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>gPAC/gP rem</div></div></div><div style='flex:1'></div><div style='display:flex;align-items:flex-end;gap:6px'><div style='font-size:38px;font-weight:700;color:#ffffff;line-height:1;white-space:nowrap'>" & IF ( ISBLANK ( _v5 ), "&#8212;", FORMAT ( _v5, "#,##0.0" ) ) & "</div><div style='margin-left:auto;text-align:right'><div style='font-size:18px;font-weight:700;color:" & IF ( NOT _te5, "#5c7791", IF ( _dl5 < 0, "#4ed15d", "#f4353f" ) ) & ";white-space:nowrap'>" & IF ( _te5, IF ( _dl5 >= 0, "&#9650;", "&#9660;" ), "" ) & " " & IF ( _te5, FORMAT ( _dl5, "+0.0%;-0.0%" ), "&#8212;" ) & "</div><div style='font-size:15px;color:#93afc9;margin-top:2px'>&#916; Per.</div></div></div><div style='margin-top:12px'><div style='position:relative;height:20px;background:#123855;border-radius:10px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg5, "0" ) & "%;height:100%;background:" & _co5 & ";border-radius:10px'></div><div style='position:absolute;left:62.5%;top:-4px;height:28px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='margin-top:9px;display:flex;align-items:baseline;font-size:16px;color:#93afc9'><span style='white-space:nowrap'>" & IF ( ISBLANK ( _rf5 ), "Ref. &#8212;", "Ref. " & FORMAT ( _rf5, "#,##0.0" ) & " gPAC/gP" ) & "</span><b style='margin-left:auto;padding-left:8px;font-size:19px;color:#ffffff'>" & IF ( ISBLANK ( _rf5 ) || ISBLANK ( _v5 ), "&#8212;", FORMAT ( DIVIDE ( _v5, _rf5 ), "0%" ) ) & "</b></div></div>"
