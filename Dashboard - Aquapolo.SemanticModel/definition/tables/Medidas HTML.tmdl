	/// Retrolavagens: média simples do período marcado no seletor Período (30 dias se nada estiver marcado), contado até a última leitura do indicador; com Datas exatas, do intervalo do controle de datas, coluna 'Nº retrolayagens disco ( ciclos/d)' da planilha Dados BI. Zero conta como leitura.
	measure 'Retrolavagens Período' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _ultima =
			    CALCULATE (
			        MAX ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Nº retrolayagens disco ( ciclos/d)",
			        KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () )
			    )
			VAR _fim = IF ( _exatas, _ate, _ultima )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'Dados BI'[Valor] ),
			        'Dados BI'[Indicador] = "Nº retrolayagens disco ( ciclos/d)",
			        'Dados BI'[Data] > _fim - _tamanho,
			        'Dados BI'[Data] <= _fim
			    )
			```
		formatString: #,0
		displayFolder: Painel Operacional\Indicadores
		lineageTag: f6251bd4-4e90-5030-b75c-927f06d82ba2

	/// DQO: média simples do período marcado no seletor Período (30 dias se nada estiver marcado), contado até a última leitura do indicador; com Datas exatas, do intervalo do controle de datas, coluna 'DQO (mg/L)' da planilha Dados BI. Zero e datas futuras ficam de fora: na planilha, zero é célula vazia na origem.
	measure 'DQO Período' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _ultima =
			    CALCULATE (
			        MAX ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "DQO (mg/L)",
			        'Dados BI'[Valor] <> 0,
			        KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () )
			    )
			VAR _fim = IF ( _exatas, _ate, _ultima )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'Dados BI'[Valor] ),
			        'Dados BI'[Indicador] = "DQO (mg/L)",
			        'Dados BI'[Valor] <> 0,
			        'Dados BI'[Data] > _fim - _tamanho,
			        'Dados BI'[Data] <= _fim
			    )
			```
		formatString: #,0
		displayFolder: Painel Operacional\Indicadores
		lineageTag: eed6ff4a-7fd3-5ea3-bfca-c26bd8b824bd

