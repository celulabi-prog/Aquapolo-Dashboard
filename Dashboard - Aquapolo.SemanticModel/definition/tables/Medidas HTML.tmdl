	measure 'HTML Consumo Soprador' = ```
			    -- ===== EDITAR AQUI (Consumo Soprador TMBR) =====
			    -- Valor: média dos últimos 30 dias com dado. Ref.: meta da dim_indicadores.
			    VAR Ids = { "Energia | Consumo SOP Biológico/ Amônia Removida" }
			    VAR Valor = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, fato_indicadores[ID_Indicador] ) )
			    VAR Ref = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, dim_indicadores[ID_Indicador] ) )
			    VAR Anterior = CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, fato_indicadores[ID_Indicador] ) )
			    VAR VarPeriodo = DIVIDE ( Valor - Anterior, Anterior )    -- variação vs 30 dias anteriores
			    VAR TipoVar = "%"
			    VAR MenorMelhor = TRUE ()
			    VAR FmtValor = "0.0"
			    VAR UnidadeRef = ""
			    -- ===== daqui pra baixo não precisa mexer =====
			    VAR Tolerancia = 0.10      -- faixa de "Atenção" (10% além da referência)
			    VAR Atingimento = DIVIDE ( Valor, Ref )
			    VAR Cor =
			        IF ( ISBLANK ( Ref ), "#90a4ae",
			        IF (
			            MenorMelhor,
			            SWITCH ( TRUE (), Valor <= Ref, "#43a047", Valor <= Ref * ( 1 + Tolerancia ), "#f9a825", "#e53935" ),
			            SWITCH ( TRUE (), Valor >= Ref, "#43a047", Valor >= Ref * ( 1 - Tolerancia ), "#f9a825", "#e53935" )
			        ) )
			    VAR Escala = 1.3           -- barra cheia = 130% da referência
			    VAR Largura = IF ( ISBLANK ( Ref ), 0, MIN ( Atingimento, Escala ) / Escala * 100 )
			    VAR Marcador = 100 / Escala
			    VAR VariacaoBoa = IF ( MenorMelhor, VarPeriodo < 0, VarPeriodo > 0 )
			    VAR CorVar = IF ( VariacaoBoa, "#2e7d32", "#c62828" )
			    VAR Seta = IF ( VarPeriodo >= 0, "▲", "▼" )
			    VAR TxtVar =
			        IF ( TipoVar = "%", FORMAT ( VarPeriodo, "+0.0%;-0.0%" ), FORMAT ( VarPeriodo, "+0.0;-0.0" ) & " p.p." )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#0b2a5b;padding:0 4px'>"
			        & "<div style='display:flex;align-items:baseline;justify-content:space-between'>"
			        & "<b style='font-size:18px'>" & FORMAT ( Valor, FmtValor ) & "</b>"
			        & "<span style='font-size:11px;font-weight:600;color:" & CorVar & "'>" & Seta & " " & TxtVar & "</span>"
			        & "</div>"
			        & "<div style='display:flex;align-items:center;gap:8px;margin-top:6px'>"
			        & "<div style='flex:1'>"
			        & "<div style='position:relative;height:7px;background:#e6edf5;border-radius:3px'>"
			        & "<div style='width:" & FORMAT ( Largura, "0" ) & "%;height:100%;background:" & Cor & ";border-radius:3px'>"
			        & "</div>"
			        & "<div style='position:absolute;left:" & FORMAT ( Marcador, "0" ) & "%;top:-4px;height:15px;border-left:2px dashed #0b2a5b'>"
			        & "</div>"
			        & "</div>"
			        & "</div>"
			        & "<span style='font-size:10px;color:#4a5b70;white-space:nowrap'>Ref. " & FORMAT ( Ref, FmtValor ) & "</span>"
			        & "</div>"
			        & "</div>"
			```
		lineageTag: eb51ac46-e0cc-431c-9d7f-320ebdb021a1

	measure 'HTML Consumo Coagulante' = ```
			    -- ===== EDITAR AQUI (Consumo Coagulante) =====
			    -- Valor: média dos últimos 30 dias com dado. Ref.: meta da dim_indicadores.
			    VAR Ids = { "Químicos | PAC/ P rem" }
			    VAR Valor = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, fato_indicadores[ID_Indicador] ) )
			    VAR Ref = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, dim_indicadores[ID_Indicador] ) )
			    VAR Anterior = CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, fato_indicadores[ID_Indicador] ) )
			    VAR VarPeriodo = DIVIDE ( Valor - Anterior, Anterior )    -- variação vs 30 dias anteriores
			    VAR TipoVar = "%"
			    VAR MenorMelhor = TRUE ()
			    VAR FmtValor = "0.0"
			    VAR UnidadeRef = ""
			    -- ===== daqui pra baixo não precisa mexer =====
			    VAR Tolerancia = 0.10      -- faixa de "Atenção" (10% além da referência)
			    VAR Atingimento = DIVIDE ( Valor, Ref )
			    VAR Cor =
			        IF (
			            MenorMelhor,
			            SWITCH ( TRUE (), Valor <= Ref, "#43a047", Valor <= Ref * ( 1 + Tolerancia ), "#f9a825", "#e53935" ),
			            SWITCH ( TRUE (), Valor >= Ref, "#43a047", Valor >= Ref * ( 1 - Tolerancia ), "#f9a825", "#e53935" )
			        )
			    VAR Escala = 1.3           -- barra cheia = 130% da referência
			    VAR Largura = MIN ( Atingimento, Escala ) / Escala * 100
			    VAR Marcador = 100 / Escala
			    VAR VariacaoBoa = IF ( MenorMelhor, VarPeriodo < 0, VarPeriodo > 0 )
			    VAR CorVar = IF ( VariacaoBoa, "#2e7d32", "#c62828" )
			    VAR Seta = IF ( VarPeriodo >= 0, "▲", "▼" )
			    VAR TxtVar =
			        IF ( TipoVar = "%", FORMAT ( VarPeriodo, "+0.0%;-0.0%" ), FORMAT ( VarPeriodo, "+0.0;-0.0" ) & " p.p." )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#0b2a5b;padding:0 4px'>"
			        & "<div style='display:flex;align-items:baseline;justify-content:space-between'>"
			        & "<b style='font-size:18px'>" & FORMAT ( Valor, FmtValor ) & "</b>"
			        & "<span style='font-size:11px;font-weight:600;color:" & CorVar & "'>" & Seta & " " & TxtVar & "</span>"
			        & "</div>"
			        & "<div style='display:flex;align-items:center;gap:8px;margin-top:6px'>"
			        & "<div style='flex:1'>"
			        & "<div style='position:relative;height:7px;background:#e6edf5;border-radius:3px'>"
			        & "<div style='width:" & FORMAT ( Largura, "0" ) & "%;height:100%;background:" & Cor & ";border-radius:3px'>"
			        & "</div>"
			        & "<div style='position:absolute;left:" & FORMAT ( Marcador, "0" ) & "%;top:-4px;height:15px;border-left:2px dashed #0b2a5b'>"
			        & "</div>"
			        & "</div>"
			        & "</div>"
			        & "<span style='font-size:10px;color:#4a5b70;white-space:nowrap'>Ref. " & FORMAT ( Ref, FmtValor ) & "</span>"
			        & "</div>"
			        & "</div>"
			```
		lineageTag: ae6a0032-ac15-4e38-bee6-e5909f4f274d

	measure 'HTML Retrolavagem' = ```
			    -- ===== EDITAR AQUI (Nº Retrolavagem Disco) =====
