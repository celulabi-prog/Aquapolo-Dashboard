	/// Faixa do rodapé: data da última medição da base e a legenda das cores e dos termos.
	measure 'HTML Rodapé' = ```
			VAR _ult = CALCULATE ( MAX ( fato_indicadores[Data] ), ALL ( fato_indicadores ) )
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><div style='font-family:Segoe UI,sans-serif;height:100vh;width:100%;display:flex;align-items:center;gap:24px;padding:0 26px;background:#04182a;border:1px solid #1f5a66;border-radius:10px'><span style='color:#93afc9;display:flex;flex:none'><svg viewBox='0 0 24 24' width='25' height='25' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 6.6V12l3.6 2.2'/></svg></span><span style='font-size:17px;color:#dce9f7;white-space:nowrap'>Última atualização: " & IF ( ISBLANK ( _ult ), "&#8212;", FORMAT ( _ult, "dd/mm/yyyy" ) ) & "</span><div style='width:1px;height:42px;background:#2a5f78;flex:none'></div><div><div style='font-size:17px;color:#dce9f7;white-space:nowrap'><b>Legenda do status</b> <span style='font-size:15px;color:#93afc9'>(em relação à referência)</span></div><div style='margin-top:7px;font-size:16px;color:#dce9f7;white-space:nowrap'><span style='display:inline-block;width:14px;height:14px;border-radius:50%;vertical-align:-2px;margin-right:8px;background:#4ed15d'></span>Dentro da meta &nbsp;&nbsp;&nbsp;<span style='display:inline-block;width:14px;height:14px;border-radius:50%;vertical-align:-2px;margin-right:8px;background:#feb825'></span>Atenção &nbsp;&nbsp;&nbsp;<span style='display:inline-block;width:14px;height:14px;border-radius:50%;vertical-align:-2px;margin-right:8px;background:#f4353f'></span>Fora da meta</div></div><div style='width:1px;height:42px;background:#2a5f78;flex:none'></div><div style='display:flex;align-items:center;gap:11px'><b style='font-size:17px;color:#dce9f7;white-space:nowrap'>&#916; Per.</b><span style='font-size:15px;color:#93afc9;line-height:1.3'>Variação em relação ao<br>período anterior</span></div><div style='width:1px;height:42px;background:#2a5f78;flex:none'></div><div style='display:flex;align-items:center;gap:11px'><b style='font-size:17px;color:#dce9f7;white-space:nowrap'>Ref.</b><span style='font-size:15px;color:#93afc9;line-height:1.3'>Valor de referência<br>(meta)</span></div><div style='width:1px;height:42px;background:#2a5f78;flex:none'></div><div style='display:flex;align-items:center;gap:11px'><b style='font-size:17px;color:#dce9f7;white-space:nowrap'>Faixa</b><span style='font-size:15px;color:#93afc9;line-height:1.3'>Faixa operacional</span></div><div style='margin-left:auto;padding-left:24px;font-size:16px;color:#93afc9;white-space:nowrap'>Aquapolo &nbsp;&#124;&nbsp; GS Inima &nbsp;&#124;&nbsp; Sabesp</div></div>"
			```
