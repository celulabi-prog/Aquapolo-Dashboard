		displayFolder: Painel Operacional
		lineageTag: 240860e3-5f5f-5e74-a1aa-fe07fcd1903a

	/// Painel PERFORMANCE OR da Visão Geral: SDI, dP Skid 1, dP Skid 2, dP Skid 3. Valor = média dos últimos 30 dias com dado ([Valor 30d]); referência = Target_Min/Target_Max da dim_indicadores. Verde dentro da meta, amarelo até 10% fora, vermelho além disso. A barra enche até 160% da referência e o tracejado marca os 100%.
	measure 'HTML Painel OR' = ```
			VAR _ids1 = { "Osmose Reversa | SDI" }
			VAR _v1 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, fato_indicadores[ID_Indicador] ) )
			VAR _mi1 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _ma1 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _rf1 = _ma1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 <= _rf1, "#4ed15d", _v1 <= _rf1 * 1.1, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids2 = { "Osmose Reversa | Diferencial de Pressão - Skid 1" }
			VAR _v2 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, fato_indicadores[ID_Indicador] ) )
			VAR _mi2 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, dim_indicadores[ID_Indicador] ) )
			VAR _ma2 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, dim_indicadores[ID_Indicador] ) )
			VAR _rf2 = _ma2
			VAR _co2 = SWITCH ( TRUE (), ISBLANK ( _v2 ) || ISBLANK ( _rf2 ), "#5c7791", _v2 <= _rf2, "#4ed15d", _v2 <= _rf2 * 1.1, "#feb825", "#f4353f" )
			VAR _lg2 = MIN ( MAX ( DIVIDE ( _v2, _rf2 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids3 = { "Osmose Reversa | Diferencial de Pressão - Skid 2" }
			VAR _v3 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, fato_indicadores[ID_Indicador] ) )
			VAR _mi3 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _ma3 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids4 = { "Osmose Reversa | Diferencial de Pressão - Skid 3" }
			VAR _v4 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, fato_indicadores[ID_Indicador] ) )
			VAR _mi4 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, dim_indicadores[ID_Indicador] ) )
			VAR _ma4 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, dim_indicadores[ID_Indicador] ) )
			VAR _rf4 = _ma4
			VAR _co4 = SWITCH ( TRUE (), ISBLANK ( _v4 ) || ISBLANK ( _rf4 ), "#5c7791", _v4 <= _rf4, "#4ed15d", _v4 <= _rf4 * 1.1, "#feb825", "#f4353f" )
			VAR _lg4 = MIN ( MAX ( DIVIDE ( _v4, _rf4 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _itens =
			    "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='2.4' fill='currentColor' stroke='none'/><circle cx='12' cy='4.4' r='1.25' fill='currentColor' stroke='none'/><circle cx='12' cy='19.6' r='1.25' fill='currentColor' stroke='none'/><circle cx='4.4' cy='12' r='1.25' fill='currentColor' stroke='none'/><circle cx='19.6' cy='12' r='1.25' fill='currentColor' stroke='none'/><circle cx='6.6' cy='6.6' r='1.25' fill='currentColor' stroke='none'/><circle cx='17.4' cy='6.6' r='1.25' fill='currentColor' stroke='none'/><circle cx='6.6' cy='17.4' r='1.25' fill='currentColor' stroke='none'/><circle cx='17.4' cy='17.4' r='1.25' fill='currentColor' stroke='none'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>SDI</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0.0" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg1, "0" ) & "%;height:100%;background:" & _co1 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Ref." & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _rf1 ), "&#8212;", FORMAT ( _rf1, "#,##0.0" ) ) & "</div></div></div>"
