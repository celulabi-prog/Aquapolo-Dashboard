	/// Painel QUALIDADE EEBC da Visão Geral: Retrolavagens, DQO, NH3, Condutividade, Dureza. Valor = média dos últimos 30 dias com dado ([Valor 30d]); referência = Target_Min/Target_Max da dim_indicadores. Verde dentro da meta, amarelo até 10% fora, vermelho além disso. A barra enche até 160% da referência e o tracejado marca os 100%.
	measure 'HTML Painel EEBC' = ```
			VAR _ids1 = { "Filtro Disco | Número de Retrolavagens (AV)" }
			VAR _v1 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, fato_indicadores[ID_Indicador] ) )
			VAR _mi1 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _ma1 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _rf1 = _ma1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 <= _rf1, "#4ed15d", _v1 <= _rf1 * 1.1, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids2 = { "Água Bruta | DQO" }
			VAR _v2 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, fato_indicadores[ID_Indicador] ) )
			VAR _mi2 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, dim_indicadores[ID_Indicador] ) )
			VAR _ma2 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, dim_indicadores[ID_Indicador] ) )
			VAR _rf2 = _ma2
			VAR _co2 = SWITCH ( TRUE (), ISBLANK ( _v2 ) || ISBLANK ( _rf2 ), "#5c7791", _v2 <= _rf2, "#4ed15d", _v2 <= _rf2 * 1.1, "#feb825", "#f4353f" )
			VAR _lg2 = MIN ( MAX ( DIVIDE ( _v2, _rf2 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids3 = { "Água Bruta | Amônia" }
			VAR _v3 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, fato_indicadores[ID_Indicador] ) )
			VAR _mi3 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _ma3 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids4 = { "Água Bruta | Condutividade online" }
			VAR _v4 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, fato_indicadores[ID_Indicador] ) )
			VAR _mi4 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, dim_indicadores[ID_Indicador] ) )
			VAR _ma4 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, dim_indicadores[ID_Indicador] ) )
			VAR _rf4 = _ma4
			VAR _co4 = SWITCH ( TRUE (), ISBLANK ( _v4 ) || ISBLANK ( _rf4 ), "#5c7791", _v4 <= _rf4, "#4ed15d", _v4 <= _rf4 * 1.1, "#feb825", "#f4353f" )
			VAR _lg4 = MIN ( MAX ( DIVIDE ( _v4, _rf4 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _ids5 = { "Água Bruta | Dureza" }
			VAR _v5 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, fato_indicadores[ID_Indicador] ) )
			VAR _mi5 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, dim_indicadores[ID_Indicador] ) )
			VAR _ma5 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, dim_indicadores[ID_Indicador] ) )
			VAR _rf5 = _ma5
			VAR _co5 = SWITCH ( TRUE (), ISBLANK ( _v5 ) || ISBLANK ( _rf5 ), "#5c7791", _v5 <= _rf5, "#4ed15d", _v5 <= _rf5 * 1.1, "#feb825", "#f4353f" )
			VAR _lg5 = MIN ( MAX ( DIVIDE ( _v5, _rf5 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _itens =
			    "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M4.2 10.2a8 8 0 0 1 13.4-3.3l2.2 2.1'/><path d='M19.8 13.8a8 8 0 0 1-13.4 3.3l-2.2-2.1'/><path d='M20.3 4.4v4.6h-4.6M3.7 19.6V15h4.6'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Retrolavagens</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>ciclos</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg1, "0" ) & "%;height:100%;background:" & _co1 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Ref." & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _rf1 ), "&#8212;", FORMAT ( _rf1, "#,##0" ) ) & "</div></div></div>"
			        & "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M9.4 2.8h5.2M10.3 2.8v6.1L5 18.6a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5.3-9.7V2.8'/><path d='M7.2 15.4h9.6'/><circle cx='10' cy='18' r='0.9' fill='currentColor' stroke='none'/><circle cx='13.4' cy='18.6' r='0.9' fill='currentColor' stroke='none'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>DQO</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>mg/L</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v2 ), "&#8212;", FORMAT ( _v2, "#,##0" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg2, "0" ) & "%;height:100%;background:" & _co2 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Ref." & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _rf2 ), "&#8212;", FORMAT ( _rf2, "#,##0" ) ) & "</div></div></div>"
			        & "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='5.2' r='2.3'/><circle cx='5.2' cy='17' r='2.3'/><circle cx='18.8' cy='17' r='2.3'/><path d='M10.8 7.2L6.4 14.9M13.2 7.2l4.4 7.7M7.5 17h9'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>NH3</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>mg/L</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v3 ), "&#8212;", FORMAT ( _v3, "#,##0.0" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg3, "0" ) & "%;height:100%;background:" & _co3 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Ref." & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _rf3 ), "&#8212;", FORMAT ( _rf3, "#,##0.0" ) ) & "</div></div></div>"
			        & "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M2.6 7.6c1.9-1.9 3.7-1.9 5.6 0s3.7 1.9 5.6 0 3.7-1.9 5.6 0'/><path d='M2.6 12.4c1.9-1.9 3.7-1.9 5.6 0s3.7 1.9 5.6 0 3.7-1.9 5.6 0'/><path d='M2.6 17.2c1.9-1.9 3.7-1.9 5.6 0s3.7 1.9 5.6 0 3.7-1.9 5.6 0'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Condutividade</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>µS/cm</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v4 ), "&#8212;", FORMAT ( _v4, "#,##0" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg4, "0" ) & "%;height:100%;background:" & _co4 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Ref." & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _rf4 ), "&#8212;", FORMAT ( _rf4, "#,##0" ) ) & "</div></div></div>"
			        & "<div style='flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:0 14px 0 18px;border-top:1px solid #102e4b'><div style='width:60px;height:60px;flex:none;border-radius:14px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='31' height='31' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M6.2 3.4h11.6l3.4 5.4L12 20.8 2.8 8.8z'/><path d='M2.8 8.8h18.4M8.7 3.4l-2.5 5.4L12 20.8l5.8-12-2.5-5.4'/></svg></div><div style='flex:1;min-width:0'><div style='font-size:19px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Dureza</div><div style='font-size:17px;color:#93afc9;margin-top:2px'>mg/L</div></div><div style='width:88px;flex:none;text-align:right;font-size:34px;font-weight:700;color:#ffffff;white-space:nowrap'>" & IF ( ISBLANK ( _v5 ), "&#8212;", FORMAT ( _v5, "#,##0" ) ) & "</div><div style='width:144px;flex:none'><div style='position:relative;height:24px;background:#123855;border-radius:12px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg5, "0" ) & "%;height:100%;background:" & _co5 & ";border-radius:12px'></div><div style='position:absolute;left:62.5%;top:-4px;height:32px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='width:84px;flex:none;text-align:left;line-height:1.22'><div style='font-size:17px;color:#93afc9'>" & "Ref." & "</div><div style='font-size:19px;font-weight:700;color:#dce9f7;white-space:nowrap'>" & IF ( ISBLANK ( _rf5 ), "&#8212;", FORMAT ( _rf5, "#,##0" ) ) & "</div></div></div>"
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><div style='font-family:Segoe UI,sans-serif;height:100vh;width:100%;display:flex;flex-direction:column;gap:5px'><div style='height:62px;flex:none;border-radius:10px;background:linear-gradient(90deg,#1a5a96 0%,#0d3a68 46%,#071f38 100%);border:1px solid #2a6ca8;display:flex;align-items:center;gap:14px;padding:0 18px'><span style='color:#5fb4f5;display:flex'><svg viewBox='0 0 24 24' width='34' height='34' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3c3.4 4 5.5 6.6 5.5 9.3A5.5 5.5 0 0 1 6.5 12.3C6.5 9.6 8.6 7 12 3z'/></svg></span><span style='font-size:27px;font-weight:700;color:#ffffff;letter-spacing:0.8px;white-space:nowrap'>QUALIDADE EEBC</span><span style='margin-left:auto;padding-left:14px;font-size:16px;color:#9dbbd8;font-weight:400;white-space:nowrap'>Qualidade da água de alimentação</span></div><div style='flex:1;min-height:0;display:flex;flex-direction:column;background:#001b2e;border:1px solid #143d5c;border-radius:10px;overflow:hidden'>" & _itens & "</div></div>"
			```
