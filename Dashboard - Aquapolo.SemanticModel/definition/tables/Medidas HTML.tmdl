table 'Medidas HTML'
	lineageTag: af935ac6-adea-4710-8879-f9f7682c9e9d

	measure 'HTML Volume Clientes' = ```
			    -- ===== EDITAR AQUI (Volume Clientes) =====
			    -- Valor: média dos últimos 30 dias com dado. Ref.: meta da dim_indicadores.
			    VAR Ids = { "Volumes | Todos Clientes" }
			    VAR Valor = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, fato_indicadores[ID_Indicador] ) )
			    VAR Ref = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, dim_indicadores[ID_Indicador] ) )
			    VAR Anterior = CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, fato_indicadores[ID_Indicador] ) )
			    VAR VarPeriodo = DIVIDE ( Valor - Anterior, Anterior )    -- variação vs 30 dias anteriores
			    VAR TipoVar = "%"
			    VAR MenorMelhor = FALSE ()
			    VAR FmtValor = "#,##0"
			    VAR UnidadeRef = " m³/d"
			    -- ===== daqui pra baixo não precisa mexer =====
			    VAR Tolerancia = 0.10      -- faixa de "Atenção" (10% além da referência)
			    VAR Atingimento = DIVIDE ( Valor, Ref )
			    VAR Cor =
			        IF (
			            MenorMelhor,
			            SWITCH ( TRUE (), Valor <= Ref, "#43a047", Valor <= Ref * ( 1 + Tolerancia ), "#f9a825", "#e53935" ),
			            SWITCH ( TRUE (), Valor >= Ref, "#43a047", Valor >= Ref * ( 1 - Tolerancia ), "#f9a825", "#e53935" )
			        )
			    VAR Escala = 1.3           -- barra cheia = 130% da referência
			    VAR Largura = MIN ( Atingimento, Escala ) / Escala * 100
			    VAR Marcador = 100 / Escala
			    VAR VariacaoBoa = IF ( MenorMelhor, VarPeriodo < 0, VarPeriodo > 0 )
			    VAR CorVar = IF ( VariacaoBoa, "#2e7d32", "#c62828" )
			    VAR Seta = IF ( VarPeriodo >= 0, "▲", "▼" )
			    VAR TxtVar =
			        IF ( TipoVar = "%", FORMAT ( VarPeriodo, "+0.0%;-0.0%" ), FORMAT ( VarPeriodo, "+0.0;-0.0" ) & " p.p." )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#0b2a5b;padding:2px 6px'>"
			        & "<div style='font-size:40px;font-weight:700;line-height:1'>" & FORMAT ( Valor, FmtValor ) & "</div>"
			        & "<div style='margin-top:10px;font-size:15px;font-weight:600;color:" & CorVar & "'>" & Seta & " " & TxtVar & " <span style='font-size:11px;font-weight:400;color:#4a5b70'>Δ Per.</span>"
			        & "</div>"
			        & "<div style='margin-top:14px'>"
			        & "<div style='position:relative;height:10px;background:#e6edf5;border-radius:5px'>"
			        & "<div style='width:" & FORMAT ( Largura, "0" ) & "%;height:100%;background:" & Cor & ";border-radius:5px'>"
			        & "</div>"
			        & "<div style='position:absolute;left:" & FORMAT ( Marcador, "0" ) & "%;top:-4px;height:18px;border-left:2px dashed #0b2a5b'>"
			        & "</div>"
			        & "</div>"
			        & "</div>"
			        & "<div style='display:flex;justify-content:space-between;margin-top:8px;font-size:11px;color:#4a5b70'>"
			        & "<span>Ref. " & FORMAT ( Ref, FmtValor ) & UnidadeRef & "</span>"
			        & "<b style='font-size:13px;color:#0b2a5b'>" & FORMAT ( Atingimento, "0%" ) & "</b>"
			        & "</div>"
			        & "</div>"
			```
		lineageTag: 353ac2df-47d1-4359-b098-6ce2c50d7dc0

	measure 'HTML Blend' = ```
			    -- ===== EDITAR AQUI (Blend) =====
			    -- A base (Base_PowerBI) ainda não tem o indicador de Blend. Quando tiver, copie o cartão 'HTML Perdas' e troque os Ids.
			    "<div style='font-family:Segoe UI,sans-serif;color:#4a5b70;padding:2px 6px'>"
			        & "<div style='font-size:40px;font-weight:700;line-height:1;color:#90a4ae'>—</div>"
			        & "<div style='margin-top:10px;font-size:12px'>Sem fonte de dados na base</div>"
			        & "</div>"
			```
		lineageTag: cd64ac2e-ad8a-4834-8dc3-3ea030101eb5

	measure 'HTML Perdas' = ```
			    -- ===== EDITAR AQUI (Perdas) =====
			    -- Valor: média dos últimos 30 dias com dado. Ref.: meta da dim_indicadores.
			    VAR Ids = { "Perdas | Perda Total" }
			    VAR Valor = 100 * CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, fato_indicadores[ID_Indicador] ) )
			    VAR Ref = 100 * CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, dim_indicadores[ID_Indicador] ) )
			    VAR Anterior = 100 * CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, fato_indicadores[ID_Indicador] ) )
			    VAR VarPeriodo = Valor - Anterior    -- variação vs 30 dias anteriores, em pontos percentuais
			    VAR TipoVar = "p.p."
			    VAR MenorMelhor = TRUE ()
			    VAR FmtValor = "0.0"
			    VAR UnidadeRef = " %"
			    -- ===== daqui pra baixo não precisa mexer =====
			    VAR Tolerancia = 0.10      -- faixa de "Atenção" (10% além da referência)
			    VAR Atingimento = DIVIDE ( Valor, Ref )
			    VAR Cor =
			        IF (
			            MenorMelhor,
			            SWITCH ( TRUE (), Valor <= Ref, "#43a047", Valor <= Ref * ( 1 + Tolerancia ), "#f9a825", "#e53935" ),
			            SWITCH ( TRUE (), Valor >= Ref, "#43a047", Valor >= Ref * ( 1 - Tolerancia ), "#f9a825", "#e53935" )
			        )
			    VAR Escala = 1.3           -- barra cheia = 130% da referência
			    VAR Largura = MIN ( Atingimento, Escala ) / Escala * 100
			    VAR Marcador = 100 / Escala
			    VAR VariacaoBoa = IF ( MenorMelhor, VarPeriodo < 0, VarPeriodo > 0 )
			    VAR CorVar = IF ( VariacaoBoa, "#2e7d32", "#c62828" )
			    VAR Seta = IF ( VarPeriodo >= 0, "▲", "▼" )
			    VAR TxtVar =
			        IF ( TipoVar = "%", FORMAT ( VarPeriodo, "+0.0%;-0.0%" ), FORMAT ( VarPeriodo, "+0.0;-0.0" ) & " p.p." )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#0b2a5b;padding:2px 6px'>"
			        & "<div style='font-size:40px;font-weight:700;line-height:1'>" & FORMAT ( Valor, FmtValor ) & "</div>"
			        & "<div style='margin-top:10px;font-size:15px;font-weight:600;color:" & CorVar & "'>" & Seta & " " & TxtVar & " <span style='font-size:11px;font-weight:400;color:#4a5b70'>Δ Per.</span>"
			        & "</div>"
			        & "<div style='margin-top:14px'>"
			        & "<div style='position:relative;height:10px;background:#e6edf5;border-radius:5px'>"
			        & "<div style='width:" & FORMAT ( Largura, "0" ) & "%;height:100%;background:" & Cor & ";border-radius:5px'>"
			        & "</div>"
			        & "<div style='position:absolute;left:" & FORMAT ( Marcador, "0" ) & "%;top:-4px;height:18px;border-left:2px dashed #0b2a5b'>"
			        & "</div>"
			        & "</div>"
			        & "</div>"
			        & "<div style='display:flex;justify-content:space-between;margin-top:8px;font-size:11px;color:#4a5b70'>"
			        & "<span>Ref. " & FORMAT ( Ref, FmtValor ) & UnidadeRef & "</span>"
			        & "<b style='font-size:13px;color:#0b2a5b'>" & FORMAT ( Atingimento, "0%" ) & "</b>"
			        & "</div>"
			        & "</div>"
			```
		lineageTag: fd077992-ab74-4a79-8903-bc8770b7f96a

	measure 'HTML Consumo Quimicos' = ```
