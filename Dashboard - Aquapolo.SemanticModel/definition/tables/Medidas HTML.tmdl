			        & "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='2.2'/><path d='M12 9.8c0-3.6.9-6.4 3.4-6.4 2 0 2.8 2.4 1.2 4.3-1.2 1.4-2.9 2.1-4.6 2.1z'/><path d='M14.2 12c3.6 0 6.4.9 6.4 3.4 0 2-2.4 2.8-4.3 1.2-1.4-1.2-2.1-2.9-2.1-4.6z'/><path d='M9.8 12c-3.6 0-6.4-.9-6.4-3.4 0-2 2.4-2.8 4.3-1.2 1.4 1.2 2.1 2.9 2.1 4.6z'/><path d='M12 14.2c0 3.6-.9 6.4-3.4 6.4-2 0-2.8-2.4-1.2-4.3 1.2-1.4 2.9-2.1 4.6-2.1z'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Energia - Biológico</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>kWh/kg NH3 rem</div></div></div><div style='flex:1'></div><div style='display:flex;align-items:flex-end;gap:6px'><div style='font-size:38px;font-weight:700;color:#ffffff;line-height:1;white-space:nowrap'>" & IF ( ISBLANK ( _v4 ), "&#8212;", FORMAT ( _v4, "#,##0.0" ) ) & "</div><div style='margin-left:auto;text-align:right'><div style='font-size:18px;font-weight:700;color:" & IF ( NOT _te4, "#5c7791", IF ( _dl4 < 0, "#4ed15d", "#f4353f" ) ) & ";white-space:nowrap'>" & IF ( _te4, IF ( _dl4 >= 0, "&#9650;", "&#9660;" ), "" ) & " " & IF ( _te4, FORMAT ( _dl4, "+0.0%;-0.0%" ), "&#8212;" ) & "</div><div style='font-size:15px;color:#93afc9;margin-top:2px'>&#916; Per.</div></div></div><div style='margin-top:12px'><div style='position:relative;height:20px;background:#123855;border-radius:10px;border:1