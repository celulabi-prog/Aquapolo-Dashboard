			        & "<div style='margin-top:2px;font-size:12px;font-weight:600;color:" & CorVar & "'>" & Seta & " " & TxtVar & " <span style='font-size:11px;font-weight:400;color:#4a5b70'>Δ Per.</span>"
			        & "</div>"
			        & "<div style='margin-top:6px'>"
			        & "<div style='position:relative;height:10px;background:#e6edf5;border-radius:5px'>"
