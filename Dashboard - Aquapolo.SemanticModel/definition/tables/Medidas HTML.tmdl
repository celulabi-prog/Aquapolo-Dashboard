	/// Painel CONSUMO DE QUÍMICOS E ENERGIA da Visão Geral: Químicos, Energia, Energia OR, Energia - Biológico, Coagulante. Valor = média dos últimos 30 dias com dado ([Valor 30d]); referência = Target_Min/Target_Max da dim_indicadores. Verde dentro da meta, amarelo até 10% fora, vermelho além disso. A barra enche até 160% da referência e o tracejado marca os 100%.
	measure 'HTML Painel Consumo' = ```
			VAR _ids1 = { "Químicos | Consumo Unitário - Químicos" }
			VAR _v1 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, fato_indicadores[ID_Indicador] ) )
			VAR _mi1 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _ma1 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, dim_indicadores[ID_Indicador] ) )
			VAR _rf1 = _ma1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 <= _rf1, "#4ed15d", _v1 <= _rf1 * 1.1, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an1 = CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids1, fato_indicadores[ID_Indicador] ) )
			VAR _te1 = NOT ISBLANK ( _v1 ) && NOT ISBLANK ( _an1 ) && _an1 <> 0
			VAR _dl1 = DIVIDE ( _v1 - _an1, _an1 )
			VAR _ids2 = { "Energia | Consumo Unitário - Energia" }
			VAR _v2 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, fato_indicadores[ID_Indicador] ) )
			VAR _mi2 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, dim_indicadores[ID_Indicador] ) )
			VAR _ma2 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, dim_indicadores[ID_Indicador] ) )
			VAR _rf2 = _ma2
			VAR _co2 = SWITCH ( TRUE (), ISBLANK ( _v2 ) || ISBLANK ( _rf2 ), "#5c7791", _v2 <= _rf2, "#4ed15d", _v2 <= _rf2 * 1.1, "#feb825", "#f4353f" )
			VAR _lg2 = MIN ( MAX ( DIVIDE ( _v2, _rf2 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an2 = CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids2, fato_indicadores[ID_Indicador] ) )
			VAR _te2 = NOT ISBLANK ( _v2 ) && NOT ISBLANK ( _an2 ) && _an2 <> 0
			VAR _dl2 = DIVIDE ( _v2 - _an2, _an2 )
			VAR _ids3 = { "Energia | Consumo OR" }
			VAR _v3 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, fato_indicadores[ID_Indicador] ) )
			VAR _mi3 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _ma3 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, dim_indicadores[ID_Indicador] ) )
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an3 = CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids3, fato_indicadores[ID_Indicador] ) )
			VAR _te3 = NOT ISBLANK ( _v3 ) && NOT ISBLANK ( _an3 ) && _an3 <> 0
			VAR _dl3 = DIVIDE ( _v3 - _an3, _an3 )
			VAR _ids4 = { "Energia | Consumo SOP Biológico/ Amônia Removida" }
			VAR _v4 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, fato_indicadores[ID_Indicador] ) )
			VAR _mi4 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, dim_indicadores[ID_Indicador] ) )
			VAR _ma4 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, dim_indicadores[ID_Indicador] ) )
			VAR _rf4 = _ma4
			VAR _co4 = SWITCH ( TRUE (), ISBLANK ( _v4 ) || ISBLANK ( _rf4 ), "#5c7791", _v4 <= _rf4, "#4ed15d", _v4 <= _rf4 * 1.1, "#feb825", "#f4353f" )
			VAR _lg4 = MIN ( MAX ( DIVIDE ( _v4, _rf4 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an4 = CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids4, fato_indicadores[ID_Indicador] ) )
			VAR _te4 = NOT ISBLANK ( _v4 ) && NOT ISBLANK ( _an4 ) && _an4 <> 0
			VAR _dl4 = DIVIDE ( _v4 - _an4, _an4 )
			VAR _ids5 = { "Químicos | PAC/ P rem" }
			VAR _v5 = CALCULATE ( [Valor 30d], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, fato_indicadores[ID_Indicador] ) )
			VAR _mi5 = CALCULATE ( MAX ( dim_indicadores[Target_Min] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, dim_indicadores[ID_Indicador] ) )
			VAR _ma5 = CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, dim_indicadores[ID_Indicador] ) )
			VAR _rf5 = _ma5
			VAR _co5 = SWITCH ( TRUE (), ISBLANK ( _v5 ) || ISBLANK ( _rf5 ), "#5c7791", _v5 <= _rf5, "#4ed15d", _v5 <= _rf5 * 1.1, "#feb825", "#f4353f" )
			VAR _lg5 = MIN ( MAX ( DIVIDE ( _v5, _rf5 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _an5 = CALCULATE ( [Valor 30d Anterior], REMOVEFILTERS ( dim_indicadores ), TREATAS ( _ids5, fato_indicadores[ID_Indicador] ) )
			VAR _te5 = NOT ISBLANK ( _v5 ) && NOT ISBLANK ( _an5 ) && _an5 <> 0
			VAR _dl5 = DIVIDE ( _v5 - _an5, _an5 )
			VAR _itens =
			    "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M9.4 2.8h5.2M10.3 2.8v6.1L5 18.6a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5.3-9.7V2.8'/><path d='M7.2 15.4h9.6'/><circle cx='10' cy='18' r='0.9' fill='currentColor' stroke='none'/><circle cx='13.4' cy='18.6' r='0.9' fill='currentColor' stroke='none'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Químicos</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>kg/m³</div></div></div><div style='flex:1'></div><div style='display:flex;align-items:flex-end;gap:6px'><div style='font-size:38px;font-weight:700;color:#ffffff;line-height:1;white-space:nowrap'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0.00" ) ) & "</div><div style='margin-left:auto;text-align:right'><div style='font-size:18px;font-weight:700;color:" & IF ( NOT _te1, "#5c7791", IF ( _dl1 < 0, "#4ed15d", "#f4353f" ) ) & ";white-space:nowrap'>" & IF ( _te1, IF ( _dl1 >= 0, "&#9650;", "&#9660;" ), "" ) & " " & IF ( _te1, FORMAT ( _dl1, "+0.0%;-0.0%" ), "&#8212;" ) & "</div><div style='font-size:15px;color:#93afc9;margin-top:2px'>&#916; Per.</div></div></div><div style='margin-top:12px'><div style='position:relative;height:20px;background:#123855;border-radius:10px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg1, "0" ) & "%;height:100%;background:" & _co1 & ";border-radius:10px'></div><div style='position:absolute;left:62.5%;top:-4px;height:28px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='margin-top:9px;display:flex;align-items:baseline;font-size:16px;color:#93afc9'><span style='white-space:nowrap'>" & IF ( ISBLANK ( _rf1 ), "Ref. &#8212;", "Ref. " & FORMAT ( _rf1, "#,##0.00" ) & " kg/m³" ) & "</span><b style='margin-left:auto;padding-left:8px;font-size:19px;color:#ffffff'>" & IF ( ISBLANK ( _rf1 ) || ISBLANK ( _v1 ), "&#8212;", FORMAT ( DIVIDE ( _v1, _rf1 ), "0%" ) ) & "</b></div></div>"
			        & "<div style='flex:1;min-width:0;display:flex;flex-direction:column;background:#0b2740;border:1px solid #1b4a71;border-radius:10px;padding:13px 14px 12px 14px'><div style='display:flex;align-items:center;gap:11px'><div style='width:44px;height:44px;flex:none;border-radius:11px;background:#0f3c66;border:1px solid #1c5285;color:#dce9f7;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 24 24' width='23' height='23' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M13.4 2.5L4.8 13.4h5.6l-.8 8.1 8.6-10.9h-5.6z' fill='currentColor' stroke='none'/></svg></div><div style='min-width:0'><div style='font-size:17px;font-weight:600;color:#ffffff;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Energia</div><div style='font-size:16px;color:#93afc9;margin-top:1px;white-space:nowrap'>kWh/m³</div></div></div><div style='flex:1'></div><div style='display:flex;align-items:flex-end;gap:6px'><div style='font-size:38px;font-weight:700;color:#ffffff;line-height:1;white-space:nowrap'>" & IF ( ISBLANK ( _v2 ), "&#8212;", FORMAT ( _v2, "#,##0.00" ) ) & "</div><div style='margin-left:auto;text-align:right'><div style='font-size:18px;font-weight:700;color:" & IF ( NOT _te2, "#5c7791", IF ( _dl2 < 0, "#4ed15d", "#f4353f" ) ) & ";white-space:nowrap'>" & IF ( _te2, IF ( _dl2 >= 0, "&#9650;", "&#9660;" ), "" ) & " " & IF ( _te2, FORMAT ( _dl2, "+0.0%;-0.0%" ), "&#8212;" ) & "</div><div style='font-size:15px;color:#93afc9;margin-top:2px'>&#916; Per.</div></div></div><div style='margin-top:12px'><div style='position:relative;height:20px;background:#123855;border-radius:10px;border:1px solid #16375a'><div style='width:" & FORMAT ( _lg2, "0" ) & "%;height:100%;background:" & _co2 & ";border-radius:10px'></div><div style='position:absolute;left:62.5%;top:-4px;height:28px;border-left:2px dashed rgba(255,255,255,0.92)'></div></div></div><div style='margin-top:9px;display:flex;align-items:baseline;font-size:16px;color:#93afc9'><span style='white-space:nowrap'>" & IF ( ISBLANK ( _rf2 ), "Ref. &#8212;", "Ref. " & FORMAT ( _rf2, "#,##0.00" ) & " kWh/m³" ) & "</span><b style='margin-left:auto;padding-left:8px;font-size:19px;color:#ffffff'>" & IF ( ISBLANK ( _rf2 ) || ISBLANK ( _v2 ), "&#8212;", FORMAT ( DIVIDE ( _v2, _rf2 ), "0%" ) ) & "</b></div></div>"
