			    VAR Ref = 98.0665 * CALCULATE ( MAX ( dim_indicadores[Target_Max] ), REMOVEFILTERS ( dim_indicadores ), TREATAS ( Ids, dim_indicadores[ID_Indicador] ) )
			    VAR MenorMelhor = TRUE ()
