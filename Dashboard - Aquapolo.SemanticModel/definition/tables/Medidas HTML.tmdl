	/// Blend: média ponderada pelo volume de clientes do dia (soma do consumo dividida pelo volume somado) dos últimos 30 dias, contados até a última leitura do indicador, coluna 'Blend %' da planilha Dados BI. Zero e datas futuras ficam de fora: na planilha, zero é célula vazia na origem. Sai multiplicado por 100 (fração para %).
	measure 'Blend 30d' =
			VAR _fim =
			    CALCULATE (
			        MAX ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Blend %",
			        'Dados BI'[Valor] <> 0,
			        KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () )
			    )
			VAR _dias =
			    CALCULATETABLE (
			        VALUES ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Blend %",
			        'Dados BI'[Valor] <> 0,
			        'Dados BI'[Data] > _fim - 30,
			        'Dados BI'[Data] <= _fim
			    )
			VAR _t =
			    ADDCOLUMNS (
			        _dias,
			        "@v", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Blend %" ),
			        "@p", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Clientes (L/s)" )
			    )
			RETURN
			    100.0 * DIVIDE ( SUMX ( _t, [@v] * [@p] ), SUMX ( _t, [@p] ) )
		formatString: #,0.0
		displayFolder: Painel Operacional\Indicadores
