			    CALCULATE (
			        MEDIAN ( 'Dados BI'[Valor] ),
			        'Dados BI'[Indicador] = "Energia - Biológico (KWh/kg NH3 rem)",
			        'Dados BI'[Valor] > 0,
			        'Dados BI'[Data] > _fim - 2 * _tamanho,
			        'Dados BI'[Data] <= _fim - _tamanho
