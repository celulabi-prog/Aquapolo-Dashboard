	/// Blend: média ponderada pelo volume de clientes do dia (soma do consumo dividida pelo volume somado) do período marcado no seletor Período (30 dias se nada estiver marcado), contado até a última leitura do indicador; com Datas exatas, do intervalo do controle de datas, coluna 'Blend %' da planilha Dados BI. Zero e datas futuras ficam de fora: na planilha, zero é célula vazia na origem. Sai multiplicado por 100 (fração para %).
	measure 'Blend Período' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _ultima =
			    CALCULATE (
			        MAX ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Blend %",
			        'Dados BI'[Valor] <> 0,
			        KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () )
			    )
			VAR _fim = IF ( _exatas, _ate, _ultima )
			VAR _dias =
			    CALCULATETABLE (
			        VALUES ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Blend %",
			        'Dados BI'[Valor] <> 0,
			        'Dados BI'[Data] > _fim - _tamanho,
			        'Dados BI'[Data] <= _fim
			    )
			VAR _t =
			    ADDCOLUMNS (
			        _dias,
			        "@v", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Blend %" ),
			        "@p", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Clientes (L/s)" )
			    )
			RETURN
			    100.0 * DIVIDE ( SUMX ( _t, [@v] * [@p] ), SUMX ( _t, [@p] ) )
			```
		formatString: #,0.0
		displayFolder: Painel Operacional\Indicadores
		lineageTag: e70dff5c-3faf-5ec1-95ed-26113503d9aa

