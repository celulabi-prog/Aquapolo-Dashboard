	/// Químicos: média ponderada pelo volume de clientes do dia (soma do consumo dividida pelo volume somado) dos últimos 30 dias, contados até a última leitura do indicador, coluna 'Químicos (Kg/m³)' da planilha Dados BI. Zero e datas futuras ficam de fora: na planilha, zero é célula vazia na origem.
	measure 'Químicos 30d' =
			VAR _fim =
			    CALCULATE (
			        MAX ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Químicos (Kg/m³)",
			        'Dados BI'[Valor] <> 0,
			        KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () )
			    )
			VAR _dias =
			    CALCULATETABLE (
			        VALUES ( 'Dados BI'[Data] ),
			        'Dados BI'[Indicador] = "Químicos (Kg/m³)",
			        'Dados BI'[Valor] <> 0,
			        'Dados BI'[Data] > _fim - 30,
			        'Dados BI'[Data] <= _fim
			    )
			VAR _t =
			    ADDCOLUMNS (
			        _dias,
			        "@v", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Químicos (Kg/m³)" ),
			        "@p", CALCULATE ( AVERAGE ( 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Clientes (L/s)" )
			    )
			RETURN
			    DIVIDE ( SUMX ( _t, [@v] * [@p] ), SUMX ( _t, [@p] ) )
		formatString: #,0.00
		displayFolder: Painel Operacional\Indicadores
		lineageTag: dc22462e-6020-55ee-98e0-015fcb2c52d3

	/// Químicos: média ponderada pelo volume de clientes do dia (soma do consumo dividida pelo volume somado) dos 30 dias anteriores aos de [Químicos 30d], coluna 'Químicos (Kg/m³)' da planilha Dados BI. Zero e datas futuras ficam de fora: na planilha, zero é célula vazia na origem.
