table 'Medidas HTML v2'
	lineageTag: c0dc8181-096b-5c26-8ad2-e76e3819a9bf

	/// Coluna EEBC da Visão Geral v2: o nó do trem e o bloco com Retrolavagens, DQO, NH3, Condutividade, Dureza. Valor = as medidas '... Período' da tabela Medidas HTML (planilha Dados BI); meta = a de ferramentas/preview/indicadores_op.py. A linha fora da meta ou em atenção cresce no próprio lugar, com o desvio em palavras e a tendência do período; a ordem nunca muda. Ao passar o mouse, abre a aba com o período e a meta.
	measure 'HTML v2 EEBC' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _passo = ROUNDUP ( DIVIDE ( _tamanho, 90 ), 0 )
			VAR _nb = MAX ( INT ( DIVIDE ( _tamanho - 1, _passo ) ), 1 )
			VAR _v1 = [Retrolavagens Período]
			VAR _mi1 = BLANK ()
			VAR _ma1 = 12.0
			VAR _rf1 = _ma1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 <= _rf1, "#4ed15d", _v1 <= _rf1 * 1.1, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si1 = SWITCH ( _co1, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f1 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Nº retrolayagens disco ( ciclos/d)", KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s1 = SWITCH ( TRUE (), ISBLANK ( _v1 ), "n", _co1 = "#4ed15d", "d", _co1 = "#feb825", "a", _co1 = "#f4353f", "f", "s" )
			VAR _cr1 = SWITCH ( _s1, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v2 = [DQO Período]
			VAR _mi2 = BLANK ()
			VAR _ma2 = 100.0
			VAR _rf2 = _ma2
			VAR _co2 = SWITCH ( TRUE (), ISBLANK ( _v2 ) || ISBLANK ( _rf2 ), "#5c7791", _v2 <= _rf2, "#4ed15d", _v2 <= _rf2 * 1.1, "#feb825", "#f4353f" )
			VAR _lg2 = MIN ( MAX ( DIVIDE ( _v2, _rf2 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si2 = SWITCH ( _co2, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f2 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "DQO (mg/L)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s2 = SWITCH ( TRUE (), ISBLANK ( _v2 ), "n", _co2 = "#4ed15d", "d", _co2 = "#feb825", "a", _co2 = "#f4353f", "f", "s" )
			VAR _cr2 = SWITCH ( _s2, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v3 = [NH3 Período]
			VAR _mi3 = BLANK ()
			VAR _ma3 = 20.0
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si3 = SWITCH ( _co3, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f3 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "NH3 (mg/L)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s3 = SWITCH ( TRUE (), ISBLANK ( _v3 ), "n", _co3 = "#4ed15d", "d", _co3 = "#feb825", "a", _co3 = "#f4353f", "f", "s" )
			VAR _cr3 = SWITCH ( _s3, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v4 = [Condutividade Período]
			VAR _mi4 = BLANK ()
			VAR _ma4 = 650.0
			VAR _rf4 = _ma4
			VAR _co4 = SWITCH ( TRUE (), ISBLANK ( _v4 ) || ISBLANK ( _rf4 ), "#5c7791", _v4 <= _rf4, "#4ed15d", _v4 <= _rf4 * 1.1, "#feb825", "#f4353f" )
			VAR _lg4 = MIN ( MAX ( DIVIDE ( _v4, _rf4 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si4 = SWITCH ( _co4, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f4 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Condutividade", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s4 = SWITCH ( TRUE (), ISBLANK ( _v4 ), "n", _co4 = "#4ed15d", "d", _co4 = "#feb825", "a", _co4 = "#f4353f", "f", "s" )
			VAR _cr4 = SWITCH ( _s4, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v5 = [Dureza Período]
			VAR _mi5 = BLANK ()
			VAR _ma5 = 100.0
			VAR _rf5 = _ma5
			VAR _co5 = SWITCH ( TRUE (), ISBLANK ( _v5 ) || ISBLANK ( _rf5 ), "#5c7791", _v5 <= _rf5, "#4ed15d", _v5 <= _rf5 * 1.1, "#feb825", "#f4353f" )
			VAR _lg5 = MIN ( MAX ( DIVIDE ( _v5, _rf5 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si5 = SWITCH ( _co5, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f5 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Dureza (mg/L)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s5 = SWITCH ( TRUE (), ISBLANK ( _v5 ), "n", _co5 = "#4ed15d", "d", _co5 = "#feb825", "a", _co5 = "#f4353f", "f", "s" )
			VAR _cr5 = SWITCH ( _s5, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _nf = 0 + IF ( _s1 = "f", 1 ) + IF ( _s2 = "f", 1 ) + IF ( _s3 = "f", 1 ) + IF ( _s4 = "f", 1 ) + IF ( _s5 = "f", 1 )
			VAR _na = 0 + IF ( _s1 = "a", 1 ) + IF ( _s2 = "a", 1 ) + IF ( _s3 = "a", 1 ) + IF ( _s4 = "a", 1 ) + IF ( _s5 = "a", 1 )
			VAR _nd = 0 + IF ( _s1 = "d", 1 ) + IF ( _s2 = "d", 1 ) + IF ( _s3 = "d", 1 ) + IF ( _s4 = "d", 1 ) + IF ( _s5 = "d", 1 )
			VAR _L1 = SWITCH ( TRUE (), NOT ISBLANK ( _ma1 ) && _v1 > _ma1, _ma1, NOT ISBLANK ( _mi1 ) && _v1 < _mi1, _mi1 )
			VAR _ac1 = _v1 > _L1
			VAR _r1 = DIVIDE ( _v1, _L1 )
			VAR _ex1 = ( _ac1 && _r1 >= 2 ) || ( NOT _ac1 && _r1 <= 0.5 )
			VAR _pc1 = ROUND ( ABS ( _r1 - 1 ) * 100, 0 )
			VAR _q1 = IF ( _ac1 && _r1 >= 2, FORMAT ( ROUND ( _r1, 1 ), "#,##0.0" ) & " vezes", IF ( _pc1 < 1, "menos de 1%", FORMAT ( _pc1, "0" ) & "%" ) & IF ( _ac1, " acima", " abaixo" ) )
			VAR _rt1 = SWITCH ( TRUE (), _ac1 && _r1 >= 2, "o teto", _ac1, "do teto", "do piso" )
			VAR _fc1 = IF ( _ex1 && _s1 = "f", "margin:0 -6px;padding:0 6px;background:#ff5c63;border-radius:2px;color:#1c0508", "color:" & _cr1 )
			VAR _br1 = 4 + 0.95 * DIVIDE ( _v1, _rf1 ) * 100
			VAR _x1 = 4 + ( MIN ( MAX ( _br1, 4 ), 156 ) - 4 ) * 1.0
			VAR _md1 = SWITCH ( TRUE (), _s1 = "s" || _s1 = "n", "<div style='width:160px;height:32px;flex:none;display:flex;align-items:center;gap:8px'><span style='width:14px;height:14px;flex:none;border-radius:50%;border:2px solid #a8bfd6'></span><span style='font-size:16px;color:#a8bfd6'>" & IF ( _s1 = "n", "sem leitura", "sem meta" ) & "</span></div>", _s1 = "d", "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='16' width='152' height='6' fill='#143454'/><rect x='4.0' y='16' width='95.0' height='6' fill='#2b7d62'/><path d='M99.0 12v14' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x1 - 5, "0.0", "en-US" ) & " 3h10l-5 8z' fill='#f3f8fd'/><path d='M" & FORMAT ( _x1, "0.0", "en-US" ) & " 10v16' stroke='#f3f8fd' stroke-width='2.5'/></svg>", _br1 > 156, "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='13' width='140.0' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='99.0' y='10' width='46.0' height='16' fill='" & _cr1 & "'/><path d='M113.0 29l5-22M122.0 29l5-22' stroke='" & IF ( _s1 = "a", "#1c2424", "#261a2c" ) & "' stroke-width='3.5'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M144.0 4l14 14-14 14z' fill='" & _cr1 & "'/></svg>", _br1 < 4, "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='16' y='13' width='140.0' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='15' y='10' width='84.0' height='16' fill='" & _cr1 & "'/><path d='M85.0 29l-5-22M76.0 29l-5-22' stroke='" & IF ( _s1 = "a", "#1c2424", "#261a2c" ) & "' stroke-width='3.5'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M16 4l-14 14 14 14z' fill='" & _cr1 & "'/></svg>", _s1 = "a", "<svg width='160' height='26' viewBox='0 0 160 26' style='display:block;flex:none;overflow:visible'><rect x='4' y='11' width='152' height='8' fill='#143454'/><rect x='4.0' y='11' width='95.0' height='8' fill='#2b7d62'/><rect x='99.0' y='11' width='" & FORMAT ( _x1 - 99.0, "0.0", "en-US" ) & "' height='8' fill='#ffd257'/><path d='M99.0 7v16' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x1 - 6, "0.0", "en-US" ) & " 0h12l-6 9z' fill='#ffd257'/><path d='M" & FORMAT ( _x1, "0.0", "en-US" ) & " 7v16' stroke='#ffd257' stroke-width='3'/></svg>", "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='13' width='152' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='99.0' y='13' width='" & FORMAT ( _x1 - 99.0, "0.0", "en-US" ) & "' height='10' fill='#ff5c63'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x1 - 7, "0.0", "en-US" ) & " 0h14l-7 11z' fill='#ff5c63'/><path d='M" & FORMAT ( _x1, "0.0", "en-US" ) & " 9v19' stroke='#ff5c63' stroke-width='3.5'/></svg>" )
			VAR _d01 = _f1 - _tamanho + 1
			VAR _t1 = CALCULATETABLE ( SELECTCOLUMNS ( 'Dados BI', "@b", INT ( DIVIDE ( INT ( 'Dados BI'[Data] - _d01 ), _passo ) ), "@v", 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Nº retrolayagens disco ( ciclos/d)", 'Dados BI'[Data] >= _d01, 'Dados BI'[Data] <= _f1 )
			VAR _g1 = GROUPBY ( _t1, [@b], "@m", AVERAGEX ( CURRENTGROUP (), [@v] ) )
			VAR _hi1 = MIN ( MAX ( MAXX ( _g1, [@m] ), 12.0 ), 3 * MAX ( _v1, 12.0 ) )
			VAR _lo1 = MIN ( MINX ( _g1, [@m] ), 12.0 )
			VAR _am1 = IF ( _hi1 > _lo1, _hi1 - _lo1, 1 )
			VAR _pts1 = CONCATENATEX ( _g1, FORMAT ( 4 + 152 * DIVIDE ( [@b], _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( [@m], _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ), " ", [@b], ASC )
			VAR _mg1 = IF ( COUNTROWS ( _g1 ) < 2, "", IF ( _s1 = "a", "<svg viewBox='0 0 160 60' preserveAspectRatio='none' style='display:block;flex:1 1 0;min-height:0;max-height:56px;width:160px'><rect x='0' y='" & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma1, _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & "' width='160' height='" & FORMAT ( 60 - ( 56 - 52 * DIVIDE ( MIN ( _ma1, _hi1 ) - _lo1, _am1 ) ), "0.0", "en-US" ) & "' fill='rgba(87,214,141,0.20)'/><polygon points='" & FORMAT ( 4 + 152 * DIVIDE ( MINX ( _g1, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L1, _rf1 ), _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & " " & _pts1 & " " & FORMAT ( 4 + 152 * DIVIDE ( MAXX ( _g1, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L1, _rf1 ), _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & "' fill='rgba(255,210,87,0.28)'/><path d='" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma1, _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & "H160" & "' stroke='#57d68d' stroke-width='1.5' stroke-dasharray='5 4' vector-effect='non-scaling-stroke'/><polyline points='" & _pts1 & "' fill='none' stroke='#ffd257' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>", "<svg viewBox='0 0 160 60' preserveAspectRatio='none' style='display:block;flex:1 1 0;min-height:0;max-height:56px;width:160px'><rect x='0' y='" & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma1, _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & "' width='160' height='" & FORMAT ( 60 - ( 56 - 52 * DIVIDE ( MIN ( _ma1, _hi1 ) - _lo1, _am1 ) ), "0.0", "en-US" ) & "' fill='rgba(87,214,141,0.20)'/><polygon points='" & FORMAT ( 4 + 152 * DIVIDE ( MINX ( _g1, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L1, _rf1 ), _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & " " & _pts1 & " " & FORMAT ( 4 + 152 * DIVIDE ( MAXX ( _g1, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L1, _rf1 ), _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & "' fill='rgba(255,92,99,0.28)'/><path d='" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma1, _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & "H160" & "' stroke='#57d68d' stroke-width='1.5' stroke-dasharray='5 4' vector-effect='non-scaling-stroke'/><polyline points='" & _pts1 & "' fill='none' stroke='#ff5c63' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>" ) )
			VAR _dc1 = "<div class='dc' style='position:absolute;left:12px;margin:3px 0;top:100%;z-index:9;pointer-events:none;padding:11px 18px 13px 18px;background:#04182a;border:1px solid #2f6690;border-radius:6px;box-shadow:0 8px 22px rgba(0,0,0,0.6);font-weight:400;line-height:1.3;text-align:left;white-space:nowrap'><div style='display:flex;align-items:baseline;gap:9px'><b style='font-size:22px;color:#f3f8fd'>Retrolavagens</b><span style='font-size:18px;color:#a8bfd6'>ciclos</span><b style='margin-left:auto;padding-left:28px;font-size:20px;color:" & _cr1 & "'>" & _si1 & "</b></div><div style='display:flex;gap:36px;margin-top:7px'><div><div style='font-size:16px;color:#a8bfd6'>Período exibido</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>" & IF ( ISBLANK ( _f1 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f1, "dd/mm" ), FORMAT ( _f1 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f1, "dd/mm" ) ) ) & "</div></div><div><div style='font-size:16px;color:#a8bfd6'>Meta</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>&#8804; 12</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _rf1 ) || ISBLANK ( _v1 ), "&#8212;", FORMAT ( DIVIDE ( _v1, _rf1 ), "0%" ) ) & " da meta</div></div></div></div>"
			VAR _h1 = SWITCH ( _s1, "f", "<div class='ind' style='flex:2 1 0;min-height:88px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;grid-template-rows:auto auto;align-content:center;border-left:6px solid #ff5c63;background:rgba(255,92,99,0.13)'><div style='grid-row:1;grid-column:1 / 3;font-size:22px;font-weight:700;line-height:24px;white-space:nowrap'>Retrolavagens</div><div style='grid-row:1 / 3;grid-column:3;align-self:stretch;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:4px;padding:5px 0'>" & _mg1 & "" & _md1 & "</div><div style='grid-row:2;grid-column:1;display:flex;flex-direction:column;align-items:flex-start;white-space:nowrap'><div style='font-size:16px;line-height:20px;color:#a8bfd6'>ciclos &#183; &#8804; 12</div><div style='font-size:18px;font-weight:700;line-height:20px;" & _fc1 & "'><div>" & _q1 & "</div><div>" & _rt1 & "</div></div></div><div style='grid-row:2;grid-column:2;font-size:52px;font-weight:700;line-height:56px;letter-spacing:-1px;text-align:right;color:#ff5c63'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0" ) ) & "</div>" & _dc1 & "</div>", "a", "<div class='ind' style='flex:1.5 1 0;min-height:86px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;grid-template-rows:auto auto;align-content:center;border-left:6px solid #ffd257;background:rgba(255,210,87,0.08)'><div style='grid-row:1;grid-column:1 / 3;font-size:20px;font-weight:700;line-height:24px;white-space:nowrap'>Retrolavagens</div><div style='grid-row:1 / 3;grid-column:3;align-self:stretch;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:3px;padding:5px 0'>" & _mg1 & "" & _md1 & "</div><div style='grid-row:2;grid-column:1;display:flex;flex-direction:column;align-items:flex-start;white-space:nowrap'><div style='font-size:16px;line-height:20px;color:#a8bfd6'>ciclos &#183; &#8804; 12</div><div style='font-size:16px;font-weight:700;line-height:18px;" & _fc1 & "'><div>" & _q1 & "</div><div>" & _rt1 & "</div></div></div><div style='grid-row:2;grid-column:2;font-size:44px;font-weight:700;line-height:48px;text-align:right;color:#ffd257'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0" ) ) & "</div>" & _dc1 & "</div>", "<div class='ind' style='flex:1 1 0;min-height:50px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;border-left:6px solid transparent'><div style='white-space:nowrap'><div style='font-size:19px;font-weight:600;line-height:24px'>Retrolavagens</div><div style='font-size:16px;line-height:20px;color:#a8bfd6'>ciclos &#183; &#8804; 12</div></div><div style='font-size:34px;font-weight:700;line-height:38px;text-align:right'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0" ) ) & "</div>" & _md1 & "" & _dc1 & "</div>" )
			VAR _L2 = SWITCH ( TRUE (), NOT ISBLANK ( _ma2 ) && _v2 > _ma2, _ma2, NOT ISBLANK ( _mi2 ) && _v2 < _mi2, _mi2 )
			VAR _ac2 = _v2 > _L2
			VAR _r2 = DIVIDE ( _v2, _L2 )
			VAR _ex2 = ( _ac2 && _r2 >= 2 ) || ( NOT _ac2 && _r2 <= 0.5 )
			VAR _pc2 = ROUND ( ABS ( _r2 - 1 ) * 100, 0 )
			VAR _q2 = IF ( _ac2 && _r2 >= 2, FORMAT ( ROUND ( _r2, 1 ), "#,##0.0" ) & " vezes", IF ( _pc2 < 1, "menos de 1%", FORMAT ( _pc2, "0" ) & "%" ) & IF ( _ac2, " acima", " abaixo" ) )
			VAR _rt2 = SWITCH ( TRUE (), _ac2 && _r2 >= 2, "o teto", _ac2, "do teto", "do piso" )
			VAR _fc2 = IF ( _ex2 && _s2 = "f", "margin:0 -6px;padding:0 6px;background:#ff5c63;border-radius:2px;color:#1c0508", "color:" & _cr2 )
			VAR _br2 = 4 + 0.95 * DIVIDE ( _v2, _rf2 ) * 100
			VAR _x2 = 4 + ( MIN ( MAX ( _br2, 4 ), 156 ) - 4 ) * 1.0
