tyle='font-size:16px;line-height:20px;color:#a8bfd6'>bar &#183; &#8804; 3,5</div><div style='font-size:16px;font-weight:700;line-height:18px;" & _fc4 & "'><div>" & _q4 & "</div><div>" & _rt4 & "</div></div></div><div style='grid-row:2;grid-column:2;font-size:44px;font-weight:700;line-height:48px;text-align:right;color:#ffd257'>" & IF ( ISBLANK ( _v4 ), "&#8212;", FORMAT ( _v4, "#,##0.0" ) ) & "</div>" & _dc4 & "</div>", "<div class='ind' style='flex:1 1 0;min-height:50px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;border-left:6px solid transparent'><div style='white-space:nowrap'><div style='font-size:19px;font-weight:600;line-height:24px'>dP Skid 3</div><div style='font-size:16px;line-height:20px;color:#a8bfd6'>bar &#183; &#8804; 3,5</div></div><div style='font-size:34px;font-weight:700;line-height:38px;text-align:right'>" & IF ( ISBLANK ( _v4 ), "&#8212;", FORMAT ( _v4, "#,##0.0" ) ) & "</div>" & _md4 & "" & _dc4 & "</div>" )
			VAR _vc = IF ( _nf > 0, "<span style='font-size:28px;font-weight:700;color:#ff5c63'>" & _nf & " fora da meta</span>", "" ) & IF ( _na > 0, IF ( _nf > 0, "<span style='font-size:24px;font-weight:700;color:#ffd257'>" & _na & " em atenção</span>", "<span style='font-size:28px;font-weight:700;color:#ffd257'>" & _na & " em atenção</span>" ), "" )
			VAR _ver = IF ( _nf + _na = 0, "<div style='display:flex;align-items:baseline;gap:10px;white-space:nowrap;line-height:36px'><span style='font-size:28px;font-weight:700'>" & _nd & " de 4</span><span style='font-size:24px;color:#d3e1ef'>dentro da meta</span></div>", "<div style='display:flex;align-items:baseline;gap:14px;white-space:nowrap;line-height:36px'>" & _vc & "</div>" )
			VAR _ft = SWITCH ( _s1, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s2, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s3, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s4, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" )
			VAR _bl = [Blend Período]
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><style>.dc{display:none}.ind{cursor:help}.ind:hover{box-shadow:inset 0 0 0 1px #2f79ad}.ind:hover>.dc{display:block}</style><div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums;color:#f3f8fd;height:100vh;width:100%;overflow:hidden;display:flex;flex-direction:column'><div style='position:relative;height:88px;flex:none;display:flex;flex-direction:column'><div style='position:absolute;left:22px;right:22px;top:7px;height:44px;border:4px solid #3aa7f2;border-bottom:0;border-radius:8px 8px 0 0'></div><div style='position:absolute;left:50%;top:0;transform:translateX(-50%);height:20px;display:flex;align-items:center;gap:7px;padding:0 12px;background:#000f21;white-space:nowrap;line-height:20px'><span style='font-size:17px;color:#a8bfd6'>Blend</span><span style='font-size:20px;font-weight:700'>" & IF ( ISBLANK ( _bl ), "&#8212;", FORMAT ( _bl, "#,##0.0" ) ) & "%</span></div><div style='height:22px;flex:none'></div><div style='position:relative;height:52px;flex:none;display:flex;align-items:center'><div style='width:28px;flex:none;height:6px;background:#3aa7f2'></div><div style='flex:1;height:4px;background:#3aa7f2'></div><svg width='10' height='14' viewBox='0 0 10 14' style='flex:none'><path d='M0 0l10 7-10 7z' fill='#3aa7f2'/></svg><div style='height:52px;flex:none;display:flex;align-items:center;gap:12px;padding:0 18px 0 12px;border:2px solid " & IF ( _nf > 0, "#ff5c63", "#3aa7f2" ) & ";border-radius:3px;background:" & IF ( _nf > 0, "#1d1626", "#041729" ) & ";white-space:nowrap'><svg width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='" & IF ( _nf > 0, "#ff5c63", "#3aa7f2" ) & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><path d='M3.5 4.5h17l-6.6 7.8v6.4l-3.8 2v-8.4z'/></svg><span style='font-size:26px;font-weight:700;letter-spacing:1px'>OR</span><span style='font-size:17px;color:#a8bfd6'>Osmose