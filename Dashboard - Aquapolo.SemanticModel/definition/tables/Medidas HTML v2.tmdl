			```
		displayFolder: Visão Geral v2
		lineageTag: da8922f9-8a56-5a0d-889f-d2be0d62784c

	/// Coluna Clientes da Visão Geral v2: a entrega aos clientes em destaque, com a meta, a tendência do período e a variação sobre o período anterior.
	measure 'HTML v2 Clientes' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _passo = ROUNDUP ( DIVIDE ( _tamanho, 90 ), 0 )
			VAR _nb = MAX ( INT ( DIVIDE ( _tamanho - 1, _passo ) ), 1 )
			VAR _v1 = [Clientes Período]
			VAR _mi1 = 311.9212962963
			VAR _ma1 = BLANK ()
			VAR _rf1 = _mi1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 >= _rf1, "#4ed15d", _v1 >= _rf1 * 0.9, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si1 = SWITCH ( _co1, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f1 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Clientes (L/s)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _an1 = [Clientes Período Anterior]
			VAR _te1 = NOT ISBLANK ( _v1 ) && NOT ISBLANK ( _an1 ) && _an1 <> 0
			VAR _dl1 = DIVIDE ( _v1 - _an1, _an1 )
			VAR _s1 = SWITCH ( TRUE (), ISBLANK ( _v1 ), "n", _co1 = "#4ed15d", "d", _co1 = "#feb825", "a", _co1 = "#f4353f", "f", "s" )
			VAR _cr1 = SWITCH ( _s1, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _d01 = _f1 - _tamanho + 1
			VAR _t1 = CALCULATETABLE ( SELECTCOLUMNS ( 'Dados BI', "@b", INT ( DIVIDE ( INT ( 'Dados BI'[Data] - _d01 ), _passo ) ), "@v", 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Clientes (L/s)", 'Dados BI'[Valor] <> 0, 'Dados BI'[Data] >= _d01, 'Dados BI'[Data] <= _f1 )
			VAR _g1 = GROUPBY ( _t1, [@b], "@m", AVERAGEX ( CURRENTGROUP (), [@v] ) )
			VAR _hi1 = MIN ( MAX ( MAXX ( _g1, [@m] ), 311.9212962963 ), 3 * MAX ( _v1, 311.9212962963 ) )
			VAR _lo1 = MIN ( MINX ( _g1, [@m] ), 311.9212962963 )
			VAR _am1 = IF ( _hi1 > _lo1, _hi1 - _lo1, 1 )
			VAR _pts1 = CONCATENATEX ( _g1, FORMAT ( 6 + 296 * DIVIDE ( [@b], _nb ), "0.0", "en-US" ) & "," & FORMAT ( 150 - 140 * DIVIDE ( MIN ( [@m], _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ), " ", [@b], ASC )
			VAR _mg1 = IF ( ISBLANK ( _v1 ) || COUNTROWS ( _g1 ) < 2, "", "<svg viewBox='0 0 308 160' preserveAspectRatio='none' style='display:block;flex:1 1 0;min-height:0;width:308px;margin-top:10px'><defs><linearGradient id='v2-area' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#3aa7f2' stop-opacity='0.50'/><stop offset='1' stop-color='#3aa7f2' stop-opacity='0.08'/></linearGradient></defs><polygon points='" & FORMAT ( 6 + 296 * DIVIDE ( MINX ( _g1, [@b] ), _nb ), "0.0", "en-US" ) & ",160 " & _pts1 & " " & FORMAT ( 6 + 296 * DIVIDE ( MAXX ( _g1, [@b] ), _nb ), "0.0", "en-US" ) & ",160' fill='url(#v2-area)'/><path d='M0 " & FORMAT ( 150 - 140 * DIVIDE ( MIN ( _rf1, _hi1 ) - _lo1, _am1 ), "0.0", "en-US" ) & "H308' stroke='#57d68d' stroke-width='1.5' stroke-dasharray='7 6' vector-effect='non-scaling-stroke'/><polyline points='" & _pts1 & "' fill='none' stroke='" & IF ( ( _s1 = "a" || _s1 = "f" ), _cr1, "#5cc0ff" ) & "' stroke-width='3' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/><path d='M" & FORMAT ( 6 + 296 * DIVIDE ( MAXX ( _g1, [@b] ), _nb ), "0.0", "en-US" ) & " " & FORMAT ( MAXX ( TOPN ( 1, _g1, [@b], DESC ), 150 - 140 * DIVIDE ( MIN ( [@m], _hi1 ) - _lo1, _am1 ) ), "0.0", "en-US" ) & "h0.01' stroke='#f3f8fd' stroke-width='11' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>" )
			VAR _xh = 4 + 300 * MIN ( MAX ( DIVIDE ( _v1, _rf1 ) * 100, 0 ), 160 ) / 160
			VAR _ch = IF ( ( _s1 = "a" || _s1 = "f" ), _cr1, "#f3f8fd" )
			VAR _fa = IF ( ( _s1 = "a" || _s1 = "f" ), IF ( _s1 = "a", "<rect x='" & FORMAT ( MIN ( _xh, 191.5 ), "0.0", "en-US" ) & "' y='15' width='" & FORMAT ( ABS ( 191.5 - _xh ), "0.0", "en-US" ) & "' height='8' fill='#ffd257'/>", "<rect x='" & FORMAT ( MIN ( _xh, 191.5 ), "0.0", "en-US" ) & "' y='15' width='" & FORMAT ( ABS ( 191.5 - _xh ), "0.0", "en-US" ) & "' height='8' fill='#ff5c63'/>" ), "" )
			VAR _md1 = IF ( ISBLANK ( _v1 ), "<svg width='308' height='32' viewBox='0 0 308 32' style='display:block;flex:none;margin-top:6px'><rect x='4' y='15' width='300' height='8' fill='#143454'/><rect x='191.5' y='15' width='112.5' height='8' fill='#2b7d62'/><path d='M191.5 10v18' stroke='#f3f8fd' stroke-width='1.5'/><path d='M-3.0 1h14l-7 10z' fill='#f3f8fd'/><path d='M4.0 9v19' stroke='#f3f8fd' stroke-width='3'/></svg>", "<svg width='308' height='32' viewBox='0 0 308 32' style='display:block;flex:none;margin-top:6px'><rect x='4' y='15' width='300' height='8' fill='#143454'/><rect x='191.5' y='15' width='112.5' height='8' fill='#2b7d62'/>" & _fa & "<path d='M191.5 10v18' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _xh - 7, "0.0", "en-US" ) & " 1h14l-7 10z' fill='" & _ch & "'/><path d='M" & FORMAT ( _xh, "0.0", "en-US" ) & " 9v19' stroke='" & _ch & "' stroke-width='3'/></svg>" )
			VAR _vr1 = "<div style='display:flex;align-items:center;gap:8px;white-space:nowrap'><svg width='20' height='20' viewBox='0 0 16 16' fill='none' stroke='#f3f8fd' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><path d='" & IF ( NOT _te1, "M3 8h10", IF ( _dl1 >= 0, "M8 13.5V2.5M3 7.5l5-5 5 5", "M8 2.5v11M3 8.5l5 5 5-5" ) ) & "'/></svg><span style='font-size:26px;font-weight:700;line-height:32px'>" & IF ( _te1, FORMAT ( _dl1, "+0.0%;-0.0%" ), "&#8212;" ) & "</span><span style='font-size:17px;line-height:32px;color:#a8bfd6;margin-left:2px'>" & IF ( NOT _te1 || _dl1 = 0, "", IF ( _dl1 > 0, "melhorou", "piorou" ) ) & "</span></div>"
			VAR _dc1 = "<div class='dc' style='position:absolute;left:10px;top:118px;z-index:9;pointer-events:none;padding:11px 18px 13px 18px;background:#04182a;border:1px solid #2f6690;border-radius:6px;box-shadow:0 8px 22px rgba(0,0,0,0.6);font-weight:400;line-height:1.3;text-align:left;white-space:nowrap'><div style='display:flex;align-items:baseline;gap:9px'><b style='font-size:22px;color:#f3f8fd'>Clientes</b><span style='font-size:18px;color:#a8bfd6'>L/s</span><b style='margin-left:auto;padding-left:28px;font-size:20px;color:" & _cr1 & "'>" & _si1 & "</b></div><div style='display:flex;flex-direction:column;gap:8px;margin-top:7px'><div><div style='font-size:16px;color:#a8bfd6'>Período exibido</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>" & IF ( ISBLANK ( _f1 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f1, "dd/mm" ), FORMAT ( _f1 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f1, "dd/mm" ) ) ) & "</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0.0" ) ) & "</div></div><div><div style='font-size:16px;color:#a8bfd6'>Período anterior</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>" & IF ( ISBLANK ( _f1 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f1 - _tamanho, "dd/mm" ), FORMAT ( _f1 - _tamanho - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f1 - _tamanho, "dd/mm" ) ) ) & "</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _an1 ), "&#8212;", FORMAT ( _an1, "#,##0.0" ) ) & "</div></div><div><div style='font-size:16px;color:#a8bfd6'>Meta</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>&#8805; 311,9</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _rf1 ) || ISBLANK ( _v1 ), "&#8212;", FORMAT ( DIVIDE ( _v1, _rf1 ), "0%" ) ) & " da meta</div></div></div></div>"
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><style>.dc{display:none}.ind{cursor:help}.ind:hover{box-shadow:inset 0 0 0 1px #2f79ad}.ind:hover>.dc{display:block}</style><div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums;color:#f3f8fd;height:100vh;width:100%;overflow:hidden;display:flex;flex-direction:column'><div style='height:88px;flex:none;display:flex;flex-direction:column'><div style='height:22px;flex:none'></div><div style='height:52px;flex:none;display:flex;align-items:center'><div style='width:10px;flex:none;height:6px;background:#3aa7f2'></div><svg width='14' height='20' viewBox='0 0 14 20' style='flex:none'><path d='M0 0l14 10-14 10z' fill='#3aa7f2'/></svg><div style='height:52px;flex:1;display:flex;align-items:center;gap:12px;padding:0 18px 0 12px;border:2px solid " & IF ( _s1 = "f", "#ff5c63", "#3aa7f2" ) & ";border-radius:3px;background:" & IF ( _s1 = "f", "#1d1626", "#0a2a47" ) & ";white-space:nowrap'><svg width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='" & IF ( _s1 = "f", "#ff5c63", "#3aa7f2" ) & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><path d='M2.6 8.4h7.2a2.6 2.6 0 0 1 2.6 2.6v2a2.6 2.6 0 0 0 2.6 2.6h6.4'/><path d='M18.6 12.8l2.8 2.8-2.8 2.8M2.6 5.6v5.6'/></svg><span style='font-size:26px;font-weight:700;letter-spacing:1px'>CLIENTES</span><span style='font-size:17px;color:#a8bfd6'>Entrega</span></div></div><div style='height:14px;flex:none;display:flex;justify-content:center'><div style='width:2px;background:" & IF ( _s1 = "f", "#ff5c63", "#3aa7f2" ) & "'></div></div></div><div class='ind' style='position:relative;flex:1;min-height:0;display:flex;flex-direction:column;padding:6px 16px 10px;background:linear-gradient(180deg,#0b3157 0%,#061d33 58%);border:2px solid " & IF ( ( _s1 = "a" || _s1 = "f" ), _cr1, "#3aa7f2" ) & ";border-radius:3px'><div style='display:flex;align-items:baseline;gap:6px;margin-left:-5px;white-space:nowrap'><span style='font-size:108px;font-weight:700;line-height:108px;letter-spacing:-3px" & IF ( ( _s1 = "a" || _s1 = "f" ), ";color:" & _cr1, "" ) & "'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0.0" ) ) & "</span><span style='font-size:24px;font-weight:600;color:#7cc4f8'>L/s</span></div><div style='display:flex;align-items:center;gap:10px;margin-top:2px;white-space:nowrap'>" & SWITCH ( _s1, "d", "<span style='width:16px;height:16px;flex:none;border-radius:50%;background:#57d68d'></span>", "a", "<span style='width:0;height:0;flex:none;border-left:10px solid transparent;border-right:10px solid transparent;border-bottom:17px solid #ffd257'></span>", "f", "<span style='width:14px;height:14px;flex:none;background:#ff5c63;transform:rotate(45deg);margin:0 3px'></span>", "<span style='width:16px;height:16px;flex:none;border-radius:50%;border:2px solid #a8bfd6'></span>" ) & "<span style='font-size:30px;font-weight:700;line-height:36px;color:" & _cr1 & "'>" & IF ( ISBLANK ( _rf1 ) || ISBLANK ( _v1 ), "&#8212;", FORMAT ( DIVIDE ( _v1, _rf1 ), "0%" ) ) & " da meta</span><span style='flex:1'></span><span style='font-size:17px;color:#a8bfd6'>&#8805; 311,9</span></div>" & _md1 & "" & _mg1 & "<div style='display:flex;justify-content:space-between;font-size:16px;line-height:22px;color:#a8bfd6'><span>" & IF ( ISBLANK ( _f1 ), "&#8212;", FORMAT ( _f1 - _tamanho + 1, "dd/mm" ) ) & "</span><span>tracejado = meta</span><span>" & IF ( ISBLANK ( _f1 ), "&#8212;", FORMAT ( _f1, "dd/mm" ) ) & "</span></div><div style='margin-top:8px;border-top:1px solid #1f4263;padding-top:8px'>" & _vr1 & "</div>" & _dc1 & "</div></div>"
			```
		displayFolder: Visão Geral v2
		lineageTag: 2d978eb1-85fc-53ae-8126-fce6f82c553c

	/// Faixa de utilidades da Visão Geral v2: os consumos sob a etapa a que pertencem, o Blend e as Perdas. Valor = as medidas '... Período' da tabela Medidas HTML (planilha Dados BI); meta = a de ferramentas/preview/indicadores_op.py. A linha fora da meta ou em atenção cresce no próprio lugar, com o desvio em palavras e a tendência do período; a ordem nunca muda. Ao passar o mouse, abre a aba com o período e a meta.
	measure 'HTML v2 Utilidades' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _passo = ROUNDUP ( DIVIDE ( _tamanho, 90 ), 0 )
			VAR _nb = MAX ( INT ( DIVIDE ( _tamanho - 1, _passo ) ), 1 )
			VAR _v1 = [Químicos Período]
			VAR _mi1 = BLANK ()
			VAR _ma1 = 0.12
			VAR _rf1 = _ma1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 <= _rf1, "#4ed15d", _v1 <= _rf1 * 1.1, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si1 = SWITCH ( _co1, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f1 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Químicos (Kg/m³)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _an1 = [Químicos Período Anterior]
			VAR _te1 = NOT ISBLANK ( _v1 ) && NOT ISBLANK ( _an1 ) && _an1 <> 0
			VAR _dl1 = DIVIDE ( _v1 - _an1, _an1 )
			VAR _s1 = SWITCH ( TRUE (), ISBLANK ( _v1 ), "n", _co1 = "#4ed15d", "d", _co1 = "#feb825", "a", _co1 = "#f4353f", "f", "s" )
			VAR _cr1 = SWITCH ( _s1, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _vr1 = "<div style='display:flex;align-items:center;gap:6px;white-space:nowrap'><svg width='16' height='16' viewBox='0 0 16 16' fill='none' stroke='#f3f8fd' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><path d='" & IF ( NOT _te1, "M3 8h10", IF ( _dl1 >= 0, "M8 13.5V2.5M3 7.5l5-5 5 5", "M8 2.5v11M3 8.5l5 5 5-5" ) ) & "'/></svg><span style='font-size:18px;font-weight:700;line-height:24px'>" & IF ( _te1, FORMAT ( _dl1, "+0.0%;-0.0%" ), "&#8212;" ) & "</span><span style='font-size:16px;line-height:24px;color:#a8bfd6;margin-left:2px'>" & IF ( NOT _te1 || _dl1 = 0, "", IF ( _dl1 < 0, "melhorou", "piorou" ) ) & "</span></div>"
			VAR _dc1 = "<div class='dc' style='position:absolute;top:0;left:0;z-index:9;pointer-events:none;padding:11px 18px 13px 18px;background:#04182a;border:1px solid #2f6690;border-radius:6px;box-shadow:0 8px 22px rgba(0,0,0,0.6);font-weight:400;line-height:1.3;text-align:left;white-space:nowrap'><div style='display:flex;align-items:baseline;gap:9px'><b style='font-size:22px;color:#f3f8fd'>Químicos</b><span style='font-size:18px;color:#a8bfd6'>kg/m³</span><b style='margin-left:auto;padding-left:28px;font-size:20px;color:" & _cr1 & "'>" & _si1 & "</b></div><div style='display:flex;gap:36px;margin-top:7px'><div><div style='font-size:16px;color:#a8bfd6'>Período exibido</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>" & IF ( ISBLANK ( _f1 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f1, "dd/mm" ), FORMAT ( _f1 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f1, "dd/mm" ) ) ) & "</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _v1 ), "&#8212;", FORMAT ( _v1, "#,##0.00" ) ) & "</div></div><div><div style='font-size:16px;color:#a8bfd6'>Período anterior</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>" & IF ( ISBLANK ( _f1 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f1 - _tamanho, "dd/mm" ), FORMAT ( _f1 - _tamanho - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f1 - _tamanho, "dd/mm" ) ) ) & "</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _an1 ), "&#8212;", FORMAT ( _an1, "#,##0.00" ) ) & "</div></div><div><div style='font-size:16px;color:#a8bfd6'>Meta</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>&#8804; 0,12</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _rf1 ) || ISBLANK ( _v1 ), "&#8212;", FORMAT ( DIVIDE ( _v1, _rf1 ), "0%" ) ) & " da meta</div></div></div></div>"
			VAR _L1 = SWITCH ( TRUE (), NOT ISBLANK ( _ma1 ) && _v1 > _ma1, _ma1, NOT ISBLANK ( _mi1 ) && _v1 < _mi1, _mi1 )
			VAR _ac1 = _v1 > _L1
			VAR _r1 = DIVIDE ( _v1, _L1 )
			VAR _ex1 = ( _ac1 && _r1 >= 2 ) || ( NOT _ac1 && _r1 <= 0.5 )
			VAR _pc1 = ROUND ( ABS ( _r1 - 1 ) * 100, 0 )
			VAR _q1 = IF ( _ac1 && _r1 >= 2, FORMAT ( ROUND ( _r1, 1 ), "#,##0.0" ) & " vezes", IF ( _pc1 < 1, "menos de 1%", FORMAT ( _pc1, "0" ) & "%" ) & IF ( _ac1, " acima", " abaixo" ) )
			VAR _rt1 = SWITCH ( TRUE (), _ac1 && _r1 >= 2, "o teto", _ac1, "do teto", "do piso" )
			VAR _fc1 = IF ( _ex1 && _s1 = "f", "margin:0 -6px;padding:0 6px;background:#ff5c63;border-radius:2px;color:#1c0508", "color:" & _cr1 )
			VAR _br1 = 4 + 0.95 * DIVIDE ( _v1, _rf1 ) * 100
			VAR _x1 = 4 + ( MIN ( MAX ( _br1, 4 ), 156 ) - 4 ) * 1.0
			VAR _md1 = SWITCH ( TRUE (), _s1 = "s" || _s1 = "n", "<div style='width:160px;height:32px;flex:none;display:flex;align-items:center;gap:8px'><span style='width:14px;height:14px;flex:none;border-radius:50%;border:2px solid #a8bfd6'></span><span style='font-size:16px;color:#a8bfd6'>" & IF ( _s1 = "n", "sem leitura", "sem meta" ) & "</span></div>", _s1 = "d", "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='16' width='152' height='6' fill='#143454'/><rect x='4.0' y='16' width='95.0' height='6' fill='#2b7d62'/><path d='M99.0 12v14' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x1 - 5, "0.0", "en-US" ) & " 3h10l-5 8z' fill='#f3f8fd'/><path d='M" & FORMAT ( _x1, "0.0", "en-US" ) & " 10v16' stroke='#f3f8fd' stroke-width='2.5'/></svg>", _br1 > 156, "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='13' width='140.0' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='99.0' y='10' width='46.0' height='16' fill='" & _cr1 & "'/><path d='M113.0 29l5-22M122.0 29l5-22' stroke='" & IF ( _s1 = "a", "#1c2424", "#261a2c" ) & "' stroke-width='3.5'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M144.0 4l14 14-14 14z' fill='" & _cr1 & "'/></svg>", _br1 < 4, "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='16' y='13' width='140.0' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='15' y='10' width='84.0' height='16' fill='" & _cr1 & "'/><path d='M85.0 29l-5-22M76.0 29l-5-22' stroke='" & IF ( _s1 = "a", "#1c2424", "#261a2c" ) & "' stroke-width='3.5'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M16 4l-14 14 14 14z' fill='" & _cr1 & "'/></svg>", _s1 = "a", "<svg width='160' height='26' viewBox='0 0 160 26' style='display:block;flex:none;overflow:visible'><rect x='4' y='11' width='152' height='8' fill='#143454'/><rect x='4.0' y='11' width='95.0' height='8' fill='#2b7d62'/><rect x='99.0' y='11' width='" & FORMAT ( _x1 - 99.0, "0.0", "en-US" ) & "' height='8' fill='#ffd257'/><path d='M99.0 7v16' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x1 - 6, "0.0", "en-US" ) & " 0h12l-6 9z' fill='#ffd257'/><path d='M" & FORMAT ( _x1, "0.0", "en-US" ) & " 7v16' stroke='#ffd257' stroke-width='3'/></svg>", "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='13' width='152' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='99.0' y='13' width='" & FORMAT ( _x1 - 99.0, "0.0", "en-US" ) & "' height='10' fill='#ff5c63'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x1 - 7, "0.0", "en-US" ) & " 0h14l-7 11z' fill='#ff5c63'/><path d='M" & FORMAT ( _x1, "0.0", "en-US" ) & " 9v19' stroke='#ff5c63' stroke-width='3.5'/></svg>" )
			VAR _d01 = _f1 - _tamanho + 1
			VAR _t1 = CALCULATETABLE ( SELECTCOLUMNS ( 'Dados BI', "@b", INT ( DIVIDE ( INT ( 'Dados BI'[Data] - _d01 ), _passo ) ), "@v", 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Químicos (Kg/m³)", 'Dados BI'[Valor] <> 0, 'Dados BI'[Data] >= _d01, 'Dados BI'[Data] <= _f1 )
			VAR _g1 = GROUPBY ( _t1, [@b], "@m", AVERAGEX ( CURRENTGROUP (), [@v] ) )
			VAR _hi1 = MIN ( MAX ( MAXX ( _g1, [@m] ), 0.12 ), 3 * MAX ( _v1, 0.12 ) )
			VAR _lo1 = MIN ( MINX ( _g1, [@m] ), 0.12 )
			VAR _am1 = IF ( _hi1 > _lo1, _hi1 - _lo1, 1 )
