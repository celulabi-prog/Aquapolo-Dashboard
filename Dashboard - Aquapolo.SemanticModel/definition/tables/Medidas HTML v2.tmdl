			VAR _q4 = IF ( _ac4 && _r4 >= 2, FORMAT ( ROUND ( _r4, 1 ), "#,##0.0" ) & " vezes", IF ( _pc4 < 1, "menos de 1%", FORMAT ( _pc4, "0" ) & "%" ) & IF ( _ac4, " acima", " abaixo" ) )
			VAR _rt4 = SWITCH ( TRUE (), _ac4 && _r4 >= 2, "o teto", _ac4, "do teto", "do piso" )
			VAR _fc4 = IF ( _ex4 && _s4 = "f", "margin:0 -6px;padding:0 6px;background:#ff5c63;border-radius:2px;color:#1c0508", "color:" & _cr4 )
			VAR _br4 = 4 + 0.95 * DIVIDE ( _v4, _rf4 ) * 100
			VAR _x4 = 4 + ( MIN ( MAX ( _br4, 4 ), 156 ) - 4 ) * 1.0
			VAR _md4 = SWITCH ( TRUE (), _s4 = "s" || _s4 = "n", "<div style='width:160px;height:32px;flex:none;display:flex;align-items:center;gap:8px'><span style='width:14px;height:14px;flex:none;border-radius:50%;border:2px solid #a8bfd6'></span><span style='font-size:16px;color:#a8bfd6'>" & IF ( _s4 = "n", "sem leitura", "sem meta" ) & "</span></div>", _s4 = "d", "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='16' width='152' height='6' fill='#143454'/><rect x='4.0' y='16' width='95.0' height='6' fill='#2b7d62'/><path d='M99.0 12v14' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x4 - 5, "0.0", "en-US" ) & " 3h10l-5 8z' fill='#f3f8fd'/><path d='M" & FORMAT ( _x4, "0.0", "en-US" ) & " 10v16' stroke='#f3f8fd' stroke-width='2.5'/></svg>", _br4 > 156, "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='13' width='140.0' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='99.0' y='10' width='46.0' height='16' fill='" & _cr4 & "'/><path d='M113.0 29l5-22M122.0 29l5-22' stroke='" & IF ( _s4 = "a", "#1c2424", "#261a2c" ) & "' stroke-width='3.5'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M144.0 4l14 14-14 14z' fill='" & _cr4 & "'/></svg>", _br4 < 4, "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='16' y='13' width='140.0' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='15' y='10' width='84.0' height='16' fill='" & _cr4 & "'/><path d='M85.0 29l-5-22M76.0 29l-5-22' stroke='" & IF ( _s4 = "a", "#1c2424", "#261a2c" ) & "' stroke-width='3.5'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M16 4l-14 14 14 14z' fill='" & _cr4 & "'/></svg>", _s4 = "a", "<svg width='160' height='26' viewBox='0 0 160 26' style='display:block;flex:none;overflow:visi