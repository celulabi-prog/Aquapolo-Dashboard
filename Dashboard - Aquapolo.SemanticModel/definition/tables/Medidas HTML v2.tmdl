			VAR _mg6 = IF ( COUNTROWS ( _g6 ) < 2 || _semmini, "", IF ( _s6 = "a", "<svg viewBox='0 0 160 60' preserveAspectRatio='none' style='display:block;flex:1 1 0;min-height:0;max-height:56px;width:160px'><rect x='0' y='" & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma6, _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & "' width='160' height='" & FORMAT ( ( 56 - 52 * DIVIDE ( MIN ( _mi6, _hi6 ) - _lo6, _am6 ) ) - ( 56 - 52 * DIVIDE ( MIN ( _ma6, _hi6 ) - _lo6, _am6 ) ), "0.0", "en-US" ) & "' fill='rgba(87,214,141,0.20)'/><polygon points='" & FORMAT ( 4 + 152 * DIVIDE ( MINX ( _g6, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L6, _rf6 ), _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & " " & _pts6 & " " & FORMAT ( 4 + 152 * DIVIDE ( MAXX ( _g6, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L6, _rf6 ), _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & "' fill='rgba(255,210,87,0.28)'/><path d='" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma6, _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & "H160" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _mi6, _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & "H160" & "' stroke='#57d68d' stroke-width='1.5' stroke-dasharray='5 4' vector-effect='non-scaling-stroke'/><polyline points='" & _pts6 & "' fill='none' stroke='#ffd257' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>", "<svg viewBox='0 0 160 60' preserveAspectRatio='none' style='display:block;flex:1 1 0;min-height:0;max-height:56px;width:160px'><rect x='0' y='" & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma6, _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & "' width='160' height='" & FORMAT ( ( 56 - 52 * DIVIDE ( MIN ( _mi6, _hi6 ) - _lo6, _am6 ) ) - ( 56 - 52 * DIVIDE ( MIN ( _ma6, _hi6 ) - _lo6, _am6 ) ), "0.0", "en-US" ) & "' fill='rgba(87,214,141,0.20)'/><polygon points='" & FORMAT ( 4 + 152 * DIVIDE ( MINX ( _g6, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L6, _rf6 ), _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & " " & _pts6 & " " & FORMAT ( 4 + 152 * DIVIDE ( MAXX ( _g6, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L6, _rf6 ), _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & "' fill='rgba(255,92,99,0.28)'/><path d='" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma6, _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & "H160" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _mi6, _hi6 ) - _lo6, _am6 ), "0.0", "en-US" ) & "H160" & "' stroke='#57d68d' stroke-width='1.5' stroke-dasharray='5 4' vector-effect='non-scaling-stroke'/><polyline points='" & _pts6 & "' fill='none' stroke='#ff5c63' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>" ) )
			VAR _dc6 = "<div class='dc' style='position:absolute;left:12px;margin:3px 0;bottom:100%;z-index:9;pointer-events:none;padding:11px 18px 13px 18px;background:#04182a;border:1px solid #2f6690;border-radius:6px;box-shadow:0 8px 22px rgba(0,0,0,0.6);font-weight:400;line-height:1.3;text-align:left;white-space:nowrap'><div style='display:flex;align-items:baseline;gap:9px'><b style='font-size:22px;color:#f3f8fd'>Fluxo</b><span style='font-size:18px;color:#a8bfd6'>LMH</span><b style='margin-left:auto;padding-left:28px;font-size:20px;color:" & _cr6 & "'>" & _si6 & "</b></div><div style='display:flex;gap:36px;margin-top:7px'><div><div style='font-size:16px;color:#a8bfd6'>Período exibido</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>" & IF ( ISBLANK ( _f6 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f6, "dd/mm" ), FORMAT ( _f6 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f6, "dd/mm" ) ) ) & "</div></div><div><div style='font-size:16px;color:#a8bfd6'>Meta</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>17 &#8211; 24</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _rf6 ) || ISBLANK ( _v6 ), "&#8212;", FORMAT ( DIVIDE ( _v6, _rf6 ), "0%" ) ) & " da meta</div></div></div></div>"
			VAR _h6 = SWITCH ( _s6, "f", "<div class='ind' style='flex:2 1 0;min-height:72px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;border-left:6px solid #ff5c63;background:rgba(255,92,99,0.13)'><div style='display:flex;flex-direction:column;align-items:flex-start;white-space:nowrap'><div style='font-size:22px;font-weight:700;line-height:26px'>Fluxo</div><div style='font-size:16px;line-height:20px;color:#a8bfd6'>LMH &#183; 17 &#8211; 24</div><div style='font-size:20px;font-weight:700;line-height:24px;" & _fc6 & "'>" & _q6 & " " & _rt6 & "</div></div><div style='font-size:56px;font-weight:700;line-height:60px;letter-spacing:-1px;text-align:right;color:#ff5c63'>" & IF ( ISBLANK ( _v6 ), "&#8212;", FORMAT ( _v6, "#,##0.0" ) ) & "</div><div style='align-self:stretch;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:4px;padding:5px 0'>" & _mg6 & "" & _md6 & "</div>" & _dc6 & "</div>", "a", "<div class='ind' style='flex:1.5 1 0;min-height:70px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;border-left:6px solid #ffd257;background:rgba(255,210,87,0.08)'><div style='display:flex;flex-direction:column;align-items:flex-start;white-space:nowrap'><div style='font-size:20px;font-weight:700;line-height:24px'>Fluxo</div><div style='font-size:16px;line-height:20px;color:#a8bfd6'>LMH &#183; 17 &#8211; 24</div><div style='font-size:17px;font-weight:700;line-height:20px;" & _fc6 & "'>" & _q6 & " " & _rt6 & "</div></div><div style='font-size:44px;font-weight:700;line-height:48px;text-align:right;color:#ffd257'>" & IF ( ISBLANK ( _v6 ), "&#8212;", FORMAT ( _v6, "#,##0.0" ) ) & "</div><div style='align-self:stretch;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:3px;padding:5px 0'>" & _mg6 & "" & _md6 & "</div>" & _dc6 & "</div>", "<div class='ind' style='flex:1 1 0;min-height:50px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;border-left:6px solid transparent'><div style='white-space:nowrap'><div style='font-size:19px;font-weight:600;line-height:24px'>Fluxo</div><div style='font-size:16px;line-height:20px;color:#a8bfd6'>LMH &#183; 17 &#8211; 24</div></div><div style='font-size:34px;font-weight:700;line-height:38px;text-align:right'>" & IF ( ISBLANK ( _v6 ), "&#8212;", FORMAT ( _v6, "#,##0.0" ) ) & "</div>" & _md6 & "" & _dc6 & "</div>" )
			VAR _vc = IF ( _nf > 0, "<span style='font-size:28px;font-weight:700;color:#ff5c63'>" & _nf & " fora da meta</span>", "" ) & IF ( _na > 0, IF ( _nf > 0, "<span style='font-size:24px;font-weight:700;color:#ffd257'>" & _na & " em atenção</span>", "<span style='font-size:28px;font-weight:700;color:#ffd257'>" & _na & " em atenção</span>" ), "" )
			VAR _ver = IF ( _nf + _na = 0, "<div style='display:flex;align-items:baseline;gap:10px;white-space:nowrap;line-height:36px'><span style='font-size:28px;font-weight:700'>" & _nd & " de 6</span><span style='font-size:24px;color:#d3e1ef'>dentro da meta</span></div>", "<div style='display:flex;align-items:baseline;gap:14px;white-space:nowrap;line-height:36px'>" & _vc & "</div>" )
			VAR _ft = SWITCH ( _s1, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s2, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s3, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s4, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s5, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s6, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" )
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><style>.dc{display:none}.ind{cursor:help}.ind:hover{box-shadow:inset 0 0 0 1px #2f79ad}.ind:hover>.dc{display:block}</style><div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums;color:#f3f8fd;height:100vh;width:100%;overflow:hidden;display:flex;flex-direction:column'><div style='height:88px;flex:none;display:flex;flex-direction:column'><div style='height:22px;flex:none'></div><div style='height:52px;flex:none;display:flex;align-items:center'><div style='flex:1;height:6px;background:#3aa7f2'></div><svg width='14' height='20' viewBox='0 0 14 20' style='flex:none'><path d='M0 0l14 10-14 10z' fill='#3aa7f2'/></svg><div style='height:52px;flex:none;display:flex;align-items:center;gap:12px;padding:0 18px 0 12px;border:2px solid " & IF ( _nf > 0, "#ff5c63", "#3aa7f2" ) & ";border-radius:3px;background:" & IF ( _nf > 0, "#1d1626", "#041729" ) & ";white-space:nowrap'><svg width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='" & IF ( _nf > 0, "#ff5c63", "#3aa7f2" ) & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><path d='M4 4.6v14.8M8.7 4.6v14.8M12 4.6v14.8M15.3 4.6v14.8M20 4.6v14.8'/><path d='M2.6 4.6h18.8M2.6 19.4h18.8'/></svg><span style='font-size:26px;font-weight:700;letter-spacing:1px'>TMBR</span><span style='font-size:17px;color:#a8bfd6'>Biológico e membranas</span></div><div style='flex:1;height:6px;background:#3aa7f2'></div></div><div style='height:14px;flex:none;display:flex;justify-content:center'><div style='width:2px;background:" & IF ( _nf > 0, "#ff5c63", "#2a77b0" ) & "'></div></div></div><div style='flex:1;min-height:0;display:flex;flex-direction:column;background:#041729;border:2px solid " & IF ( _nf > 0, "#ff5c63", IF ( _na > 0, "#ffd257", "#1f4263" ) ) & ";border-radius:3px'><div style='height:78px;flex:none;display:flex;flex-direction:column;justify-content:space-between;padding:8px 14px 12px;background:" & IF ( _nf > 0, "#2a1524", "#0a2137" ) & "'>" & _ver & "<div style='height:14px;display:flex;align-items:flex-end;gap:4px'>" & _ft & "</div></div><div style='flex:1;min-height:0;display:flex;flex-direction:column'>" & _h1 & _h2 & _h3 & _h4 & _h5 & _h6 & "</div></div></div>"
			```
		displayFolder: Visão Geral v2
		lineageTag: a499d0d2-ecc6-5b93-855c-420f77b927ff

	/// Coluna OR da Visão Geral v2: o nó do trem e o bloco com SDI, dP Skid 1, dP Skid 2, dP Skid 3. Valor = as medidas '... Período' da tabela Medidas HTML (planilha Dados BI); meta = a de ferramentas/preview/indicadores_op.py. A linha fora da meta ou em atenção cresce no próprio lugar, com o desvio em palavras e a tendência do período; a ordem nunca muda. Ao passar o mouse, abre a aba com o período e a meta.
	measure 'HTML v2 OR' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _passo = ROUNDUP ( DIVIDE ( _tamanho, 90 ), 0 )
			VAR _nb = MAX ( INT ( DIVIDE ( _tamanho - 1, _passo ) ), 1 )
			VAR _v1 = [SDI Período]
			VAR _mi1 = BLANK ()
			VAR _ma1 = 3.0
			VAR _rf1 = _ma1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _rf1 ), "#5c7791", _v1 <= _rf1, "#4ed15d", _v1 <= _rf1 * 1.1, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si1 = SWITCH ( _co1, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f1 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "SDI", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s1 = SWITCH ( TRUE (), ISBLANK ( _v1 ), "n", _co1 = "#4ed15d", "d", _co1 = "#feb825", "a", _co1 = "#f4353f", "f", "s" )
			VAR _cr1 = SWITCH ( _s1, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v2 = [dP Skid 1 Período]
			VAR _mi2 = BLANK ()
			VAR _ma2 = 3.5
			VAR _rf2 = _ma2
			VAR _co2 = SWITCH ( TRUE (), ISBLANK ( _v2 ) || ISBLANK ( _rf2 ), "#5c7791", _v2 <= _rf2, "#4ed15d", _v2 <= _rf2 * 1.1, "#feb825", "#f4353f" )
			VAR _lg2 = MIN ( MAX ( DIVIDE ( _v2, _rf2 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si2 = SWITCH ( _co2, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f2 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "dP Skid 1 (bar)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s2 = SWITCH ( TRUE (), ISBLANK ( _v2 ), "n", _co2 = "#4ed15d", "d", _co2 = "#feb825", "a", _co2 = "#f4353f", "f", "s" )
			VAR _cr2 = SWITCH ( _s2, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v3 = [dP Skid 2 Período]
			VAR _mi3 = BLANK ()
			VAR _ma3 = 3.5
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si3 = SWITCH ( _co3, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f3 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "dP Skid-02 (bar)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s3 = SWITCH ( TRUE (), ISBLANK ( _v3 ), "n", _co3 = "#4ed15d", "d", _co3 = "#feb825", "a", _co3 = "#f4353f", "f", "s" )
			VAR _cr3 = SWITCH ( _s3, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v4 = [dP Skid 3 Período]
			VAR _mi4 = BLANK ()
			VAR _ma4 = 3.5
			VAR _rf4 = _ma4
			VAR _co4 = SWITCH ( TRUE (), ISBLANK ( _v4 ) || ISBLANK ( _rf4 ), "#5c7791", _v4 <= _rf4, "#4ed15d", _v4 <= _rf4 * 1.1, "#feb825", "#f4353f" )
			VAR _lg4 = MIN ( MAX ( DIVIDE ( _v4, _rf4 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si4 = SWITCH ( _co4, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f4 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "dP Skid-03 (bar)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s4 = SWITCH ( TRUE (), ISBLANK ( _v4 ), "n", _co4 = "#4ed15d", "d", _co4 = "#feb825", "a", _co4 = "#f4353f", "f", "s" )
			VAR _cr4 = SWITCH ( _s4, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _nf = 0 + IF ( _s1 = "f", 1 ) + IF ( _s2 = "f", 1 ) + IF ( _s3 = "f", 1 ) + IF ( _s4 = "f", 1 )
			VAR _na = 0 + IF ( _s1 = "a", 1 ) + IF ( _s2 = "a", 1 ) + IF ( _s3 = "a", 1 ) + IF ( _s4 = "a", 1 )
			VAR _nd = 0 + IF ( _s1 = "d", 1 ) + IF ( _s2 = "d", 1 ) + IF ( _s3 = "d", 1 ) + IF ( _s4 = "d", 1 )
			VAR _L1 = SWITCH ( TRUE (), NOT ISBLANK ( _ma1 ) && _v1 > _ma1, _ma1, NOT ISBLANK ( _mi1 ) && _v1 < _mi1, _mi1 )
			VAR _ac1 = _v1 > _L1
			VAR _r1 = DIVIDE ( _v1, _L1 )
			VAR _ex1 = ( _ac1 && _r1 >= 2 ) || ( NOT _ac1 && _r1 <= 0.5 )
			VAR _pc1 = ROUND ( ABS ( _r1 - 1 ) * 100, 0 )
			VAR _q1 = IF ( _ac1 && _r1 >= 2, FORMAT ( ROUND ( _r1, 1 ), "#,##0.0" ) & " vezes", IF ( _pc1 < 1, "menos de 1%", FORMAT ( _pc1, "0" ) & "%" ) & IF ( _ac1, " acima", " abaixo" ) )
			VAR _rt1 = SWITCH ( TRUE (), _ac1 && _r1 >= 2, "o teto", _ac1, "do teto", "do piso" )
			VAR _fc1 = IF ( _ex1 && _s1 = "f", "margin:0 -6px;padding:0 6px;background:#ff5c63;border-radius:2px;color:#1c0508", "color:" & _cr1 )
			VAR _br1 = 4 + 0.95 * DIVIDE ( _v1, _rf1 ) * 100
			VAR _x1 = 4 + ( MIN ( MAX ( _br1, 4 ), 156 ) - 4 ) * 1.0
