i4 ) - _lo4, _am4 ), "0.0", "en-US" ) & "' fill='rgba(255,92,99,0.28)'/><path d='" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma4, _hi4 ) - _lo4, _am4 ), "0.0", "en-US" ) & "H160" & "' stroke='#57d68d' stroke-width='1.5' stroke-dasharray='5 4' vector-effect='non-scaling-stroke'/><polyline points='" & _pts4 & "' fill='none' stroke='#ff5c63' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>" ) )
			VAR _dc4 = "<div class='dc' style='position:absolute;left:12px;margin:3px 0;bottom:100%;z-index:9;pointer-events:none;padding:11px 18px 13px 18px;background:#04182a;border:1px solid #2f6690;border-radius:6px;box-shadow:0 8px 22px rgba(0,0,0,0.6);font-weight:400;line-height:1.3;text-align:left;white-space:nowrap'><div style='display:flex;align-items:baseline;gap:9px'><b style='font-size:22px;color:#f3f8fd'>dP Skid 3</b><span style='font-size:18px;color:#a8bfd6'>bar</span><b style='margin-left:auto;padding-left:28px;font-size:20px;color:" & _cr4 & "'>" & _si4 & "</b></div><div style='display:flex;gap:36px;margin-top:7px'><div><div style='font-size:16px;color:#a8bfd6'>Período exibido</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>" & IF ( ISBLANK ( _f4 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f4, "dd/mm" ), FORMAT ( _f4 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f4, "dd/mm" ) ) ) & "</div></div><div><div style='font-size:16px;color:#a8bfd6'>Meta</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>&#8804; 3,5</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _rf4 ) || ISBLANK ( _v4 ), "&#8212;", FORMAT ( DIVIDE ( _v4, _rf4 ), "0%" ) ) & " da meta</div></div></div></div>"
