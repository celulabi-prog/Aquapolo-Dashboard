		displayFolder: Visão Geral v2
		lineageTag: cb1f5837-5810-583a-bc7c-ec2c048be681

	/// Estado dos dados na Visão Geral v2: em dia (última leitura há até 1 dia), pendentes (até 3 dias) ou atrasados. Ao passar o mouse, mostra a data dos dados, quando a planilha foi salva, quando o Power BI foi atualizado e o que falta fazer.
	measure 'HTML v2 Dados' = ```
			-- Agora no horário de Brasília (UTC-3), para valer igual no Desktop e no serviço.
			VAR _agora = UTCNOW () - 3 / 24
			VAR _hoje = INT ( _agora )
			VAR _dados = CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Valor] <> 0, 'Dados BI'[Data] <= TODAY () )
			VAR _plan = CALCULATE ( MAX ( 'Dados BI'[Planilha salva em] ), REMOVEFILTERS ( 'Dados BI' ) )
			VAR _bi = CALCULATE ( MAX ( 'Dados BI'[Carregado em] ), REMOVEFILTERS ( 'Dados BI' ) )
			-- Atraso = dias entre a última leitura e hoje. É ele que decide o status.
			VAR _atraso = _hoje - INT ( _dados )
			VAR _nivel = SWITCH ( TRUE (), ISBLANK ( _dados ), 0, _atraso <= 1, 1, _atraso <= 3, 2, 3 )
			VAR _cor = SWITCH ( _nivel, 1, "#4ed15d", 2, "#feb825", 3, "#f4353f", "#5c7791" )
			VAR _palavra = SWITCH ( _nivel, 1, "Em dia", 2, "Pendente", 3, "Atrasado", "Sem dados" )
			VAR _ha = SWITCH ( TRUE (), _atraso <= 0, "hoje", _atraso = 1, "ontem", "há " & _atraso & " dias" )
			VAR _rotulo = IF ( ISBLANK ( _dados ), "Sem leitura na planilha", "Dados até " & FORMAT ( _dados, "dd/mm" ) & " &#183; " & _ha )
			-- O que falta, na ordem em que dá para saber: o Power BI só enxerga a planilha quando é atualizado.
			VAR _falta = SWITCH ( TRUE (), _nivel = 1, "Nada pendente.", ISBLANK ( _bi ) || INT ( _bi ) < _hoje, "Falta atualizar o Power BI.", ISBLANK ( _plan ) || INT ( _plan ) < _hoje, "Falta abrir e salvar a planilha no Excel e depois atualizar o Power BI.", "Falta lançar os dados nas planilhas de origem." )
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><style>.cx:hover+.dt,.dt:hover{display:block!important}</style><div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums;color:#f3f8fd;height:100vh;width:100%;overflow:hidden;'><div class='cx' style='height:64px;display:flex;align-items:center;gap:12px;padding:0 16px 0 14px;background:" & SWITCH ( _nivel, 1, "#041729", 2, "#ffd257", 3, "#ff5c63", "#041729" ) & ";border:1px solid " & SWITCH ( _nivel, 1, "#1f4263", 2, "#ffd257", 3, "#ff5c63", "#1f4263" ) & ";border-radius:3px;color:" & SWITCH ( _nivel, 1, "#f3f8fd", 2, "#1c1500", 3, "#1c0508", "#a8bfd6" ) & ";cursor:default'><svg width='36' height='36' viewBox='0 0 24 24' fill='none' stroke='" & SWITCH ( _nivel, 1, "#f3f8fd", 2, "#1c1500", 3, "#1c0508", "#a8bfd6" ) & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><circle cx='12' cy='12' r='9'/><path d='M12 7v5.5l3.5 2'/></svg><div style='white-space:nowrap'><div style='font-size:16px;font-weight:700;letter-spacing:1px;line-height:20px'>" & SWITCH ( _nivel, 1, "DADOS EM DIA", 2, "DADOS PENDENTES", 3, "DADOS ATRASADOS", "SEM DADOS" ) & "</div><div style='font-size:26px;font-weight:700;line-height:30px'>" & IF ( ISBLANK ( _dados ), "&#8212;", _ha ) & "</div></div><div style='flex:1'></div><div style='text-align:right;white-space:nowrap'><div style='font-size:16px;font-weight:600;line-height:20px'>dados até</div><div style='font-size:26px;font-weight:700;line-height:30px'>" & IF ( ISBLANK ( _dados ), "&#8212;", FORMAT ( _dados, "dd/mm" ) ) & "</div></div></div><div class='dt' style='display:none;margin-top:6px;padding:9px 14px 11px 14px;background:#04182a;border:1px solid #2f6690;border-radius:6px;font-size:17px;box-shadow:0 8px 22px rgba(0,0,0,0.6)'><div style='display:flex;justify-content:space-between;gap:10px;line-height:1.5'><span style='color:#a8bfd6;white-space:nowrap'>Dados até</span><b style='color:#d3e1ef;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _dados ), "&#8212;", FORMAT ( _dados, "dd/mm/yyyy" ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:1.5'><span style='color:#a8bfd6;white-space:nowrap'>Planilha salva</span><b style='color:#d3e1ef;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _plan ), "&#8212;", FORMAT ( _plan, "dd/mm hh:nn" ) ) & "</b></div><div style='display:flex;justify-content:space-between;gap:10px;line-height:1.5'><span style='color:#a8bfd6;white-space:nowrap'>Power BI atualizado</span><b style='color:#d3e1ef;white-space:nowrap;font-weight:600'>" & IF ( ISBLANK ( _bi ), "&#8212;", FORMAT ( _bi, "dd/mm hh:nn" ) ) & "</b></div><div style='margin-top:6px;padding-top:6px;border-top:1px solid #1f4263;color:#d3e1ef;line-height:1.3'>" & _falta & "</div></div></div>"
			```
		displayFolder: Visão Geral v2
		lineageTag: bf06b1c1-37fc-55b1-9180-6a9f4d4babe6

	/// Caixa do cabeçalho da Visão Geral v2 com as datas do período exibido. Ao passar o mouse, as datas com o ano.
	measure 'HTML v2 Período' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			-- Com um tamanho fixo, o período geral termina na última leitura da planilha (a data do rodapé).
			VAR _fim = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Valor] <> 0, 'Dados BI'[Data] <= TODAY () ) )
			VAR _rotulo = IF ( _exatas, "Datas escolhidas", "Período exibido" ) & " &#183; " & _tamanho & IF ( _tamanho = 1, " dia", " dias" )
			VAR _nota = IF ( _exatas, "Mesmo período para todos os indicadores.", "Cada indicador vai até a sua última leitura." )
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><style>.cx:hover+.dt,.dt:hover{display:block!important}</style><div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums;color:#f3f8fd;height:100vh;width:100%;overflow:hidden;'><div class='cx' style='height:103px;display:flex;align-items:center;justify-content:flex-end;gap:14px;cursor:default'><svg width='36' height='36' viewBox='0 0 24 24' fill='none' stroke='#3aa7f2' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><rect x='3.5' y='5' width='17' height='15.5' rx='2.2'/><path d='M3.5 10h17M8 3v4M16 3v4'/></svg><div style='white-space:nowrap'><div style='font-size:17px;line-height:22px;color:#a8bfd6'>" & _rotulo & "</div><div style='font-size:30px;font-weight:700;line-height:36px'>" & IF ( ISBLANK ( _fim ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _fim, "dd/mm" ), FORMAT ( _fim - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _fim, "dd/mm" ) ) ) & "</div></div></div><div class='dt' style='display:none;margin-left:auto;width:max-content;padding:8px 14px 9px 14px;background:#04182a;border:1px solid #2f6690;border-radius:6px;box-shadow:0 8px 22px rgba(0,0,0,0.6)'><div style='font-size:18px;font-weight:700;white-space:nowrap'>" & IF ( ISBLANK ( _fim ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _fim, "dd/mm/yyyy" ), FORMAT ( _fim - _tamanho + 1, "dd/mm/yyyy" ) & " a " & FORMAT ( _fim, "dd/mm/yyyy" ) ) ) & "</div><div style='margin-top:3px;font-size:16px;color:#d3e1ef;white-space:nowrap'>" & _nota & "</div></div></div>"
			```
		displayFolder: Visão Geral v2
		lineageTag: 40cbda55-2fcd-56fa-8181-8d0b3a7e2510

	/// Legenda da Visão Geral v2: as marcas de situação, o destaque da linha, o medidor e a variação.
	measure 'HTML v2 Legenda' = ```
			"<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums;color:#f3f8fd;height:100vh;width:100%;overflow:hidden;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border:1px solid #1f4263;border-radius:3px;font-size:16px;color:#d3e1ef'><div style='display:flex;align-items:center;gap:8px;white-space:nowrap'><span style='width:14px;height:14px;flex:none;border-radius:50%;background:#57d68d'></span><span>Dentro da meta</span></div><div style='display:flex;align-items:center;gap:8px;white-space:nowrap'><span style='width:0;height:0;flex:none;border-left:8px solid transparent;border-right:8px solid transparent;border-bottom:14px solid #ffd257'></span><span>Atenção: até 10% fora</span></div><div style='display:flex;align-items:center;gap:10px;white-space:nowrap'><span style='width:12px;height:12px;flex:none;background:#ff5c63;transform:rotate(45deg)'></span><span>Fora da meta</span></div><div style='display:flex;align-items:center;gap:8px;white-space:nowrap'><span style='width:14px;height:14px;flex:none;border-radius:50%;border:2px solid #a8bfd6'></span><span>Sem meta</span></div><div style='width:1px;height:22px;background:#1f4263'></div><div style='display:flex;align-items:center;gap:10px;white-space:nowrap'><svg width='34' height='24' viewBox='0 0 34 24'><rect x='0' y='1' width='34' height='3' fill='#5f88b0'/><rect x='0' y='7' width='34' height='11' fill='#ff5c63'/><rect x='0' y='21' width='34' height='3' fill='#5f88b0'/></svg><span>Fora ou em atenção: a linha cresce &#183; a ordem não muda</span></div><div style='width:1px;height:22px;background:#1f4263'></div><div style='display:flex;align-items:center;gap:10px;white-space:nowrap'><svg width='80' height='24' viewBox='0 0 107 32'><rect x='3' y='16' width='101' height='6' fill='#143454'/><rect x='3' y='16' width='63' height='6' fill='#2b7d62'/><path d='M66 11v16' stroke='#f3f8fd' stroke-width='2'/><path d='M34 2h12l-6 9z' fill='#f3f8fd'/><path d='M40 10v17' stroke='#f3f8fd' stroke-width='3'/></svg><span>Faixa verde e tracejado = meta &#183; ponteiro = valor</span></div><div style='display:flex;align-items:center;gap:4px;white-space:nowrap'><svg width='15' height='15' viewBox='0 0 16 16' fill='none' stroke='#f3f8fd' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><path d='M8 13.5V2.5M3 7.5l5-5 5 5'/></svg><svg width='15' height='15' viewBox='0 0 16 16' fill='none' stroke='#f3f8fd' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><path d='M8 2.5v11M3 8.5l5 5 5-5'/></svg><span style='margin-left:4px'>Variação sobre o período anterior</span></div></div>"
			```
		displayFolder: Visão Geral v2
		lineageTag: 323b2486-a088-539d-9ac4-2a00a2279a83

	column Aux
		dataType: string
		isHidden
		lineageTag: fd907cc1-7461-5ed6-ac76-4dd06a11a195
		summarizeBy: none
		isNameInferred
		sourceColumn: [Aux]

		annotation SummarizationSetBy = Automatic

	partition 'Medidas HTML v2' = calculated
		mode: import
		source = ROW("Aux", BLANK())
