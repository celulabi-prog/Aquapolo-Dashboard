			VAR _pc5 = ROUND ( ABS ( _r5 - 1 ) * 100, 0 )
			VAR _q5 = IF ( _ac5 && _r5 >= 2, FORMAT ( ROUND ( _r5, 1 ), "#,##0.0" ) & " vezes", IF ( _pc5 < 1, "menos de 1%", FORMAT ( _pc5, "0" ) & "%" ) & IF ( _ac5, " acima", " abaixo" ) )
			VAR _rt5 = SWITCH ( TRUE (), _ac5 && _r5 >= 2, "o teto", _ac5, "do teto", "do piso" )
			VAR _fc5 = IF ( _ex5 && _s5 = "f", "margin:0 -6px;padding:0 6px;background:#ff5c63;border-radius:2px;color:#1c0508", "color:" & _cr5 )
			VAR _br5 = 4 + 0.95 * DIVIDE ( _v5, _rf5 ) * 100
			VAR _x5 = 4 + ( MIN ( MAX ( _br5, 4 ), 156 ) - 4 ) * 1.0
			VAR _md5 = SWITCH ( TRUE (), _s5 = "s" || _s5 = "n", "<div style='width:160px;height:32px;flex:none;display:flex;align-items:center;gap:8px'><span style='width:14px;height:14px;flex:none;border-radius:50%;border:2px solid #a8bfd6'></span><span style='font-size:16px;color:#a8bfd6'>" & IF ( _s5 = "n", "sem leitura", "sem meta" ) & "</span></div>", _s5 = "d", "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='16' width='152' height='6' fill='#143454'/><rect x='4.0' y='16' width='95.0' height='6' fill='#2b7d62'/><path d='M99.0 12v14' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x5 - 5, "0.0", "en-US" ) & " 3h10l-5 8z' fill='#f3f8fd'/><path d='M" & FORMAT ( _x5, "0.0", "en-US" ) & " 10v16' stroke='#f3f8fd' stroke-width='2.5'/></svg>", _br5 > 156, "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='13' width='140.0' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='99.0' y='10' width='46.0' height='16' fill='" & _cr5 & "'/><path d='M113.0 29l5-22M122.0 29l5-22' stroke='" & IF ( _s5 = "a", "#1c2424", "#261a2c" ) & "' stroke-width='3.5'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M144.0 4l14 14-14 14z' fill='" & _cr5 & "'/></svg>", _br5 < 4, "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='16' y='13' width='140.0' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='15' y='10' width='84.0' height='16' fill='" & _cr5 & "'/><path d='M85.0 29l-5-22M76.0 29l-5-22' stroke='" & IF ( _s5 = "a", "#1c2424", "#261a2c" ) & "' stroke-width='3.5'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M16 4l-14 14 14 14z' fill='" & _cr5 & "'/></svg>", _s5 = "a", "<svg width='160' height='26' viewBox='0 0 160 26' style='display:block;flex:none;overflow:visible'><rect x='4' y='11' width='152' height='8' fill='#143454'/><rect x='4.0' y='11' width='95.0' height='8' fill='#2b7d62'/><rect x='99.0' y='11' width='" & FORMAT ( _x5 - 99.0, "0.0", "en-US" ) & "' height='8' fill='#ffd257'/><path d='M99.0 7v16' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x5 - 6, "0.0", "en-US" ) & " 0h12l-6 9z' fill='#ffd257'/><path d='M" & FORMAT ( _x5, "0.0", "en-US" ) & " 7v16' stroke='#ffd257' stroke-width='3'/></svg>", "<svg width='160' height='32' viewBox='0 0 160 32' style='display:block;flex:none;overflow:visible'><rect x='4' y='13' width='152' height='10' fill='#143454'/><rect x='4.0' y='13' width='95.0' height='10' fill='#2b7d62'/><rect x='99.0' y='13' width='" & FORMAT ( _x5 - 99.0, "0.0", "en-US" ) & "' height='10' fill='#ff5c63'/><path d='M99.0 8v20' stroke='#f3f8fd' stroke-width='1.5'/><path d='M" & FORMAT ( _x5 - 7, "0.0", "en-US" ) & " 0h14l-7 11z' fill='#ff5c63'/><path d='M" & FORMAT ( _x5, "0.0", "en-US" ) & " 9v19' stroke='#ff5c63' stroke-width='3.5'/></svg>" )
			VAR _d05 = _f5 - _tamanho + 1
			VAR _t5 = CALCULATETABLE ( SELECTCOLUMNS ( 'Dados BI', "@b", INT ( DIVIDE ( INT ( 'Dados BI'[Data] - _d05 ), _passo ) ), "@v", 'Dados BI'[Valor] ), 'Dados BI'[Indicador] = "Dureza (mg/L)", 'Dados BI'[Valor] <> 0, 'Dados BI'[Data] >= _d05, 'Dados BI'[Data] <= _f5 )
			VAR _g5 = GROUPBY ( _t5, [@b], "@m", AVERAGEX ( CURRENTGROUP (), [@v] ) )
			VAR _hi5 = MIN ( MAX ( MAXX ( _g5, [@m] ), 100.0 ), 3 * MAX ( _v5, 100.0 ) )
			VAR _lo5 = MIN ( MINX ( _g5, [@m] ), 100.0 )
			VAR _am5 = IF ( _hi5 > _lo5, _hi5 - _lo5, 1 )
			VAR _pts5 = CONCATENATEX ( _g5, FORMAT ( 4 + 152 * DIVIDE ( [@b], _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( [@m], _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ), " ", [@b], ASC )
			VAR _mg5 = IF ( COUNTROWS ( _g5 ) < 2, "", IF ( _s5 = "a", "<svg viewBox='0 0 160 60' preserveAspectRatio='none' style='display:block;flex:1 1 0;min-height:0;max-height:56px;width:160px'><rect x='0' y='" & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma5, _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ) & "' width='160' height='" & FORMAT ( 60 - ( 56 - 52 * DIVIDE ( MIN ( _ma5, _hi5 ) - _lo5, _am5 ) ), "0.0", "en-US" ) & "' fill='rgba(87,214,141,0.20)'/><polygon points='" & FORMAT ( 4 + 152 * DIVIDE ( MINX ( _g5, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L5, _rf5 ), _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ) & " " & _pts5 & " " & FORMAT ( 4 + 152 * DIVIDE ( MAXX ( _g5, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L5, _rf5 ), _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ) & "' fill='rgba(255,210,87,0.28)'/><path d='" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma5, _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ) & "H160" & "' stroke='#57d68d' stroke-width='1.5' stroke-dasharray='5 4' vector-effect='non-scaling-stroke'/><polyline points='" & _pts5 & "' fill='none' stroke='#ffd257' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>", "<svg viewBox='0 0 160 60' preserveAspectRatio='none' style='display:block;flex:1 1 0;min-height:0;max-height:56px;width:160px'><rect x='0' y='" & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma5, _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ) & "' width='160' height='" & FORMAT ( 60 - ( 56 - 52 * DIVIDE ( MIN ( _ma5, _hi5 ) - _lo5, _am5 ) ), "0.0", "en-US" ) & "' fill='rgba(87,214,141,0.20)'/><polygon points='" & FORMAT ( 4 + 152 * DIVIDE ( MINX ( _g5, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L5, _rf5 ), _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ) & " " & _pts5 & " " & FORMAT ( 4 + 152 * DIVIDE ( MAXX ( _g5, [@b] ), _nb ), "0.0", "en-US" ) & "," & FORMAT ( 56 - 52 * DIVIDE ( MIN ( COALESCE ( _L5, _rf5 ), _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ) & "' fill='rgba(255,92,99,0.28)'/><path d='" & "M0 " & FORMAT ( 56 - 52 * DIVIDE ( MIN ( _ma5, _hi5 ) - _lo5, _am5 ), "0.0", "en-US" ) & "H160" & "' stroke='#57d68d' stroke-width='1.5' stroke-dasharray='5 4' vector-effect='non-scaling-stroke'/><polyline points='" & _pts5 & "' fill='none' stroke='#ff5c63' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>" ) )
			VAR _dc5 = "<div class='dc' style='position:absolute;left:12px;margin:3px 0;bottom:100%;z-index:9;pointer-events:none;padding:11px 18px 13px 18px;background:#04182a;border:1px solid #2f6690;border-radius:6px;box-shadow:0 8px 22px rgba(0,0,0,0.6);font-weight:400;line-height:1.3;text-align:left;white-space:nowrap'><div style='display:flex;align-items:baseline;gap:9px'><b style='font-size:22px;color:#f3f8fd'>Dureza</b><span style='font-size:18px;color:#a8bfd6'>mg/L</span><b style='margin-left:auto;padding-left:28px;font-size:20px;color:" & _cr5 & "'>" & _si5 & "</b></div><div style='display:flex;gap:36px;margin-top:7px'><div><div style='font-size:16px;color:#a8bfd6'>Período exibido</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>" & IF ( ISBLANK ( _f5 ), "&#8212;", IF ( _tamanho = 1, FORMAT ( _f5, "dd/mm" ), FORMAT ( _f5 - _tamanho + 1, "dd/mm" ) & " a " & FORMAT ( _f5, "dd/mm" ) ) ) & "</div></div><div><div style='font-size:16px;color:#a8bfd6'>Meta</div><div style='font-size:25px;font-weight:700;color:#f3f8fd'>&#8804; 100</div><div style='font-size:21px;font-weight:600;color:#d3e1ef'>" & IF ( ISBLANK ( _rf5 ) || ISBLANK ( _v5 ), "&#8212;", FORMAT ( DIVIDE ( _v5, _rf5 ), "0%" ) ) & " da meta</div></div></div></div>"
			VAR _h5 = SWITCH ( _s5, "f", "<div class='ind' style='flex:2 1 0;min-height:88px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;grid-template-rows:auto auto;align-content:center;border-left:6px solid #ff5c63;background:rgba(255,92,99,0.13)'><div style='grid-row:1;grid-column:1 / 3;font-size:22px;font-weight:700;line-height:24px;white-space:nowrap'>Dureza</div><div style='grid-row:1 / 3;grid-column:3;align-self:stretch;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:4px;padding:5px 0'>" & _mg5 & "" & _md5 & "</div><div style='grid-row:2;grid-column:1;display:flex;flex-direction:column;align-items:flex-start;white-space:nowrap'><div style='font-size:16px;line-height:20px;color:#a8bfd6'>mg/L &#183; &#8804; 100</div><div style='font-size:18px;font-weight:700;line-height:20px;" & _fc5 & "'><div>" & _q5 & "</div><div>" & _rt5 & "</div></div></div><div style='grid-row:2;grid-column:2;font-size:52px;font-weight:700;line-height:56px;letter-spacing:-1px;text-align:right;color:#ff5c63'>" & IF ( ISBLANK ( _v5 ), "&#8212;", FORMAT ( _v5, "#,##0" ) ) & "</div>" & _dc5 & "</div>", "a", "<div class='ind' style='flex:1.5 1 0;min-height:86px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;grid-template-rows:auto auto;align-content:center;border-left:6px solid #ffd257;background:rgba(255,210,87,0.08)'><div style='grid-row:1;grid-column:1 / 3;font-size:20px;font-weight:700;line-height:24px;white-space:nowrap'>Dureza</div><div style='grid-row:1 / 3;grid-column:3;align-self:stretch;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:3px;padding:5px 0'>" & _mg5 & "" & _md5 & "</div><div style='grid-row:2;grid-column:1;display:flex;flex-direction:column;align-items:flex-start;white-space:nowrap'><div style='font-size:16px;line-height:20px;color:#a8bfd6'>mg/L &#183; &#8804; 100</div><div style='font-size:16px;font-weight:700;line-height:18px;" & _fc5 & "'><div>" & _q5 & "</div><div>" & _rt5 & "</div></div></div><div style='grid-row:2;grid-column:2;font-size:44px;font-weight:700;line-height:48px;text-align:right;color:#ffd257'>" & IF ( ISBLANK ( _v5 ), "&#8212;", FORMAT ( _v5, "#,##0" ) ) & "</div>" & _dc5 & "</div>", "<div class='ind' style='flex:1 1 0;min-height:50px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 160px;column-gap:14px;align-items:center;padding:0 14px 0 12px;border-top:1px solid #11304c;border-left:6px solid transparent'><div style='white-space:nowrap'><div style='font-size:19px;font-weight:600;line-height:24px'>Dureza</div><div style='font-size:16px;line-height:20px;color:#a8bfd6'>mg/L &#183; &#8804; 100</div></div><div style='font-size:34px;font-weight:700;line-height:38px;text-align:right'>" & IF ( ISBLANK ( _v5 ), "&#8212;", FORMAT ( _v5, "#,##0" ) ) & "</div>" & _md5 & "" & _dc5 & "</div>" )
			VAR _vc = IF ( _nf > 0, "<span style='font-size:28px;font-weight:700;color:#ff5c63'>" & _nf & " fora da meta</span>", "" ) & IF ( _na > 0, IF ( _nf > 0, "<span style='font-size:24px;font-weight:700;color:#ffd257'>" & _na & " em atenção</span>", "<span style='font-size:28px;font-weight:700;color:#ffd257'>" & _na & " em atenção</span>" ), "" )
			VAR _ver = IF ( _nf + _na = 0, "<div style='display:flex;align-items:baseline;gap:10px;white-space:nowrap;line-height:36px'><span style='font-size:28px;font-weight:700'>" & _nd & " de 5</span><span style='font-size:24px;color:#d3e1ef'>dentro da meta</span></div>", "<div style='display:flex;align-items:baseline;gap:14px;white-space:nowrap;line-height:36px'>" & _vc & "</div>" )
			VAR _ft = SWITCH ( _s1, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s2, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s3, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s4, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" ) & SWITCH ( _s5, "f", "<span style='flex:1;height:14px;background:#ff5c63'></span>", "a", "<span style='flex:1;height:10px;background:#ffd257'></span>", "d", "<span style='flex:1;height:6px;background:#2b7d62'></span>", "<span style='flex:1;height:6px;background:#5f88b0'></span>" )
			RETURN
			    "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden}*{box-sizing:border-box}</style><style>.dc{display:none}.ind{cursor:help}.ind:hover{box-shadow:inset 0 0 0 1px #2f79ad}.ind:hover>.dc{display:block}</style><div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums;color:#f3f8fd;height:100vh;width:100%;overflow:hidden;display:flex;flex-direction:column'><div style='height:88px;flex:none;display:flex;flex-direction:column'><div style='height:22px;flex:none'></div><div style='height:52px;flex:none;display:flex;align-items:center'><div style='flex:1;height:6px;background:#3aa7f2'></div><svg width='14' height='20' viewBox='0 0 14 20' style='flex:none'><path d='M0 0l14 10-14 10z' fill='#3aa7f2'/></svg><div style='height:52px;flex:none;display:flex;align-items:center;gap:12px;padding:0 18px 0 12px;border:2px solid " & IF ( _nf > 0, "#ff5c63", "#3aa7f2" ) & ";border-radius:3px;background:" & IF ( _nf > 0, "#1d1626", "#041729" ) & ";white-space:nowrap'><svg width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='" & IF ( _nf > 0, "#ff5c63", "#3aa7f2" ) & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' style='flex:none'><path d='M12 3c3.4 4 5.5 6.6 5.5 9.3A5.5 5.5 0 0 1 6.5 12.3C6.5 9.6 8.6 7 12 3z'/></svg><span style='font-size:26px;font-weight:700;letter-spacing:1px'>EEBC</span><span style='font-size:17px;color:#a8bfd6'>Alimentação</span></div><div style='flex:1;height:6px;background:#3aa7f2'></div></div><div style='height:14px;flex:none;display:flex;justify-content:center'><div style='width:2px;background:" & IF ( _nf > 0, "#ff5c63", "#2a77b0" ) & "'></div></div></div><div style='flex:1;min-height:0;display:flex;flex-direction:column;background:#041729;border:2px solid " & IF ( _nf > 0, "#ff5c63", IF ( _na > 0, "#ffd257", "#1f4263" ) ) & ";border-radius:3px'><div style='height:78px;flex:none;display:flex;flex-direction:column;justify-content:space-between;padding:8px 14px 12px;background:" & IF ( _nf > 0, "#2a1524", "#0a2137" ) & "'>" & _ver & "<div style='height:14px;display:flex;align-items:flex-end;gap:4px'>" & _ft & "</div></div><div style='flex:1;min-height:0;display:flex;flex-direction:column'>" & _h1 & _h2 & _h3 & _h4 & _h5 & "</div></div></div>"
			```
		displayFolder: Visão Geral v2
		lineageTag: 8c22cfdc-0885-5b7b-a1ce-18720a4152f2

	/// Coluna TMBR da Visão Geral v2: o nó do trem e o bloco com Idade do Lodo, Alimento/Microorg., TMP, Permeabilidade, Turbidez, Fluxo. Valor = as medidas '... Período' da tabela Medidas HTML (planilha Dados BI); meta = a de ferramentas/preview/indicadores_op.py. A linha fora da meta ou em atenção cresce no próprio lugar, com o desvio em palavras e a tendência do período; a ordem nunca muda. Ao passar o mouse, abre a aba com o período e a meta.
	measure 'HTML v2 TMBR' = ```
			VAR _opcao = SELECTEDVALUE ( 'Período Painel'[Dias], 30 )
			VAR _exatas = ( _opcao = 0 )
			VAR _ate = MAX ( 'Datas Painel'[Data] )
			VAR _tamanho = IF ( _exatas, INT ( _ate - MIN ( 'Datas Painel'[Data] ) ) + 1, _opcao )
			VAR _passo = ROUNDUP ( DIVIDE ( _tamanho, 90 ), 0 )
			VAR _nb = MAX ( INT ( DIVIDE ( _tamanho - 1, _passo ) ), 1 )
			VAR _v1 = [Idade do Lodo Período]
			VAR _mi1 = 18.0
			VAR _ma1 = 22.0
			VAR _rf1 = _ma1
			VAR _co1 = SWITCH ( TRUE (), ISBLANK ( _v1 ) || ISBLANK ( _mi1 ) || ISBLANK ( _ma1 ), "#5c7791", _v1 >= _mi1 && _v1 <= _ma1, "#4ed15d", _v1 >= _mi1 * 0.9 && _v1 <= _ma1 * 1.1, "#feb825", "#f4353f" )
			VAR _lg1 = MIN ( MAX ( DIVIDE ( _v1, _rf1 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si1 = SWITCH ( _co1, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f1 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Idade do lodo (dias)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s1 = SWITCH ( TRUE (), ISBLANK ( _v1 ), "n", _co1 = "#4ed15d", "d", _co1 = "#feb825", "a", _co1 = "#f4353f", "f", "s" )
			VAR _cr1 = SWITCH ( _s1, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v2 = [Alimento/Microorg. Período]
			VAR _mi2 = 0.08
			VAR _ma2 = 0.16
			VAR _rf2 = _ma2
			VAR _co2 = SWITCH ( TRUE (), ISBLANK ( _v2 ) || ISBLANK ( _mi2 ) || ISBLANK ( _ma2 ), "#5c7791", _v2 >= _mi2 && _v2 <= _ma2, "#4ed15d", _v2 >= _mi2 * 0.9 && _v2 <= _ma2 * 1.1, "#feb825", "#f4353f" )
			VAR _lg2 = MIN ( MAX ( DIVIDE ( _v2, _rf2 ), 0 ), 1.6 ) / 1.6 * 100
			VAR _si2 = SWITCH ( _co2, "#4ed15d", "Dentro da meta", "#feb825", "Atenção", "#f4353f", "Fora da meta", "Sem leitura" )
			VAR _f2 = IF ( _exatas, _ate, CALCULATE ( MAX ( 'Dados BI'[Data] ), 'Dados BI'[Indicador] = "Alimento/ Microorg (g/g.d-¹)", 'Dados BI'[Valor] <> 0, KEEPFILTERS ( 'Dados BI'[Data] <= TODAY () ) ) )
			VAR _s2 = SWITCH ( TRUE (), ISBLANK ( _v2 ), "n", _co2 = "#4ed15d", "d", _co2 = "#feb825", "a", _co2 = "#f4353f", "f", "s" )
			VAR _cr2 = SWITCH ( _s2, "f", "#ff5c63", "a", "#ffd257", "d", "#57d68d", "#a8bfd6" )
			VAR _v3 = [TMP Período]
			VAR _mi3 = BLANK ()
			VAR _ma3 = 0.6
			VAR _rf3 = _ma3
			VAR _co3 = SWITCH ( TRUE (), ISBLANK ( _v3 ) || ISBLANK ( _rf3 ), "#5c7791", _v3 <= _rf3, "#4ed15d", _v3 <= _rf3 * 1.1, "#feb825", "#f4353f" )
			VAR _lg3 = MIN ( MAX ( DIVIDE ( _v3, _rf3 ), 0 ), 1.6 ) / 1.6 * 100
