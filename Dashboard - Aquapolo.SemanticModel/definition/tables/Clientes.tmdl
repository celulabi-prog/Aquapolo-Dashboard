	column Ordem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 37e640c0-ece0-4232-a3b4-9c53b033c646
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ordem]

		annotation SummarizationSetBy = Automatic

	partition Clientes = calculated
		mode: import
		source = ```
			-- Clientes de volume: os indicadores da etapa "Volumes" da dim_indicadores.
			-- Meta = Target_Min (meta contratual, m³/d). Ordem = ordem de exibição do painel.
			ADDCOLUMNS (
			    SELECTCOLUMNS (
			        FILTER ( dim_indicadores, dim_indicadores[Etapa] = "Volumes" ),
			        "ID_Indicador", dim_indicadores[ID_Indicador],
			        "Cliente", dim_indicadores[Indicador],
			        "Meta", dim_indicadores[Target_Min]
			    ),
			    "Ordem",
			        SWITCH (
			            [Cliente],
			            "Todos Clientes", 1,
			            "Q3 ABC", 2,
			            "PE7 ABC", 3,
			            "UNIB3 ABC", 4,
			            "PP4 BRK", 5,
			            "Oxicap", 6,
			            "Cabot", 7,
			            "Oxiteno P.", 8,
			            "Paranapanema", 9,
			            "Bridgestone", 10,
			            "Hydro Extrusion", 11,
			            "Vitopel", 12,
			            99
			        )
			)
			```

	annotation PBI_Id = Clientes
