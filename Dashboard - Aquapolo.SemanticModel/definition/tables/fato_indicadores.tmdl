	measure 'Autonomia PAC' =
			VAR _ult =
			    CALCULATE ( MAX ( fato_indicadores[Data] ), REMOVEFILTERS ( dim_indicadores ), fato_indicadores[ID_Indicador] = "Químicos - Autonomia | PAC" )
			RETURN
			    CALCULATE (
			        AVERAGE ( fato_indicadores[Valor] ),
			        REMOVEFILTERS ( dim_indicadores ),
			        fato_indicadores[ID_Indicador] = "Químicos - Autonomia | PAC",
			        fato_indicadores[Data] = _ult
			    )
		formatString: 0.0
		displayFolder: Visão Geral\Autonomia
		lineageTag: cc7fecde-cdf9-41e5-8cb6-23887837cb6e

