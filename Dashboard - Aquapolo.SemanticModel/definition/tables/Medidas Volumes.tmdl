	/// Volume médio dos últimos 7 dias com medição, até a última data do mês em foco.
	measure 'Vol Média 7d' = ```
			VAR _id = [Vol ID Cliente]
			VAR _fim = [Vol Última Data]
			RETURN
			    CALCULATE (
			        [Valor Indicador],
			        REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ),
			        fato_indicadores[Data] > _fim - 7,
			        fato_indicadores[Data] <= _fim,
			        fato_indicadores[ID_Indicador] = _id
			    )
			```
		formatString: #,0
		displayFolder: Base
