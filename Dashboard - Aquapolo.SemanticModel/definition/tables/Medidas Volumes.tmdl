table 'Medidas Volumes'
	lineageTag: 2d58c591-b413-4b63-948a-6661d2370c83

	/// Mês em foco. Sem filtro de período, usa o último mês COMPLETO da base (um mês pela metade distorceria a comparação com a meta e com os meses cheios).
	measure 'Vol Mês Idx' = ```
			VAR _escolhido = ISFILTERED ( dCalendario[Ano] ) || ISFILTERED ( dCalendario[Mês] ) || ISFILTERED ( dCalendario[Mês/Ano] ) || ISFILTERED ( dCalendario[Data] )
			VAR _sel = MAX ( dCalendario[MesIdx] )
			VAR _ult = CALCULATE ( MAX ( fato_indicadores[Data] ), ALL ( fato_indicadores ), REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ) )
			VAR _idx = YEAR ( _ult ) * 12 + MONTH ( _ult )
			VAR _fechado = _ult = EOMONTH ( _ult, 0 )
			RETURN
			    IF ( _escolhido, _sel, IF ( _fechado, _idx, _idx - 1 ) )
			```
		formatString: 0
		displayFolder: Base
		lineageTag: 1136500b-6654-5f22-bd29-cf90935b6c5f

	/// ID_Indicador do cliente escolhido. Sem escolha — ou com mais de um escolhido — usa Todos Clientes.
	measure 'Vol ID Cliente' = ```
			VAR _qtd = COUNTROWS ( VALUES ( Clientes[ID_Indicador] ) )
			RETURN
			    IF ( _qtd = 1, SELECTEDVALUE ( Clientes[ID_Indicador] ), "Volumes | Todos Clientes" )
			```
		displayFolder: Base
		lineageTag: e5c2221b-2ac8-5c8e-beb4-8c9c4cbf1732

	/// Nome do cliente escolhido.
	measure 'Vol Cliente' = ```
			VAR _qtd = COUNTROWS ( VALUES ( Clientes[Cliente] ) )
			RETURN
			    IF ( _qtd = 1, SELECTEDVALUE ( Clientes[Cliente] ), "Todos Clientes" )
			```
		displayFolder: Base
		lineageTag: 0d58da9f-f33a-5a04-b828-774afa0342f0

	/// Volume médio diário (m³/d) do cliente no mês em foco.
	measure 'Vol do Mês' = ```
			VAR _id = [Vol ID Cliente]
			VAR _i = [Vol Mês Idx]
			RETURN
			    CALCULATE (
			        [Valor Indicador],
			        REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ),
			        dCalendario[MesIdx] = _i,
			        fato_indicadores[ID_Indicador] = _id
			    )
			```
		formatString: #,0
		displayFolder: Base
		lineageTag: 11771243-13bd-5339-910f-8414ee473390

	/// Volume médio diário (m³/d) no mês anterior ao mês em foco.
	measure 'Vol Mês Anterior' = ```
			VAR _id = [Vol ID Cliente]
			VAR _i = [Vol Mês Idx] - 1
			RETURN
			    CALCULATE (
			        [Valor Indicador],
			        REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ),
			        dCalendario[MesIdx] = _i,
			        fato_indicadores[ID_Indicador] = _id
			    )
			```
		formatString: #,0
		displayFolder: Base
		lineageTag: a85e9b5d-a9a9-54a9-82af-cd15b428bc8c

	/// Volume médio diário (m³/d) no mesmo mês do ano anterior.
	measure 'Vol Mesmo Mês Ano Anterior' = ```
			VAR _id = [Vol ID Cliente]
			VAR _i = [Vol Mês Idx] - 12
			RETURN
			    CALCULATE (
			        [Valor Indicador],
			        REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ),
			        dCalendario[MesIdx] = _i,
			        fato_indicadores[ID_Indicador] = _id
			    )
			```
		formatString: #,0
		displayFolder: Base
		lineageTag: 56b276cd-ff10-50a9-9f06-25192ce2d29d

	/// Dias com medição do cliente no mês em foco.
	measure 'Vol Dias do Mês' = ```
			VAR _id = [Vol ID Cliente]
			VAR _i = [Vol Mês Idx]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( fato_indicadores[Data] ),
			        REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ),
			        dCalendario[MesIdx] = _i,
			        fato_indicadores[ID_Indicador] = _id
			    )
			```
		formatString: 0
		displayFolder: Base
		lineageTag: 390edbf1-c4e4-5971-95cf-85f11dc32fcb

	/// Meta contratual (m³/d) do cliente, vinda de Target_Min na dim_indicadores.
	measure 'Vol Meta' = ```
			VAR _id = [Vol ID Cliente]
			RETURN
			    CALCULATE ( MAX ( Clientes[Meta] ), REMOVEFILTERS ( Clientes ), Clientes[ID_Indicador] = _id )
			```
		formatString: #,0
		displayFolder: Base
		lineageTag: f5680539-2375-5b28-bad2-a2c65a94710a

	/// Média dos volumes mensais dos 12 meses ANTERIORES ao mês em foco. Serve de referência; não inclui o próprio mês avaliado.
	measure 'Vol Média 12m' = ```
			VAR _id = [Vol ID Cliente]
			VAR _m = [Vol Mês Idx]
			VAR _meses = FILTER ( ALL ( dCalendario[MesIdx] ), dCalendario[MesIdx] >= _m - 12 && dCalendario[MesIdx] < _m )
			RETURN
			    AVERAGEX (
			        _meses,
			        VAR _k = dCalendario[MesIdx]
			        RETURN
			            CALCULATE (
			                [Valor Indicador],
			                REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			                REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ),
			                dCalendario[MesIdx] = _k,
			                fato_indicadores[ID_Indicador] = _id
			            )
			    )
			```
		formatString: #,0
		displayFolder: Base
		lineageTag: 5318acb0-1c9b-574b-9f20-86b030cdd119

	/// Desvio padrão dos 12 meses anteriores. A faixa esperada é a média ± 1 desvio.
	measure 'Vol Desvio 12m' = ```
			VAR _id = [Vol ID Cliente]
			VAR _m = [Vol Mês Idx]
			VAR _meses = FILTER ( ALL ( dCalendario[MesIdx] ), dCalendario[MesIdx] >= _m - 12 && dCalendario[MesIdx] < _m )
			RETURN
			    STDEVX.P (
			        _meses,
			        VAR _k = dCalendario[MesIdx]
			        RETURN
			            CALCULATE (
			                [Valor Indicador],
			                REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			                REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ),
			                dCalendario[MesIdx] = _k,
			                fato_indicadores[ID_Indicador] = _id
			            )
			    )
			```
		formatString: #,0
		displayFolder: Base
		lineageTag: 7354601f-f25d-5c8d-ba13-7f2e4d65c7c6

	/// Última data com medição do cliente dentro do mês em foco.
	measure 'Vol Última Data' = ```
			VAR _id = [Vol ID Cliente]
