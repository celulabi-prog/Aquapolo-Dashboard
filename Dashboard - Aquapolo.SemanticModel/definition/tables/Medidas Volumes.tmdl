table 'Medidas Volumes'
	lineageTag: 2d58c591-b413-4b63-948a-6661d2370c83

	/// Mês em foco. Sem filtro de período, usa o último mês COMPLETO da base (um mês pela metade distorceria a comparação com a meta e com os meses cheios).
	measure 'Vol Mês Idx' = ```
			VAR _escolhido = ISFILTERED ( dCalendario[Ano] ) || ISFILTERED ( dCalendario[Mês] ) || ISFILTERED ( dCalendario[Mês/Ano] ) || ISFILTERED ( dCalendario[Data] )
			VAR _sel = MAX ( dCalendario[MesIdx] )
			VAR _ult = CALCULATE ( MAX ( fato_indicadores[Data] ), ALL ( fato_indicadores ), REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ) )
			VAR _idx = YEAR ( _ult ) * 12 + MONTH ( _ult )
			VAR _fechado = _ult = EOMONTH ( _ult, 0 )
			RETURN
			    IF ( _escolhido, _sel, IF ( _fechado, _idx, _idx - 1 ) )
			```
		formatString: 0
		displayFolder: Base
		lineageTag: 1136500b-6654-5f22-bd29-cf90935b6c5f

	/// ID_Indicador do cliente escolhido. Sem escolha — ou com mais de um escolhido — usa Todos Clientes.
	measure 'Vol ID Cliente' = ```
			VAR _qtd = COUNTROWS ( VALUES ( Clientes[ID_Indicador] ) )
			RETURN
			    IF ( _qtd = 1, SELECTEDVALUE ( Clientes[ID_Indicador] ), "Volumes | Todos Clientes" )
			```
		displayFolder: Base
		lineageTag: e5c2221b-2ac8-5c8e-beb4-8c9c4cbf1732

	/// Nome do cliente escolhido.
	measure 'Vol Cliente' = ```
			VAR _qtd = COUNTROWS ( VALUES ( Clientes[Cliente] ) )
			RETURN
			    IF ( _qtd = 1, SELECTEDVALUE ( Clientes[Cliente] ), "Todos Clientes" )
			```
		displayFolder: Base
		lineageTag: 0d58da9f-f33a-5a04-b828-774afa0342f0

	/// Volume médio diário (m³/d) do cliente no mês em foco.
	measure 'Vol do Mês' = ```
			VAR _id = [Vol ID Cliente]
			VAR _i = [Vol Mês Idx]
			RETURN
			    CALCULATE (
			        [Valor Indicador],
			        REMOVEFILTERS ( dim_indicadores ), REMOVEFILTERS ( Clientes ),
			        REMOVEFILTERS ( dCalendario ), REMOVEFILTERS ( 'LocalDateTable_26878ded-8d73-4b03-b037-00303befc16a' ),
			        dCalendario[MesIdx] = _i,
			        fato_indicadores[ID_Indicador] = _id
			    )
			```
